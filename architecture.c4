  cloud.modelRegistry -[exposed-to]-> blindspotAM11 'versionnement de schema non defini'
  edge.fusion -[exposed-to]-> blindspotAM12 'perte d agent detectee sans suite definie'
  onboard.health -[exposed-to]-> blindspotAM12 'detection de defaillance sans reallocation'
  onboard.taskAuction -[exposed-to]-> blindspotAM12 'tache orpheline apres perte d agent'
  cloud.replayStore -[exposed-to]-> blindspotAM13 'contrat de trace non specifie'
  onboard.telemetry -[exposed-to]-> blindspotAM13 'entrees et alea absents de la trace'
  c2.auth -[exposed-to]-> blindspotAM13 'journalisation d audit non liee au rejeu'
  onboard.perception -[exposed-to]-> blindspotAM14 'aucune cible P_d et P_fa'
  edge.fusion -[exposed-to]-> blindspotAM14 'fusion sans cible de fausses pistes'
  cloud.twin -[exposed-to]-> blindspotAM15 'procedure de fidelite absente'
  cloud.analytics -[exposed-to]-> blindspotAM15 'metrique d ecart sim reel absente'
  cloud.replayStore -[exposed-to]-> blindspotAM15 'campagne de recalibration non definie'
  c2.gcs -[exposed-to]-> blindspotAM16 'charge d un operateur sur 30 agents non evaluee'
  c2.alerting -[exposed-to]-> blindspotAM16 'escalades en rafale non mesurees'
  c2.planner -[exposed-to]-> blindspotAM16 'replanification sous incertitude a charge humaine'

  // -- element_vers_reference (14)
  riskR1 -[depend-on]-> h2 'contention aggravee par le lien intermittent'
  riskR2 -[justifie]-> adr3 'canaux surete et securite separes a tenir'
  riskR3 -[justifie]-> adr4 'deport du lourd hors boucle a justifier'
  riskR4 -[justifie]-> adr5 'robustesse sous partition arbitree'
  riskR5 -[depend-on]-> h3 'hypothese GNSS degradable directement teste'
  riskR9 -[justifie]-> adr3 'voie de surete a maintenir non bloquee'
  riskR10 -[justifie]-> adr2 'fraicheur explicite suppose un temps fiable'
  riskR12 -[justifie]-> adr5 'allocation robuste a ponderer energie'
  riskR14 -[depend-on]-> h5 'autorite humaine a rendre tenable a l echelle'
  // -- Correction M2 : le facteur humain (R-14 / AM-16) est porte par l acteur, pas par un poste
  operator -[exposed-to]-> riskR14 'charge humaine sous incertitude a 30 agents'
  operator -[exposed-to]-> blindspotAM16 'autorite humaine non tenable a cette echelle'
  blindspotAM3 -[justifie]-> adr2 'priorisation des deltas depend du budget radio'
  blindspotAM5 -[justifie]-> adr4 'deport du lourd conditionne la preuve d echelle'
  blindspotAM6 -[justifie]-> adr2 'fraicheur explicite sans specification du temps'
  blindspotAM7 -[justifie]-> adr3 'arbitrage surete securite non resolu en conception'
  blindspotAM9 -[justifie]-> adr5 'allocation robuste a pondere par l energie'


// ---------------------------------------------------------------------------
// ACTION 2 : decisions en attente (arbitrages non tranches)
// Source : decisions_swarmdrone.md (profil swarmdrone) - verifie par l orchestrateur
// Les ADR-1..5 existantes sont toutes 'acceptee' ; ces 4 decisions sont 'ouverte'
// ---------------------------------------------------------------------------

  de1 = decision 'DE-01 Socle de vol et regime de distribution du firmware' {
    description '''
      **Question.** Socle permissif (PX4, BSD-3) ou copyleft (ArduPilot, GPLv3),
      et le livrable peut-il rester ferme ?
      **Options.** PX4 BSD-3 socle unique et livrable ferme ; ArduPilot GPLv3 socle
      unique avec publication du derive embarque ; PX4 avec compagnon partiellement
      proprietaire ; coexistence PX4 (UAV) et ArduPilot Rover (USV) par domaine.
      **Si non tranche.** Choix de fait par le premier developpeur ; refonte tardive
      touchant autopilot, mission, safety, HIL et documentation.
    '''
    metadata { statut 'ouverte'; nature 'juridique et programme'; porteur 'direction technique avec avis juridique'; echeance 'avant conception detaillee du socle embarque'; angle_mort 'blindspotAM1' }
  }

  de2 = decision 'DE-02 Plafond d echelle reelle et repartition des preuves' {
    description '''
      **Question.** Jusqu a quelle taille d essaim valide-t-on en vol reel, et quels
      criteres sont declares prouves en SIL/HIL/jumeau numerique ?
      **Options.** Reel plafonne a 5 et 12/30 simules ; reel a 12 et 30 simule ;
      30 en reel en acceptant cout et delais ; renoncer au critere 30 et redefinir
      les criteres autour d un palier atteignable.
      **Si non tranche.** Le critere "a 30 agents" reste inscrit sans modalite qui le
      produise : contourne implicitement ou bloquant en recette.
    '''
    metadata { statut 'ouverte'; nature 'cout et preuve et calendrier'; porteur 'responsable essais avec direction technique'; echeance 'avant plan de campagne d essais'; angle_mort 'blindspotAM5' }
  }

  de3 = decision 'DE-03 Modele de menaces et strategie de cles' {
    description '''
      **Question.** Quel niveau d authentification et de gestion de cles impose-t-on au
      lien montant, au lien essaim et a l autopilote, et comment preserve-t-on la surete
      quand la securite est compromise ou indisponible ?
      **Options.** Profil fort (mTLS/DDS-Security, PKI embarquee, ordres signes) ;
      securite graduee par zone ; securite differee apres le premier palier de vol ;
      segregation stricte (canal de surete isole, canal de securite chiffre).
      **Si non tranche.** L implementation par defaut (MAVLink et DDS non authentifies)
      persiste ; le conflit surete/securite de l ADR-3 reste non resolu.
    '''
    metadata { statut 'ouverte'; nature 'surete versus securite'; porteur 'architecte systeme securite ou porteur a designer'; echeance 'avant conception des interfaces et avant premier vol avec lien'; angle_mort 'blindspotAM7' }
  }

  de4 = decision 'DE-04 Architecture radio a 30 agents et mecanisme de priorite' {
    description '''
      **Question.** Quelle architecture radio et quel mecanisme d acces priorise
      retient-on pour 30 agents plus les noeuds Edge sans perdre les messages de surete,
      une fois le budget radio etabli ?
      **Options.** Maille Zenoh decentralisee avec priorite par criticite ; relais Edge
      centralise en etoile avec QoS par classe ; architecture hybride maille plus lien
      longue portee dedie ; profil multi-radio par domaine UAV/USV avec passerelle.
      **Condition.** Cette decision est conditionnee a la production prealable du budget
      radio (travail d ingenierie, pas arbitrage).
      **Si non tranche.** A 30 agents la contention est non lineaire : le premier palier
      reel sature le canal et perd les messages de surete avec la telemetrie.
    '''
    metadata { statut 'ouverte'; nature 'technique apres budget radio'; porteur 'architecte systeme communications'; echeance 'apres budget radio, avant palier 12 plateformes'; angle_mort 'blindspotAM3' }
  }

  // -- Relations : l angle mort appelle une decision (sens : AM -> DE)
  blindspotAM1 -[justifie]-> de1 'arbitrage de licence a trancher'
  blindspotAM5 -[justifie]-> de2 'plafond d echelle a arbitrer'
  blindspotAM7 -[justifie]-> de3 'modele de menaces a arreter'
  blindspotAM3 -[justifie]-> de4 'architecture radio a choisir apres budget'

  // -- Relations : la decision conditionne le traitement du risque (sens : DE -> risque)
  //    Formulation au conditionnel : la decision est OUVERTE, elle ne resout rien encore.
  de1 -[exposed-to]-> riskR7 'conditionne la levee du conflit de licence'
  de2 -[exposed-to]-> riskR3 'conditionne la borne de validation d echelle'
  de3 -[exposed-to]-> riskR2 'conditionne la reduction de la surface d attaque'
  de4 -[exposed-to]-> riskR1 'conditionne le traitement de la contention radio'

}

// =============================================================================
//  MODELE DE DEPLOIEMENT
//  Materialise le caractere "x30" des plateformes et "1..N" des stations Edge.
// =============================================================================
deployment {

  onboardPool = host 'Parc onboard — 30 plateformes' {
    description '''
      18 UAV-R (multirotors), 8 UAV-F (voilure fixe), 4 USV.
      Les 30 instances sont materialisees : chacune execute la MEME pile
      logicielle onboard (instanceOf onboard), seule la plateforme physique
      differe (absorbee par onboard.sensors-hal). Cf. hypothese H1.
    '''
    style { color zoneOnboard }

    // Sous-groupe par type : reduit la densite du layout et documente
    // l'heterogeneite (18/8/4). UX : trois blocs lisibles au lieu de 30.
    uavR = host 'UAV-R — 18 multirotors' {
      style { color zoneOnboard }
      n01 = instanceOf onboard 'UAV-R #01'
      n02 = instanceOf onboard 'UAV-R #02'
      n03 = instanceOf onboard 'UAV-R #03'
      n04 = instanceOf onboard 'UAV-R #04'
      n05 = instanceOf onboard 'UAV-R #05'
      n06 = instanceOf onboard 'UAV-R #06'
      n07 = instanceOf onboard 'UAV-R #07'
      n08 = instanceOf onboard 'UAV-R #08'
      n09 = instanceOf onboard 'UAV-R #09'
      n10 = instanceOf onboard 'UAV-R #10'
      n11 = instanceOf onboard 'UAV-R #11'
      n12 = instanceOf onboard 'UAV-R #12'
      n13 = instanceOf onboard 'UAV-R #13'
      n14 = instanceOf onboard 'UAV-R #14'
      n15 = instanceOf onboard 'UAV-R #15'
      n16 = instanceOf onboard 'UAV-R #16'
      n17 = instanceOf onboard 'UAV-R #17'
      n18 = instanceOf onboard 'UAV-R #18'
    }

    uavF = host 'UAV-F — 8 voilure fixe' {
      style { color zoneOnboard }
      n19 = instanceOf onboard 'UAV-F #19'
      n20 = instanceOf onboard 'UAV-F #20'
      n21 = instanceOf onboard 'UAV-F #21'
      n22 = instanceOf onboard 'UAV-F #22'
      n23 = instanceOf onboard 'UAV-F #23'
      n24 = instanceOf onboard 'UAV-F #24'
      n25 = instanceOf onboard 'UAV-F #25'
      n26 = instanceOf onboard 'UAV-F #26'
    }

    usv = host 'USV — 4 navires de surface' {
      style { color zoneOnboard }
      n27 = instanceOf onboard 'USV #27'
      n28 = instanceOf onboard 'USV #28'
      n29 = instanceOf onboard 'USV #29'
      n30 = instanceOf onboard 'USV #30'
    }
  }

  edgePool = host 'Edge — stations de proximite (1..N)' {
    description 'Deploiement minimal illustratif : 2 stations Edge (N variable).'
    style { color zoneEdge }
    edge01 = instanceOf edge 'Station Edge #1 (primaire)'
    edge02 = instanceOf edge 'Station Edge #2 (secondaire / redondance)'
  }

  c2Pool = host 'C2 — poste de commandement' {
    style { color zoneC2 }
    c2Site = instanceOf c2
  }

  cloudPool = host 'Cloud (hors boucle de controle)' {
    style { color cloudCyan }
    cloudSite = instanceOf cloud
  }
}
