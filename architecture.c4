/**
 * =============================================================================
 *  SwarmDrones — Architecture logicielle de reference
 *  Essaim heterogene de 30 plateformes (UAV-R / UAV-F / USV)
 *  Version 1.0 — 2026-09-14 — source : document d'architecture logicielle v1.0
 *
 *  Principe directeur : "le contrat de mission est embarque ;
 *                        le lien est un bonus, pas une dependance."
 *
 *  Organisation du workspace :
 *    architecture.c4  -> specification + modele logique + modele de deploiement
 *    views.c4         -> toutes les vues (projctions du meme modele unique)
 *
 *  Les identifiants de composants sont STABLES et suivent la section 13
 *  du document d'entree (ex : onboard.safety).
 * =============================================================================
 */

specification {

  // ---------------------------------------------------------------------------
  // COULEURS PERSONNALISEES (les noms sont ensuite utilisables partout)
  // ---------------------------------------------------------------------------
  color criticalRed   #C62828
  color warningAmber  #F9A825
  color effortGray    #546E7A
  color cloudCyan     #00838F
  color zoneOnboard   #0277BD
  color zoneEdge      #EF6C00
  color zoneC2        #3F51B5
  color zoneCloud     #00838F
  color extBrown      #6D4C41
  color hypothesePurple #8E24AA
  color decisionGreen   #2E7D32
  color sourceGray      #616161

  // --- Couleurs du lot (3) : produits du marche, algorithmes, risques, angles morts ---
  color softwareTeal    #00695C   // brique logicielle du marche
  color algoIndigo      #283593   // famille algorithmique
  color riskRed         #B71C1C   // risque (criticite elevee)
  color riskOrange      #EF6C00   // risque (criticite moyenne)
  color blindspotBrown   #4E342E  // angle mort

  // ---------------------------------------------------------------------------
  // ACTEURS ET EXTERNES
  // ---------------------------------------------------------------------------
  element operator {
    title 'Operateur humain'
    notation 'Acteur'
    description '''
      Autorite humaine. Detient l'autorite sur les actions critiques
      (armement, largage, changement de zone). N'agit jamais dans la boucle
      de controle temps reel embarque.
    '''
    style { shape person; color warningAmber }
  }

  element external {
    title 'Systeme externe'
    notation 'Externe'
    style { color extBrown; border dashed }
  }

  // ---------------------------------------------------------------------------
  // KINDS DE FRONTIERES / ZONES DE DEPLOIEMENT
  // ---------------------------------------------------------------------------
  element platform {
    title 'Plateforme'
    notation 'Onboard (x30)'
    description 'Une des 30 plateformes de l\'essaim (18 UAV-R, 8 UAV-F, 4 USV).'
    style { color zoneOnboard; border solid }
  }

  element edgeStation {
    title 'Station Edge'
    notation 'Edge (1..N)'
    description 'Relais / station de proximite. Absorbe fusion tactique et coordination locale.'
    style { color zoneEdge }
  }

  element c2System {
    title 'C2 / GCS'
    notation 'C2 (supervision)'
    description 'Poste de commandement et de (re)planification. Autorite humaine.'
    style { color zoneC2 }
  }

  element cloudSystem {
    title 'Cloud'
    notation 'Cloud (hors boucle)'
    description 'Hors boucle de controle. Strictement differe et non temps reel.'
    style { color cloudCyan }
  }

  // ---------------------------------------------------------------------------
  // COMPOSANT LOGICIEL — seule granularite autorisee dans les vues de zone
  // ---------------------------------------------------------------------------
  element component {
    title 'Composant logiciel'
    notation 'Composant'
    style { shape component }
  }

  // ---------------------------------------------------------------------------
  // ENRICHISSEMENT (lot 1) — HYPOTHESES ET DECISIONS
  // Une hypothese (H*) est une affirmation non demontree dont l'architecture
  // depend. Une decision (ADR-*) est un choix motive, avec alternatives rejetees.
  // Ces kinds ne sont PAS des composants : ils ne doivent apparaitre que dans
  // les vues dediees (hypotheses / decisions), jamais dans une vue de zone.
  // ---------------------------------------------------------------------------
  element hypothesis {
    title 'Hypothese'
    notation 'Hypothese (H*)'
    description 'Affirmation non demontree dont depend l architecture. Si fausse, une partie du design s effondre.'
    style { shape rectangle; color hypothesePurple; border dashed }
  }

  element decision {
    title 'Decision d architecture'
    notation 'ADR'
    description 'Choix motive, avec alternatives rejetees et consequences assumees.'
    style { shape rectangle; color decisionGreen }
  }

  // ---------------------------------------------------------------------------
  // ENRICHISSEMENT (lot 3 / point 4) — PRODUITS, ALGORITHMES, RISQUES, ANGLES MORTS
  // Ces kinds ne sont PAS des composants de l'architecture logique : ils
  // qualifient l'architecture (par quoi est-elle implementee ?) et l'exposent
  // (a quoi est-elle exposee ? qu'est-ce qui n'est pas couvert ?).
  // Regle : ils n'apparaissent JAMAIS dans les vues de zone, uniquement dans
  // les vues dediees techChoices / riskMatrix / blindspotBySeverity.
  // ---------------------------------------------------------------------------
  element software {
    title 'Brique logicielle du marche'
    notation 'COTS / OSS'
    description 'Produit logiciel existant (mature ou emergent) retenu ou candidat pour implementer un composant du modele. Porte son role (PRIMARY / SECONDARY) et sa licence.'
    style { shape rectangle; color softwareTeal }
  }

  element algorithm {
    title 'Famille algorithmique'
    notation 'Algorithme'
    description 'Famille d algorithmes candidate pour couvrir une fonction (perception, allocation, surete). Toute performance a 30 agents heterogenes non mesuree est une extrapolation.'
    style { shape rectangle; color algoIndigo; border dashed }
  }

  element risk {
    title 'Risque'
    notation 'Risque (R*)'
    description 'Risque identifie, avec probabilite, impact, criticite, mitigation et signal d alerte precoce. Criticite = probabilite x impact.'
    style { shape rectangle; color riskRed }
  }

  element blindspot {
    title 'Angle mort'
    notation 'Angle mort (AM*)'
    description 'Zone que l architecture actuelle ne couvre pas ou couvre mal. Un angle mort n est pas un risque : c est un trou de specification reconnu.'
    style { shape rectangle; color blindspotBrown; border dashed }
  }

  // ===========================================================================
  // TAGS DE CRITICITE — coeur de la semantique visuelle
  // Syntaxe LikeC4 1.59.2 : un tag n'accepte QUE `color <hex|rgb|rgba>`.
  // Les libelles lisibles sont donc portes par les NOTES DE VUE et l'ADR.
  // ===========================================================================

  /** Safety-Critical : touche a la securite du vol/navigation (#C62828 = rouge).
   *  Ne doit JAMAIS dependre d'un element Mission/Best-Effort pour sa fonction. */
  tag safety-critical { color #C62828 }

  /** Mission-Critical : sans lui la mission echoue, la securite reste assuree
   *  (#F9A825 = ambre). */
  tag mission-critical { color #F9A825 }

  /** Best-Effort : degradable, opportuniste, jamais bloquant (#546E7A = gris-bleu). */
  tag best-effort { color #546E7A }

  /** cloudOnly : hors boucle de controle (#00838F = cyan). */
  tag cloudOnly { color #00838F }

  // ===========================================================================
  // TAGS DE ZONE — filtrage par zone et coloration des boundaries
  // ===========================================================================
  tag zone-onboard { color #0277BD }
  tag zone-edge    { color #EF6C00 }
  tag zone-c2      { color #3F51B5 }
  tag zone-cloud   { color #00838F }
  tag external-src { color #6D4C41 }

  // --- Tags d'enrichissement (lot 1) ---
  tag hypothese      { color #8E24AA }
  tag decision       { color #2E7D32 }
  tag validee        { color #2E7D32 }   // hypothese confirmee
  tag a-valider      { color #F9A825 }   // hypothese non confirmee (risque ouvert)
  tag source-doc     { color #616161 }

  // --- Tags du lot 3 (point 4) : role et criticite des nouveaux elements ---
  tag software-primary   { color #00695C }   // brique retenue par defaut
  tag software-secondary { color #4DB6AC }   // brique alternative / repli
  tag licence-permissive { color #2E7D32 }   // BSD/MIT/Apache : pas de copyleft
  tag licence-copyleft   { color #F9A825 }   // GPL : contrainte de distribution
  tag source-available   { color #EF6C00 }   // non OSI (ex. Confluent Community)
  tag evidence-high      { color #2E7D32 }
  tag evidence-medium    { color #F9A825 }
  tag evidence-low       { color #C62828 }
  tag non-verifie        { color #616161 }   // existence/licence non etablie

  // ===========================================================================
  // KINDS DE RELATIONS — la criticite du flux se lit sur le diagramme
  // ===========================================================================
  relationship sync    { title 'Appel synchrone (bus interne)'; line solid }
  relationship flow    { title 'Flux de donnees'; line solid }
  relationship radio   { title 'Lien radio (intermittent)'; line dashed }
  relationship command { title 'Ordre / commande'; line dashed }
  relationship store   { title 'Persistance / stockage'; line dotted }
  relationship async   { title 'Differe / store-and-forward'; line dotted }
  relationship safety  { title 'Voie de surete (independante du lien)'; line solid }

  // --- Relations d'enrichissement (lot 1) ---
  /** Le composant s'appuie sur une hypothese : si l'hypothese est fausse,
   *  le composant ou la relation est a revoir. */
  relationship depend-on {
    title 'Depend de l hypothese'
    line dotted
    color hypothesePurple
  }

  /** Une decision justifie un choix de conception present dans le modele. */
  relationship justifie {
    title 'Justifie'
    line dashed
    color decisionGreen
  }

  /** Decoule de : le document source est l'origine d'une affirmation du modele. */
  relationship derives-from {
    title 'Decoule du document source'
    line dotted
    color sourceGray
  }

  // --- Relations du lot 3 (point 4) ---
  /** Le composant est implemente par une brique logicielle du marche
   *  (role = PRIMARY ou SECONDARY porte par le tag de la cible). */
  relationship implemented-by {
    title 'Est implemente par'
    line dotted
    color softwareTeal
  }

  /** Trace de substitution : la brique cible peut remplacer la brique source
   *  (usage principal : secondaire -> primaire, et reciproquement). */
  relationship alternative-to {
    title 'Alternative a'
    line dashed
    color softwareTeal
  }

  /** Le composant ou la brique est expose a un risque identifie. */
  relationship exposed-to {
    title 'Est expose a'
    line dotted
    color riskRed
  }

  /** La famille algorithmique ne couvre pas cet angle mort : c est un trou
   *  de couverture assume, pas un defaut d implementation. */
  relationship does-not-cover {
    title 'Ne couvre pas'
    line dotted
    color blindspotBrown
  }

  // ===========================================================================
  // KINDS DE NOEUDS DE DEPLOIEMENT
  // ===========================================================================
  deploymentNode host {
    title 'Noeud'
    notation 'Noeud de deploiement'
  }
}

// =============================================================================
//  MODELE LOGIQUE — UNIQUE SOURCE DE VERITE
//  Regle : la hierarchie reflete les zones de deploiement, pas la structure
//  organisationnelle. Toutes les relations sont declarees a plat APRES les
//  declarations de frontieres (LikeC4 interdit parent <-> enfant).
//
//  DECLARATION DE GRANULARITE C4 (modele C4 de Simon Brown) :
//    N1 Contexte   -> vues `contexte` / `contexte-amont` / `contexte-aval`
//    N2 Conteneurs -> les 4 ZONES (onboard / edge / c2 / cloud) SONT les
//                     conteneurs executables ; vue `conteneurs`
//    N3 Composants -> les elements `onboard.*` / `edge.*` / `c2.*` / `cloud.*`
//                     sont les composants ; vues `zone-*`
//    N4 Code       -> non couvert (optionnel, genere depuis le code)
//  Les kinds hypothesis / decision / software / algorithm / risk / blindspot
//  sont des QUALIFICATEURS de l'architecture, pas des composants : ils
//  n'apparaissent jamais dans les vues de zone.
// =============================================================================
model {

  // ===========================================================================
  // LOT 1 — TRAÇABILITE VERS LE DOCUMENT SOURCE
  // Les ids de composants suivent la §13 de swarm30_arch.md. Chaque composant
  // porte metadata { source '<section>' } et un link vers le document.
  // ===========================================================================

  // ===========================================================================
  // LOT 1 — HYPOTHESES EXPLICITES (H1..H5, cf. §1.2 du document source)
  // Chaque hypothese est une ENTITE, pas une phrase dans une description :
  // elle peut donc etre requetee, et son impact analyse (vue `hypotheses`).
  // ===========================================================================
  h1 = hypothesis 'H1 — Autopilote avec mode mission embarquee' {
    #hypothese #validee
    description '''
      **Enonce.** Chaque plateforme possede un autopilote avec controle
      d'attitude/position et un mode "mission embarquee" (waypoints, geofence, RTL).
      **Evidence : HIGH** (pratique standard ArduPilot/PX4, capacites publiques).

      **Si faux** : le principe directeur "le lien est un bonus" s'effondre ;
      la mission depend alors du lien C2 -> rearchitecture complete du onboard.
    '''
    metadata { niveau_preuve 'HIGH'; section '§1.2'; impact_si_faux 'principe directeur invalide' }
  }

  h2 = hypothesis 'H2 — Liens intermittents par defaut' {
    #hypothese #validee
    description '''
      **Enonce.** Les liens sont intermittents par defaut : aucune connectivite
      permanente air-sol garantie.
      **Evidence : HIGH** comme hypothese de conception (contrainte donnee),
      **MEDIUM** sur les taux de coupure reels.

      **Si faux** (lien permanent disponible) : la complexite store-and-forward
      et l'allocation decentralisee deviennent sur-dimensionnees (cout, pas risque).
    '''
    metadata { niveau_preuve 'HIGH (conception) / MEDIUM (taux)'; section '§1.2'; impact_si_faux 'sur-dimensionnement' }
  }

  h3 = hypothesis 'H3 — GNSS degradable ou brouillable' {
    #hypothese #a-valider
    description '''
      **Enonce.** GPS/GNSS peut etre degrade ou brouille localement ; la
      navigation doit tolerer des trous.
      **Evidence : MEDIUM** (phenomene documente, probabilite locale inconnue).

      **Si faux** : la redondance de position (INS + odometrie + relative)
      peut etre allegee. **Restant le plus risque** : la probabilite locale
      n'est pas caracterisee -> a valider par campagne de brouillage.
    '''
    metadata { niveau_preuve 'MEDIUM'; section '§1.2'; impact_si_faux 'redondance allegeable'; risque 'probabilite locale inconnue' }
  }

  h4 = hypothesis 'H4 — Coordination hors portee via relais Edge' {
    #hypothese #a-valider
    description '''
      **Enonce.** La coordination inter-plateformes au-dela de la portee radio
      directe passe par un relais Edge (plateforme ou station relais).
      **Evidence : MEDIUM.**

      **Si faux** (mesh suffisant) : la couche Edge perd sa justification de
      coordination ; reste pertinente pour la passarelle de confiance.
    '''
    metadata { niveau_preuve 'MEDIUM'; section '§1.2'; impact_si_faux 'Edge reduit a passarelle' }
  }

  h5 = hypothesis 'H5 — Autorite humaine sur les actions critiques' {
    #hypothese #validee
    description '''
      **Enonce.** Les actions critiques (armement, largage, tir, changement de
      zone) restent sous autorite humaine ou sous regles embarquees pre-approuvees.
      **Evidence : HIGH** (exigence de gouvernance, non technique).

      **Si faux** : `onboard.safety` (ABORT local pre-approuve) et `c2.auth`
      (authorization_ref) sont a revoir ; le modele d'autorisation change.
    '''
    metadata { niveau_preuve 'HIGH (gouvernance)'; section '§1.2'; impact_si_faux 'modele d autorisation a revoir' }
  }

  // ===========================================================================
  // LOT 1 — DECISIONS D'ARCHITECTURE (ADR, cf. §10 conflits arbitres + §3)
  // ===========================================================================
  adr1 = decision 'ADR-1 — Contrat de mission embarque, replanification opportuniste' {
    #decision
    description '''
      **Contexte.** Conflit §10.1 : centralisation (C2) vs autonomie (onboard).
      **Decision.** Plan embarque versionne et signe ; le C2 replanifie UNIQUEMENT
      quand le lien est disponible (hybride).
      **Alternatives rejetees.** (a) Pilotage C2 temps reel -> exclu (H2) ;
      (b) autonomie totale sans C2 -> perd l'autorite humaine (H5).
      **Consequence.** `onboard.mission` doit fonctionner sans lien ; le C2 est
      un optimiseur, pas un point de passage obligatoire.
    '''
    metadata { conflit '§10.1'; alternatives_rejetees 'C2 temps reel; autonomie totale'; statut 'acceptee' }
  }

  adr2 = decision 'ADR-2 — Fraicheur explicite, pas de coherence forte' {
    #decision
    description '''
      **Contexte.** Conflit §10.2 : fraicheur vs coherence (SCIENCE/DATA).
      **Decision.** Chaque message porte t_publish et t_valid ; la fraicheur est
      explicite et jamais supposee. Pas de coherence forte distribuee.
      **Alternatives rejetees.** Horloge globale synchronisee -> impossible hors
      lien permanent (H2).
      **Consequence.** `onboard.telemetry` porte les deux horodatages ;
      `onboard.linkRadio` transporte le delta avec priorisation.
    '''
    metadata { conflit '§10.2'; alternatives_rejetees 'horloge globale synchronisee'; statut 'acceptee' }
  }

  adr3 = decision 'ADR-3 — Canaux de surete et de securite separes' {
    #decision
    description '''
      **Contexte.** Conflit §10.3 : surete (SAFETY) vs securite (SECURITY).
      **Decision.** `onboard.safety` n'est PAS bloquee par la couche crypto ;
      les ordres critiques entrent signes ; une compromission reste isolee.
      **Alternatives rejetees.** Crypto sur la voie de surete -> introduirait un
      point de defaillance commun et une latence.
      **Consequence.** Deux chemins distincts vers `onboard.autopilot` :
      mission (bus interne) et safety (voie preemptive independante du lien).
    '''
    metadata { conflit '§10.3'; alternatives_rejetees 'crypto sur voie de surete'; statut 'acceptee' }
  }

  adr4 = decision 'ADR-4 — Traitement lourd deporte hors boucle de controle' {
    #decision
    description '''
      **Contexte.** Conflit §10.4 : traitement lourd (ALGORITHMS) vs ressources
      onboard (HARDWARE).
      **Decision.** Edge pour la fusion tactique de proximite ; Cloud uniquement
      en differe et hors boucle de controle.
      **Alternatives rejetees.** Traitement lourd onboard -> cout energetique et
      thermique incompatible avec l'autonomie.
      **Consequence.** Aucune dependance bloquante onboard/edge -> cloud.
    '''
    metadata { conflit '§10.4'; alternatives_rejetees 'traitement lourd onboard'; statut 'acceptee' }
  }

  adr5 = decision 'ADR-5 — Robustesse preferee a l optimalite sous partition' {
    #decision
    description '''
      **Contexte.** Conflit §10.5 : optimalite vs robustesse (ALGORITHMS/VALIDATION).
      **Decision.** Allocation par encheres decentralisees (consensus eventuel),
      jamais de consensus global dur.
      **Alternatives rejetees.** Optimisation globale centralisee -> fragile
      des que le lien tombe (H2).
      **Consequence.** `onboard.task-auction` est le mecanisme par defaut ;
      la replanification C2 est un bonus opportuniste.
    '''
    metadata { conflit '§10.5'; alternatives_rejetees 'optimisation globale centralisee'; statut 'acceptee' }
  }

  // ===========================================================================
  // LOT 1 — DOCUMENT SOURCE (entite de tracabilite)
  // Le document d'architecture est un artefact du systeme documentaire :
  // on le modelise pour que la tracabilite soit VISIBLE et REQUETABLE,
  // pas seulement une metadonnee cachee.
  // ===========================================================================
  docSource = external 'Document d architecture — swarm30_arch.md' {
    #source-doc
    description '''
      Document source de reference (13 sections, 370 lignes).
      **C'est lui qui porte les enonces H1..H5 (§1.2), les conflits (§10)
      et les budgets (§8).** Chaque composant porte `metadata.source` = sa
      section ; cette entite materialise le lien dans le graphe.

      Fichier : `swarm30_arch.md` (livrable 1).
    '''
    metadata { type 'document'; sections '13'; chemin '/home/hermesagent/workspace/swarm30_arch.md' }
    style { icon bootstrap:file-earmark-text }
  }

  // ===========================================================================
  // EXTERNES
  // ===========================================================================
  radios = external 'Radios / GNSS / Capteurs' {
    #external-src
    description '''
      Sources et moyens physiques hors perimetre logiciel :
      GNSS (degradable/brouillable), INS, odometrie, capteurs de perception,
      radios heterogenes (LoRa, 802.11 mesh, lien dedie, longue portee).
      H3 : GPS/GNSS peut etre degrade ou brouille localement.
    '''
    style { icon bootstrap:broadcast }
  }

  operator = operator 'Operateur humain (GCS)'

  // ===========================================================================
  // BOUNDARY 1 — ONBOARD (x30)
  // Tout ce qui touche a la surete de vol et a la continuite de mission locale.
  // ===========================================================================
  onboard = platform 'Plateformes onboard (x30)' {
    #zone-onboard
    link https://doi.org/10.20944/preprints202603.2299.v1 "A Systematic Mapping of UAV Swarming Strategies: From Fundamentals to Coordination Mechanisms and Algorithmic Paradigms"
    description '''
      18 UAV-R (multirotors), 8 UAV-F (voilure fixe), 4 USV.
      Instance unique dans le modele logique : elle est materialisee 30 fois
      dans le modele de deploiement (cf. deployment).
      **Doit terminer sa mission nominale sans C2 ni cloud.**
    '''
    metadata { source '§3 zones / §4.1 onboard' }

    sensorsHAL = component 'Interfaces capteurs' {
      #best-effort
      technology 'HAL — drivers bas niveau'
      description '''
Abstraction materielle capteurs/actionneurs. Absorbe l'heterogeneite des plateformes.

### Fiche de lecture

**Identifiant stable :** `onboard.sensorsHAL`

**Rôle :** Interfaces capteurs.

**Technologie déclarée :** HAL — drivers bas niveau.

**Entrées :** radios — capteurs / GNSS / liaisons physiques; refDrone.imu — etat inertiel; refDrone.gnss — position absolue; refDrone.odometry — vitesse / cap / altitude; refDrone.perceptionRel — pistes relatives voisins; refDrone.saeSensor — obstacles proches; refDrone.healthSensor — etat materiel

**Sorties :** onboard.perception — flux capteurs; onboard.health — sante capteurs; onboard.autopilot — etat navigation

**Contraintes déclarées :** criticite: best-effort; frequence: selon capteur; principe: abstraction obligatoire (HARDWARE)

**Autonomie :** Conception : continuité nominale locale sans C2 ni cloud ; vérifier les conditions et limites dans les hypothèses.

**Références :** §4.1 onboard.sensors-hal ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-onboard/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata {
        criticite 'best-effort'
        frequence 'selon capteur'
        principe 'abstraction obligatoire (HARDWARE)'
        source '§4.1 onboard.sensors-hal'
      }
      style { icon bootstrap:cpu }
    }

    perception = component 'Perception et localisation' {
      #safety-critical
      link https://www.kongsberg.com/what-we-do/ocean-space/autonomous-and-uncrewed-solutions/auv/hugin/ "HUGIN (AUV) — KONGSBERG"
      link https://www.kongsberg.com/globalassets/kongsberg/1.-what-we-do/2.-ocean-space/1.-autonomous-and-uncrewed-solutions/hugin/documents/110-0047668-b-hugin_3000_datasheet.pdf "HUGIN 3000 — datasheet (capteurs SAS, navigation inertielle)"
      technology 'Fusion capteurs + filtre complementaire'
      description '''
Fusion multi-capteurs, detection/evitement (sense-and-avoid),
estimation d'etat et estimation relative inter-agents.
Redondance de position : GNSS + INS + odometrie + relative.
Traitement in-mission (reconnaissance de cibles, navigation de terrain)
requis pour les USV/AUV : renforce le besoin de calcul local de perception.

### Fiche de lecture

**Identifiant stable :** `onboard.perception`

**Rôle :** Perception et localisation.

**Technologie déclarée :** Fusion capteurs + filtre complementaire.

**Entrées :** onboard.sensorsHAL — flux capteurs

**Sorties :** onboard.autopilot — estimation position/etat; onboard.mission — pistes/obstacles; onboard.safety — detection d'evitement

**Contraintes déclarées :** criticite: safety-critical; frequence: 10-60 Hz; alerte: sense-and-avoid -> action : <= 100 ms [EXTRAP]

**Autonomie :** Conception : continuité nominale locale sans C2 ni cloud ; vérifier les conditions et limites dans les hypothèses.

**Références :** §4.1 onboard.perception / §8 budget ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-onboard/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata {
        criticite 'safety-critical'
        frequence '10-60 Hz'
        alerte 'sense-and-avoid -> action : <= 100 ms [EXTRAP]'
        source '§4.1 onboard.perception / §8 budget'
      }
      style { icon bootstrap:crosshair2 }
    }

    autopilot = component 'Pilotage automatique' {
      #safety-critical
      technology 'Bus interne MAVLink / UART-CAN'
      description '''
Controle d'attitude/position, execution des consignes de vol,
application du geofence. H1 : mode "mission embarquee"
(waypoints, geofence, RTL) disponible sur tout autopilote.

### Fiche de lecture

**Identifiant stable :** `onboard.autopilot`

**Rôle :** Pilotage automatique.

**Technologie déclarée :** Bus interne MAVLink / UART-CAN.

**Entrées :** onboard.sensorsHAL — etat navigation; onboard.perception — estimation position/etat; onboard.mission — setpoints de mission; onboard.safety — commandes preemptives (RTL/atterrissage)

**Sorties :** Aucun flux explicite dans le modèle ; à documenter si nécessaire.

**Contraintes déclarées :** criticite: safety-critical; frequence: 50-400 Hz; budget_latence: <= 10 ms (boucle pilotage); interface: setpoints, statut armement

**Autonomie :** Conception : continuité nominale locale sans C2 ni cloud ; vérifier les conditions et limites dans les hypothèses.

**Références :** §4.1 onboard.autopilot / §8 budget ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-onboard/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata {
        criticite 'safety-critical'
        frequence '50-400 Hz'
        budget_latence '<= 10 ms (boucle pilotage)'
        interface 'setpoints, statut armement'
        source '§4.1 onboard.autopilot / §8 budget'
      }
      style { icon bootstrap:compass }
    }

    safety = component 'Garde-fous de sûreté' {
      #safety-critical
      technology 'Garde-fous independants'
      description '''
Geofence, detection de perte de controle, RTL / atterrissage
d'urgence, limitateur d'energie. Voie de surete SEPAREE :
non bloquee par la couche crypto et fonctionnelle sans lien.
ABORT declenche localement selon regles pre-approuvees.

### Fiche de lecture

**Identifiant stable :** `onboard.safety`

**Rôle :** Garde-fous de sûreté.

**Technologie déclarée :** Garde-fous independants.

**Entrées :** onboard.perception — detection d'evitement; onboard.health — niveaux de sante; onboard.energy — seuils critiques; onboard.linkRadio — ordres critiques entrants

**Sorties :** onboard.autopilot — commandes preemptives (RTL/atterrissage)

**Contraintes déclarées :** criticite: safety-critical; autonomie: doit fonctionner sans lien; arbitrage: surete vs securite : canaux separes (§10.3)

**Autonomie :** Conception : continuité nominale locale sans C2 ni cloud ; vérifier les conditions et limites dans les hypothèses.

**Références :** §4.1 onboard.safety / ADR-3 ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-onboard/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata {
        criticite 'safety-critical'
        autonomie 'doit fonctionner sans lien'
        arbitrage 'surete vs securite : canaux separes (§10.3)'
        source '§4.1 onboard.safety / ADR-3'
      }
      style { icon bootstrap:shield-check }
    }

    mission = component 'Exécution de mission' {
      #mission-critical
      technology 'Executeur de plan embarque (machine a etats)'
      description '''
Executeur du plan de mission embarque et allocation locale de taches.
Machine a etats : INIT -> READY -> LAUNCH -> EXECUTE
-> (DEGRADED <=> EXECUTE) -> RTL/RECOVER -> LAND -> DONE ; ABORT partout.
EXECUTE fonctionne SANS lien.

