      style { shape storage; icon bootstrap:database-fill-gear }
    }

    alerting = component 'Notifications opérateur' {
      #best-effort
      technology 'Agregation d\'alarmes'
      description '''
Agregation des alarmes et notification operateur.

### Fiche de lecture

**Identifiant stable :** `c2.alerting`

**Rôle :** Notifications opérateur.

**Technologie déclarée :** Agregation d'alarmes.

**Entrées :** c2.gcs — evenements a notifier

**Sorties :** c2.gcs — notifications operateur

**Contraintes déclarées :** criticite: best-effort

**Autonomie :** Supervision intermittente ; ne porte pas la boucle de pilotage embarquée.

**Références :** §4.3 c2.alerting ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-c2/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata { criticite 'best-effort'; source '§4.3 c2.alerting' }
      style { icon bootstrap:exclamation-triangle }
    }
  }

  // ===========================================================================
  // BOUNDARY 4 — CLOUD (hors boucle de controle)
  // Non temps reel, couteux, tolerable en differe.
  // ===========================================================================
  cloud = cloudSystem 'Cloud (hors boucle de controle)' {
    #zone-cloud
    description '''
      Strictement hors boucle de controle. Budget : minutes (differe).
      Aucune dependance bloquante admise vers cette zone depuis onboard/edge.
    '''
    metadata { source '§3 zones / §4.4 cloud' }

    twin = component 'Jumeau numérique' {
      #cloudOnly
      technology 'Jumeau numerique'
      description '''
Jumeau numerique : rejeu, simulation, prediction de derive, calibration / entrainement de modeles.

### Fiche de lecture

**Identifiant stable :** `cloud.twin`

**Rôle :** Jumeau numérique.

**Technologie déclarée :** Jumeau numerique.

**Entrées :** edge.gateway — logs/etat differes; cloud.replayStore — journaux rejouables

**Sorties :** cloud.analytics — donnees de rejeu

**Contraintes déclarées :** criticite: best-effort; boucle: hors boucle de controle

**Autonomie :** Traitement différé, hors boucle de contrôle ; jamais bloquant pour la mission.

**Références :** §4.4 cloud.twin ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-cloud/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata { criticite 'best-effort'; boucle 'hors boucle de controle'; source '§4.4 cloud.twin' }
      style { icon bootstrap:layers }
    }

    analytics = component 'Analyse post-mission' {
      #cloudOnly
      technology 'Analytics post-mission'
      description '''
Analyse post-mission, metriques de performance, detection d'anomalies a posteriori.

### Fiche de lecture

**Identifiant stable :** `cloud.analytics`

**Rôle :** Analyse post-mission.

**Technologie déclarée :** Analytics post-mission.

**Entrées :** cloud.twin — donnees de rejeu

**Sorties :** cloud.modelRegistry — metriques -> modeles

**Contraintes déclarées :** criticite: best-effort; boucle: hors boucle de controle

**Autonomie :** Traitement différé, hors boucle de contrôle ; jamais bloquant pour la mission.

**Références :** §4.4 cloud.analytics ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-cloud/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata { criticite 'best-effort'; boucle 'hors boucle de controle'; source '§4.4 cloud.analytics' }
      style { icon bootstrap:graph-up }
    }

    modelRegistry = component 'Registre des modèles' {
      #cloudOnly
      technology 'Registre de modeles'
      description '''
Versionnement des modeles (perception, allocation) et des configurations.

### Fiche de lecture

**Identifiant stable :** `cloud.modelRegistry`

**Rôle :** Registre des modèles.

**Technologie déclarée :** Registre de modeles.

**Entrées :** cloud.analytics — metriques -> modeles

**Sorties :** c2.planner — modeles/configurations

**Contraintes déclarées :** criticite: best-effort

**Autonomie :** Traitement différé, hors boucle de contrôle ; jamais bloquant pour la mission.

**Références :** §4.4 cloud.model-registry ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-cloud/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata { criticite 'best-effort'; source '§4.4 cloud.model-registry' }
      style { shape storage; icon bootstrap:file-earmark-richtext }
    }

    replayStore = component 'Journaux de rejeu' {
      #cloudOnly
      technology 'Stockage de journaux'
      description '''
Stockage des journaux pour rejouabilite et tests de non-regression.

### Fiche de lecture

**Identifiant stable :** `cloud.replayStore`

**Rôle :** Journaux de rejeu.

**Technologie déclarée :** Stockage de journaux.

**Entrées :** Aucun flux explicite dans le modèle ; à documenter si nécessaire.

**Sorties :** cloud.twin — journaux rejouables

**Contraintes déclarées :** criticite: best-effort; usage: Monte-Carlo + non-regression

**Autonomie :** Traitement différé, hors boucle de contrôle ; jamais bloquant pour la mission.

**Références :** §4.4 cloud.replay-store / §9 tests ; consulter les relations de traçabilité vers les hypothèses et ADR.

**Statut :** description de conception, pas une mesure de disponibilité. Les budgets EXTRAP sont à valider.

[Retour à la couche](/view/zone-cloud/) · [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/)
'''
      metadata { criticite 'best-effort'; usage 'Monte-Carlo + non-regression'; source '§4.4 cloud.replay-store / §9 tests' }
      style { shape storage; icon bootstrap:clock-history }
    }
  }

  // ===========================================================================
  // RELATIONS — liste EXACTE de la section 13 du document d'entree
  // ===========================================================================

  // --- 13.1 Externe -> Onboard ---
  radios -[radio]-> onboard.sensorsHAL 'capteurs / GNSS / liaisons physiques' {
    technology 'Electrique / bus capteur'
    metadata { criticite 'safety-critical'; fiabilite 'GNSS degradable (H3)' }
  }

  // --- 13.2 Boucle onboard (bus interne) ---
  onboard.sensorsHAL -[flow]-> onboard.perception 'flux capteurs' {
    technology 'Bus capteur'; metadata { criticite 'safety-critical'; frequence '10-60 Hz' } }
  onboard.sensorsHAL -[flow]-> onboard.health 'sante capteurs' {
    technology 'Bus capteur'; metadata { criticite 'mission-critical' } }
  onboard.sensorsHAL -[flow]-> onboard.autopilot 'etat navigation' {
    technology 'Bus interne'; metadata { criticite 'safety-critical' } }
  onboard.perception -[flow]-> onboard.autopilot 'estimation position/etat' {
    technology 'Bus interne MAVLink'; metadata { criticite 'safety-critical'; frequence '50-400 Hz' } }
  onboard.perception -[flow]-> onboard.mission 'pistes/obstacles' {
    technology 'Bus interne'; metadata { criticite 'mission-critical' } }
  onboard.perception -[flow]-> onboard.safety 'detection d\'evitement' {
    technology 'Bus interne'; metadata { criticite 'safety-critical'; latence '<= 100 ms [EXTRAP]' } }
  onboard.mission -[command]-> onboard.autopilot 'setpoints de mission' {
    technology 'Bus interne MAVLink'; metadata { criticite 'safety-critical'; frequence '50-400 Hz' } }
  onboard.mission -[flow]-> onboard.taskAuction 'taches ouvertes' {
    technology 'Bus interne'; metadata { criticite 'mission-critical'; frequence '0.2-1 Hz' } }
  onboard.taskAuction -[flow]-> onboard.mission 'attributions de taches' {
    technology 'Bus interne'; metadata { criticite 'mission-critical' } }
  onboard.health -[flow]-> onboard.safety 'niveaux de sante' {
    technology 'Bus interne'; metadata { criticite 'safety-critical' } }
  onboard.health -[flow]-> onboard.energy 'etat batterie' {
    technology 'Bus interne'; metadata { criticite 'mission-critical' } }
  onboard.health -[flow]-> onboard.telemetry 'diagnostic' {
    technology 'Bus interne'; metadata { criticite 'best-effort' } }
  onboard.energy -[flow]-> onboard.mission 'marge/retour' {
    technology 'Bus interne'; metadata { criticite 'mission-critical'; frequence '0.2-2 Hz' } }
  onboard.energy -[flow]-> onboard.safety 'seuils critiques' {
    technology 'Bus interne'; metadata { criticite 'safety-critical' } }
  onboard.safety -[safety]-> onboard.autopilot 'commandes preemptives (RTL/atterrissage)' {
    technology 'Bus interne — voie de surete'
    metadata { criticite 'safety-critical'; priorite '1 (preemptif)'; independant_du_lien 'oui' } }
  onboard.mission -[flow]-> onboard.telemetry 'etat de mission' {
    technology 'Bus interne'; metadata { criticite 'mission-critical'; frequence '1-10 Hz' } }
  onboard.telemetry -[flow]-> onboard.linkRadio 'telemetrie priorisee' {
    technology 'File priorisee'; metadata { criticite 'best-effort'; compactage 'delta + quantification' } }
  onboard.mission -[flow]-> onboard.linkRadio 'annonces etat/taches' {
    technology 'Protocole essaim'; metadata { criticite 'mission-critical'; signature 'obligatoire' } }
  onboard.linkRadio -[command]-> onboard.mission 'taches/ordres recus' {
    technology 'Protocole essaim'; metadata { criticite 'mission-critical'; controle 'ordres signes uniquement' } }
  onboard.linkRadio -[command]-> onboard.safety 'ordres critiques entrants' {
    technology 'Protocole essaim'
    metadata { criticite 'safety-critical'; controle 'refus des ordres non signes'; note 'safety non bloquee par la crypto' } }

  // --- 13.3 Onboard <-> Edge (radio intermittente) ---
  onboard.linkRadio -[flow]-> edge.relay 'trafic essaim (radio)' {
    technology 'Radio directe / mesh — intermittente'
    metadata { criticite 'mission-critical'; intermittence 'par defaut (H2)'; mode 'store-and-forward si coupure' } }
  edge.relay -[flow]-> onboard.linkRadio 'messages descendants' {
    technology 'Radio directe / mesh — intermittente'
    metadata { criticite 'mission-critical'; note 'lien = bonus, jamais dependance' } }

  // --- 13.4 Boucle Edge ---
  edge.relay -[flow]-> edge.fusion 'trafic consolide' {
    technology 'Bus Edge'; metadata { criticite 'mission-critical'; frequence '1-10 Hz' } }
  edge.relay -[flow]-> edge.gateway 'trafic vers C2/cloud' {
    technology 'Passerelle'; metadata { criticite 'mission-critical' } }
  edge.fusion -[flow]-> edge.coordinator 'image tactique locale' {
    technology 'Bus Edge'; metadata { criticite 'mission-critical' } }
  edge.fusion -[flow]-> edge.gateway 'image tactique vers C2' {
    technology 'Passerelle'; metadata { criticite 'mission-critical' } }
  edge.coordinator -[command]-> edge.relay 'directives vers agents' {
    technology 'Bus Edge'; metadata { criticite 'mission-critical'; latence '<= 1 s [EXTRAP]' } }
  edge.coordinator -[store]-> edge.cache 'snapshot d\'etat' {
    technology 'Persistance locale'; metadata { criticite 'best-effort' } }
  edge.cache -[store]-> edge.gateway 'artefacts persistes' {
    technology 'Passerelle'; metadata { criticite 'best-effort' } }

  // --- 13.5 Edge <-> C2 ---
  edge.gateway -[flow]-> c2.gcs 'image tactique/telemetrie' {
    technology 'MQTT / broker (protocole normalise)'
    metadata { criticite 'mission-critical'; intermittence 'oui'; contrat 'versionne' } }
  c2.gcs -[command]-> edge.gateway 'ordres/plans' {
    technology 'MQTT / broker'
    metadata { criticite 'mission-critical'; exigence 'ordres signes + authorization_ref' } }

  // --- 13.6 Boucle C2 ---
  c2.gcs -[flow]-> c2.planner 'intentions operateur' {
    technology 'Bus C2'; metadata { criticite 'mission-critical' } }
  c2.planner -[store]-> c2.missionStore 'plans versionnes' {
    technology 'Bus C2'; metadata { criticite 'mission-critical'; versionnement 'plan_version' } }
  c2.planner -[flow]-> edge.gateway 'plans embarquables' {
    technology 'MQTT / broker'; metadata { criticite 'mission-critical'; signature 'obligatoire' } }
  c2.auth -[flow]-> c2.gcs 'jetons d\'autorisation' {
    technology 'Bus C2'; metadata { criticite 'safety-critical'; exigence 'authorization_ref sur action critique' } }
  c2.auth -[store]-> c2.missionStore 'traces d\'audit' {
    technology 'Bus C2'; metadata { criticite 'safety-critical'; exigence 'zero perte non journalisee' } }
  c2.gcs -[flow]-> c2.alerting 'evenements a notifier' {
    technology 'Bus C2'; metadata { criticite 'best-effort' } }
  c2.alerting -[flow]-> c2.gcs 'notifications operateur' {
    technology 'IHM'; metadata { criticite 'best-effort' } }
  operator -[sync]-> c2.gcs 'supervise et autorise les actions critiques' {
    technology 'IHM operateur'
    metadata { criticite 'safety-critical'; autorite 'humaine (H5)' } }

  // --- 13.7 Edge <-> Cloud (differe, hors boucle) ---
  edge.gateway -[async]-> cloud.twin 'logs/etat differes' {
    technology 'MQTT / API differee — store-and-forward'
    metadata { criticite 'best-effort'; boucle 'hors boucle de controle'; latence 'minutes' } }

  // --- 13.8 Boucle Cloud ---
  cloud.twin -[flow]-> cloud.analytics 'donnees de rejeu' {
    technology 'Pipeline differe'; metadata { criticite 'best-effort' } }
  cloud.analytics -[flow]-> cloud.modelRegistry 'metriques -> modeles' {
    technology 'Pipeline differe'; metadata { criticite 'best-effort' } }
  cloud.replayStore -[store]-> cloud.twin 'journaux rejouables' {
    technology 'Pipeline differe'; metadata { criticite 'best-effort'; usage 'non-regression' } }

  // --- 13.9 Cloud -> C2 (retour de modeles, differe, JAMAIS bloquant) ---
  cloud.modelRegistry -[flow]-> c2.planner 'modeles/configurations' {
    technology 'API differee'
    metadata { criticite 'best-effort'; boucle 'hors boucle de controle'; dependance 'non bloquante' } }

  // ===========================================================================
  // LOT 1 — RELATIONS DE TRACABILITE : composants -> hypotheses
  // Lecture : "si l'hypothese est fausse, cet element est a revoir".
  // C'est ce qui rend l'analyse d'impact requetable (vue `hypotheses`).
  // ===========================================================================

  onboard.autopilot -[depend-on]-> h1 'repose sur le mode mission embarque' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }
  onboard.mission -[depend-on]-> h1 'le plan embarque suppose H1' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }
  onboard.safety -[depend-on]-> h1 'garde-fous locaux supposent l autopilote' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }

  onboard.linkRadio -[depend-on]-> h2 'dimensionne pour un lien intermittent' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }
  onboard.mission -[depend-on]-> h2 'la continuite de mission suppose H2' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }
  onboard.taskAuction -[depend-on]-> h2 'robuste aux partitions (H2)' {
    technology 'Hypothese de conception'; metadata { impact 'critique' } }
  edge.coordinator -[depend-on]-> h2 'prend le relais quand le lien tombe' {
    technology 'Hypothese de conception'; metadata { impact 'eleve' } }

  onboard.perception -[depend-on]-> h3 'redondance de position pour tolerer les trous GNSS' {
    technology 'Hypothese de conception'; metadata { impact 'eleve'; risque 'MEDIUM' } }

  edge.relay -[depend-on]-> h4 'justifie le relais hors portee directe' {
    technology 'Hypothese de conception'; metadata { impact 'moyen' } }
  edge.coordinator -[depend-on]-> h4 'coordination via Edge au-dela de la portee' {
    technology 'Hypothese de conception'; metadata { impact 'moyen' } }

  onboard.safety -[depend-on]-> h5 'ABORT local selon regles pre-approuvees' {
    technology 'Hypothese de gouvernance'; metadata { impact 'critique' } }
  c2.auth -[depend-on]-> h5 'authorization_ref sur action critique' {
    technology 'Hypothese de gouvernance'; metadata { impact 'critique' } }
  c2.gcs -[depend-on]-> h5 'seul chemin d autorisation humaine' {
    technology 'Hypothese de gouvernance'; metadata { impact 'critique' } }
  operator -[depend-on]-> h5 'autorite humaine sur les actions critiques' {
    technology 'Hypothese de gouvernance'; metadata { impact 'critique' } }

  // ===========================================================================
  // LOT 1 — RELATIONS DE TRACABILITE : decisions -> ce qu'elles justifient
  // ===========================================================================
  adr1 -[justifie]-> onboard.mission 'plan embarque + replanif opportuniste' {
    metadata { conflit '§10.1' } }
  adr1 -[justifie]-> c2.planner 'replanification quand le lien est disponible' {
    metadata { conflit '§10.1' } }
  adr2 -[justifie]-> onboard.telemetry 't_publish / t_valid explicites' {
    metadata { conflit '§10.2' } }
  adr3 -[safety]-> onboard.safety 'voie de surete non bloquee par la crypto' {
    metadata { conflit '§10.3' } }
  adr3 -[command]-> c2.auth 'ordres critiques signes + audit' {
    metadata { conflit '§10.3' } }
  adr4 -[justifie]-> edge.fusion 'fusion tactique deportee sur Edge' {
    metadata { conflit '§10.4' } }
  adr4 -[async]-> cloud.twin 'traitement lourd en differe, hors boucle' {
    metadata { conflit '§10.4' } }
  adr5 -[justifie]-> onboard.taskAuction 'encheres decentralisees par defaut' {
    metadata { conflit '§10.5' } }

  // ===========================================================================
  // LOT 1 — RELATIONS DE TRACABILITE : zones/hypotheses/ADR -> document source
  // Materialise dans le graphe le lien "cette affirmation vient de la section X".
  // ===========================================================================
  onboard -[derives-from]-> docSource 'decrit en §4.1 (13 composants)' {
    technology 'Tracabilite documentaire'; metadata { sections '§4.1' } }
  edge -[derives-from]-> docSource 'decrit en §4.2 (5 composants)' {
    technology 'Tracabilite documentaire'; metadata { sections '§4.2' } }
  c2 -[derives-from]-> docSource 'decrit en §4.3 (7 composants)' {
    technology 'Tracabilite documentaire'; metadata { sections '§4.3' } }
  cloud -[derives-from]-> docSource 'decrit en §4.4 (4 composants)' {
    technology 'Tracabilite documentaire'; metadata { sections '§4.4' } }
  h1 -[depend-on]-> docSource 'enonce en §1.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§1.2' } }
  h2 -[depend-on]-> docSource 'enonce en §1.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§1.2' } }
  h3 -[depend-on]-> docSource 'enonce en §1.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§1.2' } }
  h4 -[depend-on]-> docSource 'enonce en §1.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§1.2' } }
  h5 -[depend-on]-> docSource 'enonce en §1.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§1.2' } }
  adr1 -[justifie]-> docSource 'arbitre le conflit §10.1' {
    technology 'Tracabilite documentaire'; metadata { sections '§10.1' } }
  adr2 -[justifie]-> docSource 'arbitre le conflit §10.2' {
    technology 'Tracabilite documentaire'; metadata { sections '§10.2' } }
  adr3 -[justifie]-> docSource 'arbitre le conflit §10.3' {
    technology 'Tracabilite documentaire'; metadata { sections '§10.3' } }
  adr4 -[justifie]-> docSource 'arbitre le conflit §10.4' {
    technology 'Tracabilite documentaire'; metadata { sections '§10.4' } }
  adr5 -[justifie]-> docSource 'arbitre le conflit §10.5' {
    technology 'Tracabilite documentaire'; metadata { sections '§10.5' } }

  // ===========================================================================
  // LOT 3 — ÉLÉMENTS LOT 3 : LOGICIELS ET ALGORITHMES
  // Source : swarm30_annexe_v1.md §A (logiciels) et §B (algorithmes),
  //          IDs verifies dans mapping_ids_annexe_v1.md (camelCase),
  //          licences verifiees dans verification_annexe_v1.md.
  // Portee VOLONTAIREMENT limitee : AUCUNE relation, AUCUNE vue dans ce lot.
  // ===========================================================================

  // --- §A.1 Socle de vol ------------------------------------------------------
  AutopilotPX4 = software 'PX4 Autopilot' {
    metadata { licence 'BSD-3-Clause'; role 'PRIMARY'; zone 'onboard'; evidence 'HIGH' }
  }

  ArduPilot = software 'ArduPilot' {
    metadata { licence 'GPL-3.0'; role 'SECONDARY'; zone 'onboard'; evidence 'HIGH' }
  }

  // --- §A.2 Middleware & bus de donnees --------------------------------------
  ROS2 = software 'ROS 2' {
    metadata { licence 'Apache-2.0'; role 'PRIMARY'; zone 'onboard'; evidence 'HIGH' }
  }

  Zenoh = software 'Eclipse Zenoh' {
    metadata { licence 'Apache-2.0-OR-EPL-2.0'; role 'SECONDARY'; zone 'edge'; evidence 'MEDIUM' }
    description 'Adequation essaim radio a 30 agents = [EXTRAP], non prouvee. Preprint unique 2023.'
  }

  MosquittoMQTT = software 'Eclipse Mosquitto (MQTT)' {
    metadata { licence 'EPL-2.0-OR-BSD-3-Clause'; role 'SECONDARY'; zone 'edge'; evidence 'MEDIUM' }
  }

  // --- §A.3 Pont MCU / autopilote <-> ordinateur compagnon --------------------
  MicroXRCEDDS = software 'eProsima Micro XRCE-DDS' {
    metadata { licence 'Apache-2.0'; role 'PRIMARY'; zone 'onboard'; evidence 'HIGH' }
    description 'Reserve : README micro-ROS signale "not ready for production use" -> SIL/HIL renforce.'
  }

  MAVLinkMAVSDK = software 'MAVLink / MAVSDK' {
    metadata { licence 'MIT-AND-BSD-3-Clause'; role 'SECONDARY'; zone 'onboard'; evidence 'HIGH' }
  }

  // --- §A.6 GCS / supervision -------------------------------------------------
  QGroundControl = software 'QGroundControl' {
    metadata { licence 'Apache-2.0'; role 'PRIMARY'; zone 'c2'; evidence 'HIGH' }
  }

  // --- §A.8 Cloud : jumeau, stockage, observabilite ---------------------------
  GazeboSim = software 'Gazebo Sim (gz-sim)' {
    metadata { licence 'Apache-2.0'; role 'PRIMARY'; zone 'cloud'; evidence 'HIGH' }
  }

  MinIO = software 'MinIO' {
    metadata { licence 'AGPL-3.0'; role 'PRIMARY'; zone 'cloud'; evidence 'HIGH' }
    description 'AGPLv3 : obligations fortes si exposition reseau d une version modifiee. A valider juridiquement.'
  }

  Prometheus = software 'Prometheus' {
    metadata { licence 'Apache-2.0'; role 'PRIMARY'; zone 'cloud'; evidence 'HIGH' }
  }

  Grafana = software 'Grafana' {
    metadata { licence 'AGPL-3.0'; role 'PRIMARY'; zone 'cloud'; evidence 'HIGH' }
    description 'AGPL-3.0-only sur le coeur, sous-composants Apache-2.0. Meme remarque AGPL que MinIO.'
  }

  // --- §A.8 Donnees / registre de missions ------------------------------------
  PostgreSQLPostGIS = software 'PostgreSQL + PostGIS' {
    metadata { licence 'PostgreSQL-AND-GPL-2.0'; role 'SECONDARY'; zone 'cloud'; evidence 'HIGH' }
    description 'PostgreSQL License (permissive) pour le SGBD ; PostGIS en GPL-2.0+ (copyleft).'
  }

  // --- §A.9 Cartographie / navigation marine (USV) ----------------------------
  OpenCPN = software 'OpenCPN' {
    metadata { licence 'GPL-2.0'; role 'PRIMARY'; zone 'onboard'; evidence 'HIGH' }
    description 'Plotter marine des 4 USV ; composants LGPLv2+/v3 ; S-57 ENC, AIS, NMEA 0183/2000.'
  }

  // ===========================================================================
  // ALGORITHMES (§B) — une famille par FONCTION, 7 fonctions B.1..B.7
  // Toute performance a 30 agents heterogenes non mesuree est une extrapolation.
  // ===========================================================================

  // B.1 — perception / fusion multi-capteurs et multi-agents
  AlgorithmsPerceptionFusionEKFUKF = algorithm 'Perception et fusion (EKF/UKF local + pistes Edge)' {
    link https://doi.org/10.3390/drones9110752 "Enabling Cooperative Autonomy in UUV Clusters: A Survey of Robust State Estimation and Information Fusion Techniques"
    metadata { fonction 'perception-fusion'; robustesse_lien 'elevee'; maturite 'mature-local / median multi-agents'; evidence 'MEDIUM' }
    description 'EKF/UKF local par plateforme (socle safety) + fusion de pistes au niveau Edge. Fusion multi-agents a 30 = non etablie.'
  }

  // B.2 — navigation sous GNSS degrade
  AlgorithmsNavigationGNSSDegradeEKFVIO = algorithm 'Navigation GNSS degrade (EKF + bascule VIO)' {
    link https://doi.org/10.3390/drones10010049 "DTVIRM-Swarm: A Distributed and Tightly Integrated Visual-Inertial-UWB-Magnetic System for Anchor Free Swarm Cooperative Localization"
    metadata { fonction 'navigation-GNSS-degrade'; robustesse_lien 'elevee'; maturite 'mature'; evidence 'MEDIUM' }
    description 'Defaut EKF IMU+odom+GNSS ; bascule VIO en GNSS-denied ; reduction de zone + RTL sur seuil de derive.'
  }

  // B.3 — allocation de taches
  AlgorithmsTaskAllocationCBBA = algorithm 'Allocation par encheres (CBBA)' {
    link https://doi.org/10.1109/tro.2009.2022423 "Consensus-Based Decentralized Auctions for Robust Task Allocation"
    metadata { fonction 'allocation-taches'; robustesse_lien 'elevee'; maturite 'mature-en-labo'; evidence 'HIGH-existence_LOW-perf' }
    description 'Mature en laboratoire. Convergence sous partition et retrait d agent a 30 = non mesurees.'
  }

  // B.4 — coordination sous partition (CRDT / LWW)
  AlgorithmsCoordinationCRDTLWW = algorithm 'Coordination sous partition (CRDT / LWW + horloges logiques)' {
    link https://arxiv.org/abs/2508.00622 "SwarmRaft: Leveraging Consensus for Robust Drone Swarm Coordination in GNSS-Degraded Environments"
    metadata { fonction 'coordination-partition'; robustesse_lien 'elevee'; maturite 'mature'; evidence 'HIGH' }
    description 'Resolution par role (C2 > Edge > Onboard). Pas de quorum global. Reconvergence a 30 agents = MEDIUM.'
  }

  // B.5 — planification (mission / trajectoire / couverture)
  AlgorithmsPlanificationWaypointsMPC = algorithm 'Planification waypoints + MPC court horizon' {
    link https://doi.org/10.3390/drones10030177 "Safe Swarm Navigation in Constrained Environments: A Dynamic Tube-Based Distributed MPC Approach"
    metadata { fonction 'planification'; robustesse_lien 'moyenne'; maturite 'mature'; evidence 'MEDIUM' }
    description 'Plan embarque versionne par defaut ; MPC court-horizon au niveau Edge si ressource ; re-optimisation C2 differee.'
  }

  // B.6 — evitement de collision / deconfliction spatiale
  AlgorithmsEvitementCollisionCBF = algorithm 'Evitement de collision (Control Barrier Functions)' {
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    metadata { fonction 'evitement-collision'; robustesse_lien 'elevee'; maturite 'emergente'; evidence 'MEDIUM' }
    description 'Couche surete embarquee non negociable, independante du lien et de l allocation. Preuve a 30 agents non etablie.'
  }

  // B.7 — surete (garanties et comportement degrade)
  AlgorithmsSureteReglesCBF = algorithm 'Surete embarquee (regles pre-approuvees + CBF)' {
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    metadata { fonction 'surete'; robustesse_lien 'elevee'; maturite 'mature'; evidence 'MEDIUM' }
    description 'Regles/reflexes embarques HIGH + watchdog independant ; CBF en renfort. Validation Monte-Carlo adversarial (N>=1000) NON faite.'
  }

  // ===========================================================================
  // LOT 3 — RISQUES (§D) ET ANGLES MORTS (§C)
  // Source : swarm30_annexe_v1.md §C (16 angles morts) et §D (15 risques).
  // Distinction : un RISQUE est un evenement redoute (P x I) ; un ANGLE MORT
  // est un trou de specification reconnu (pas encore un evenement).
  // Conventions LikeC4 respectees : ID sans point, metadata simple, PAS de tag
  // inline dans le corps (cause d'echec de validation constatee).
  // ===========================================================================

  // --- Risques (§D) -----------------------------------------------------------

  riskR1 = risk 'R-1 Contention radio a 30 agents' {
    metadata { categorie 'technique'; probabilite 'elevee'; impact 'eleve'; criticite 'critique'; mitigation 'Budget radio modelise; QoS par criticite; delta-compression; repli autonome.'; alerte 'Perte messages critiques > 1 pct; latence p95 hors budget.' }
  }

  riskR2 = risk 'R-2 Prise de controle via lien non authentifie' {
    metadata { categorie 'securite'; probabilite 'moyenne'; impact 'eleve'; criticite 'critique'; mitigation 'mTLS/DDS-Security; signature ordres critiques; PKI + rotation; red-team.'; alerte 'Ordres non signes; echecs d authentification.' }
  }

  riskR3 = risk 'R-3 Validation reelle a 30 agents non realisable' {
    metadata { categorie 'programme'; probabilite 'elevee'; impact 'eleve'; criticite 'critique'; mitigation 'Plafonner l echelle reelle; pousser SIL/HIL/digital twin; declarer ce qui est prouve par modalite.'; alerte 'Glissement calendrier; refus BVLOS.' }
  }

  riskR4 = risk 'R-4 Perte de coherence sous partition (split-brain)' {
    metadata { categorie 'technique'; probabilite 'moyenne'; impact 'eleve'; criticite 'critique'; mitigation 'CRDT/LWW + resolution par role; pas de quorum global; lease expiry; tests multi-partitions.'; alerte 'Divergence de versions; reconvergence > T_reconv.' }
  }

  riskR5 = risk 'R-5 Derive en GNSS-degrade' {
    metadata { categorie 'technique-science'; probabilite 'moyenne'; impact 'eleve'; criticite 'critique'; mitigation 'EKF + bascule VIO; reduction de zone; RTL sur seuil de derive.'; alerte 'Croissance incertitude position; RTL multiples.' }
  }

  riskR6 = risk 'R-6 Non-conformite reglementaire (BVLOS, COLREGs)' {
    metadata { categorie 'reglementaire'; probabilite 'moyenne'; impact 'eleve'; criticite 'elevee'; mitigation 'Cartographie reglementaire par domaine; regles d evitement maritimes en conception; dossier d autorisation precoce.'; alerte 'Nouvelles exigences autorite; refus de zone.' }
  }

  riskR7 = risk 'R-7 Conflit de licence bloquant la distribution' {
    metadata { categorie 'programme'; probabilite 'moyenne'; impact 'moyen'; criticite 'moyenne'; mitigation 'Decision ecrite du socle; revue juridique AGPL; alternatives permissives.'; alerte 'Obligation d ouverture non anticipee.' }
  }

  riskR8 = risk 'R-8 Fusion degradee en scenario dense (fausses pistes)' {
    metadata { categorie 'science'; probabilite 'moyenne'; impact 'moyen'; criticite 'moyenne'; mitigation 'Metriques P_d/P_fa cibles; fusion Edge avec covariance; tests denses a 30 agents.'; alerte 'Taux fausses pistes hors cible; latence fusion hors budget.' }
  }

  riskR9 = risk 'R-9 Collision en scenario d urgence' {
    metadata { categorie 'operationnel'; probabilite 'faible-moyenne'; impact 'eleve'; criticite 'elevee'; mitigation 'Couche surete embarquee (CBF/geometrie) independante du lien; zone d exclusion agent defaillant; Monte-Carlo adversarial.'; alerte 'Violations espace > 1 pct des pas; minima locaux d evitement.' }
  }

  riskR10 = risk 'R-10 Desynchronisation d horloge (donnees perimees)' {
    metadata { categorie 'technique'; probabilite 'moyenne'; impact 'moyen'; criticite 'moyenne'; mitigation 'Source de temps specifiee; garde-fous en perte GNSS; tests de derive.'; alerte 'Ecart horloge inter-plateformes > seuil.' }
  }

  riskR11 = risk 'R-11 Fidelite du jumeau numerique insuffisante' {
    metadata { categorie 'science'; probabilite 'moyenne'; impact 'moyen'; criticite 'elevee'; mitigation 'Metriques de fidelite sim-reel; recalibration; verification croisee.'; alerte 'Ecart trajectoire/energie/timing > seuil.' }
  }

  riskR12 = risk 'R-12 Taches orphelines par non-prise en compte de l energie' {
    metadata { categorie 'operationnel'; probabilite 'moyenne'; impact 'moyen'; criticite 'moyenne'; mitigation 'Cout d enchere pondere energie; seuils de repli; suivi energie par plateforme.'; alerte 'RTL en serie; taux taches non terminees.' }
  }

  riskR13 = risk 'R-13 Effort de R&D sous-estime sur la fusion multi-agents' {
    metadata { categorie 'programme-science'; probabilite 'elevee'; impact 'moyen'; criticite 'elevee'; mitigation 'Decouper la brique; metriques et donnees de test precoces; phase d integration dediee.'; alerte 'Derive du planning sur edge.fusion.' }
  }

  riskR14 = risk 'R-14 Charge C2 humaine excessive sous incertitude' {
    metadata { categorie 'operationnel'; probabilite 'moyenne'; impact 'moyen'; criticite 'moyenne'; mitigation 'Automatiser les bascules pre-approuvees; escalades graduees; mesures de charge.'; alerte 'Temps de decision croissant; escalades en rafale.' }
  }

  riskR15 = risk 'R-15 Handoff inter-domaines ambigu' {
    metadata { categorie 'technique-operationnel'; probabilite 'moyenne'; impact 'faible-moyen'; criticite 'moyenne'; mitigation 'Protocole lease + acquittement; tests de handoff; journalisation.'; alerte 'Taches executees deux fois; taches abandonnees sans trace.' }
  }

  // --- Angles morts (§C) ------------------------------------------------------

  blindspotAM1 = blindspot 'AM-1 Arbitrage de licence non tranche (BSD-3 vs GPLv3)' {
    metadata { gravite 'critique'; statut 'couvrir'; consequence 'Refonte couteuse si le socle est choisi sans decision juridique prealable.' }
  }

  blindspotAM2 = blindspot 'AM-2 Exposition AGPLv3 dans le Cloud' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Obligation de publier des modifications; blocage d un modele SaaS.' }
  }

  blindspotAM3 = blindspot 'AM-3 Budget radio a 30 agents non dimensionne' {
    metadata { gravite 'critique'; statut 'couvrir'; consequence 'Saturation; perte de messages de surete; degradation en cascade.' }
  }

  blindspotAM4 = blindspot 'AM-4 Perception d essaim sans brique ni metrique' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Sous-estimation de l effort; qualite de l image tactique non mesurable.' }
  }

  blindspotAM5 = blindspot 'AM-5 Validation d echelle 2-5-12-30 irrealiste en reel' {
    metadata { gravite 'critique'; statut 'couvrir+accepter'; consequence 'Critere d acceptation a 30 agents risque de n etre jamais mesure en reel.' }
  }

  blindspotAM6 = blindspot 'AM-6 Desynchronisation d horloge non specifiee' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Fusion incoherente; versions LWW mal resolues; regressions silencieuses.' }
  }

  blindspotAM7 = blindspot 'AM-7 Cybersecurite du lien montant et de l autopilote' {
    metadata { gravite 'critique'; statut 'couvrir'; consequence 'Prise de controle; injection d ordres; deni de service provoquant des chutes.' }
  }

  blindspotAM8 = blindspot 'AM-8 Cadre reglementaire BVLOS et COLREGs' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Impossibilite legale d exploiter; refonte des comportements d evitement.' }
  }

  blindspotAM9 = blindspot 'AM-9 Gestion energetique heterogene non globale' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Taches orphelines; RTL en serie; mission non completee.' }
  }

  blindspotAM10 = blindspot 'AM-10 Handover inter-domaines mal defini (UAV-USV)' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Double execution d une tache, ou abandon silencieux.' }
  }

  blindspotAM11 = blindspot 'AM-11 Ontologie commune non specifiee' {
    metadata { gravite 'mineur'; statut 'surveiller'; consequence 'Integrations ad hoc; dette technique; jumeau numerique divergent.' }
  }

  blindspotAM12 = blindspot 'AM-12 Comportement en cas d agent defaillant non traite' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Collision avec l agent defaillant; tache perdue; faux positif de partition.' }
  }

  blindspotAM13 = blindspot 'AM-13 Observabilite et rejeu non contractuels' {
    metadata { gravite 'mineur'; statut 'couvrir'; consequence 'Rejeu non deterministe; incident non reproductible.' }
  }

  blindspotAM14 = blindspot 'AM-14 Bruit et fausses detections non quantifies' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Criteres d acceptation non testables.' }
  }

  blindspotAM15 = blindspot 'AM-15 Fidelite du jumeau numerique non proceduree' {
    metadata { gravite 'majeur'; statut 'couvrir'; consequence 'Criteres valides en simulation qui echouent au reel.' }
  }

  blindspotAM16 = blindspot 'AM-16 Facteur humain et charge du C2' {
    metadata { gravite 'mineur'; statut 'surveiller'; consequence 'Goulot humain sous situation incertaine; decisions tardives.' }
  }

  // ===========================================================================
  // LOT 3 — RELATIONS DE TRACABILITE (§E.2)
  // Relient l'architecture logique (composants) aux briques, algorithmes,
  // risques et angles morts. C'est ce qui rend le modele requetable et ce qui
  // fait apparaitre les nouveaux elements dans les vues.
  // IDs camelCase conformes au mapping (onboard.sensorsHAL, onboard.linkRadio,
  // onboard.taskAuction, cloud.replayStore, cloud.modelRegistry).
  // ===========================================================================

  // --- Composants implementes par des logiciels du marche ---------------------
  onboard.autopilot -[implements]-> AutopilotPX4 'implemente par (primaire)'
  onboard.autopilot -[implemented-by]-> ArduPilot 'alternative (secondaire)'
  onboard.mission -[implemented-by]-> AutopilotPX4 'plan embarque'
  onboard.safety -[safety]-> AutopilotPX4 'geofence, RTL'
  onboard.perception -[implemented-by]-> ROS2 'composition'
  onboard.perception -[implemented-by]-> GazeboSim 'valide en simulation'
  onboard.sensorsHAL -[implemented-by]-> MicroXRCEDDS 'pont MCU <-> DDS'
  onboard.sensorsHAL -[implemented-by]-> MAVLinkMAVSDK 'alternative MAVLink'
  onboard.linkRadio -[radio]-> Zenoh 'relais mesh decentralise'
  onboard.linkRadio -[radio]-> MosquittoMQTT 'mode store-and-forward degrade'
  edge.fusion -[implemented-by]-> ROS2 'fusion de pistes'
  edge.gateway -[implemented-by]-> Zenoh 'passerelle amont/aval'
  edge.relay -[implemented-by]-> Zenoh 'relais'
  c2.gcs -[implemented-by]-> QGroundControl 'supervision et planification'
  c2.planner -[implemented-by]-> QGroundControl 'planification de mission'
  onboard.energy -[implemented-by]-> MinIO 'historisation telemetrie'
  cloud.twin -[implemented-by]-> GazeboSim 'jumeau numerique'
  cloud.replayStore -[store]-> MinIO 'stockage objet S3'
  cloud.replayStore -[store]-> GazeboSim 'rejeu sur jumeau'
  cloud.analytics -[implemented-by]-> Prometheus 'metriques'
  cloud.analytics -[implemented-by]-> Grafana 'tableaux de bord'
  cloud.analytics -[implemented-by]-> PostgreSQLPostGIS 'registre de missions et geometrie'
  onboard.mission -[implemented-by]-> OpenCPN 'navigation marine des USV'

  // --- Composants s'appuyant sur des familles algorithmiques -------------------
  onboard.perception -[implements]-> AlgorithmsPerceptionFusionEKFUKF 's appuie sur'
  onboard.perception -[implements]-> AlgorithmsNavigationGNSSDegradeEKFVIO 'navigation degradée'
  edge.fusion -[implements]-> AlgorithmsPerceptionFusionEKFUKF 's appuie sur'
  onboard.taskAuction -[implements]-> AlgorithmsTaskAllocationCBBA 's appuie sur'
  onboard.taskAuction -[implements]-> AlgorithmsCoordinationCRDTLWW 'coordination sous partition'
  edge.coordinator -[implements]-> AlgorithmsCoordinationCRDTLWW 's appuie sur'
  c2.planner -[implements]-> AlgorithmsPlanificationWaypointsMPC 's appuie sur'
  onboard.mission -[implements]-> AlgorithmsPlanificationWaypointsMPC 'plan embarque'
  onboard.safety -[implements]-> AlgorithmsEvitementCollisionCBF 'separation de proximite'
  onboard.safety -[implements]-> AlgorithmsSureteReglesCBF 'regles pre-approuvees'

  // --- Briques logicielles exposees a des risques -----------------------------
  AutopilotPX4 -[exposed-to]-> riskR5 'expose a'
  MinIO -[exposed-to]-> riskR7 'expose a (AGPL)'
  Grafana -[exposed-to]-> riskR7 'expose a (AGPL)'
  Zenoh -[exposed-to]-> riskR1 'expose a la contention radio'
  MosquittoMQTT -[exposed-to]-> riskR1 'expose a'
  QGroundControl -[exposed-to]-> riskR14 'expose a la charge C2'
  ROS2 -[exposed-to]-> riskR8 'expose aux fausses pistes'

  // --- Familles algorithmiques vs angles morts (ce qui n'est PAS couvert) -----
  AlgorithmsPerceptionFusionEKFUKF -[exposed-to]-> blindspotAM4 'ne couvre pas la fusion essaim'
  AlgorithmsTaskAllocationCBBA -[exposed-to]-> blindspotAM9 'ne couvre pas l energie'
  AlgorithmsTaskAllocationCBBA -[exposed-to]-> blindspotAM10 'ne couvre pas le handoff'
  AlgorithmsCoordinationCRDTLWW -[exposed-to]-> blindspotAM6 'ne couvre pas l horloge'
  AlgorithmsSureteReglesCBF -[exposed-to]-> blindspotAM5 'validation d echelle non couverte'
  AlgorithmsCoordinationCRDTLWW -[exposed-to]-> blindspotAM12 'agent defaillant non couvert'
  AlgorithmsPerceptionFusionEKFUKF -[exposed-to]-> blindspotAM14 'P_d/P_fa non quantifies'

  // ---------------------------------------------------------------------------
  // E25 — ENRICHISSEMENT DES ALGORITHMES PAUVRES (carte t_97fefb21)
  // Uniquement ADDITIF : aucune relation ni vue existante modifiee.
  // Convention E25 : alg -[uses]-> scenario = l algorithme est EXERCE par ce scenario.
  // Sens de `evidences` conforme au metamodele : constat -[evidences]-> algorithme.
  // ---------------------------------------------------------------------------

  // B.2 — navigation GNSS degradee
  AlgorithmsNavigationGNSSDegradeEKFVIO -[uses]-> msgPositionUpdate 'mesure de position consommee par EKF/VIO'
  AlgorithmsNavigationGNSSDegradeEKFVIO -[uses]-> scn05 'bascule VIO en GNSS degrade'
  sciGnssDegraded -[evidences]-> AlgorithmsNavigationGNSSDegradeEKFVIO 'famille sourcee (SCI-5)'

  // B.5 — planification waypoints + MPC
  AlgorithmsPlanificationWaypointsMPC -[uses]-> msgTrajectoryProposal 'negociation de trajectoire'
  AlgorithmsPlanificationWaypointsMPC -[uses]-> scn01 'plan embarque sans C2'

  // B.6 — evitement de collision (CBF)
  AlgorithmsEvitementCollisionCBF -[uses]-> msgCollisionAlert 'declencheur sense-and-avoid'
  AlgorithmsEvitementCollisionCBF -[uses]-> scn06 'evitement de collision'
  AlgorithmsEvitementCollisionCBF -[exposed-to]-> blindspotAM5 'preuve a 30 agents non etablie (SCI-2)'
  sciCbf -[evidences]-> AlgorithmsEvitementCollisionCBF 'verdict CBF (SCI-2)'

  // B.7 — surete embarquee (regles + CBF)
  AlgorithmsSureteReglesCBF -[uses]-> msgCollisionAlert 'declencheur de la voie de surete'
  AlgorithmsSureteReglesCBF -[uses]-> scn02 'surete autonome sans lien'
  sciCbf -[evidences]-> AlgorithmsSureteReglesCBF 'CBF en renfort (SCI-2)'


