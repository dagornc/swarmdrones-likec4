// === E27 — CORRECTION DES VUES ALGORITHMIQUES ===
/**
 * =============================================================================
 *  SwarmDrones — VUES (projections du modele unique defini dans architecture.c4)
 *
 *  Navigation :  INDEX -> CONTENEURS -> CONTEXTE -> ZONES -> DYNAMIQUES
 *  (cf. ADR-001 : une vue = une question = un public).
 *
 *  NIVEAUX C4 :
 *    N1 Contexte   -> `contexte` / `contexte-amont` / `contexte-aval`
 *    N2 Conteneurs -> `conteneurs` (les 4 zones + externes + echanges)
 *    N3 Composants -> `zone-onboard` / `zone-edge` / `zone-c2` / `zone-cloud`
 *    N4 Code       -> non couvert (optionnel, genere depuis le code)
 *
 *  LEGENDE DE COULEURS (styleGroup "criticite") :
 *    ROUGE  Safety-Critical   (securite du vol / navigation)
 *    AMBRE  Mission-Critical  (continuite de mission)
 *    GRIS   Best-Effort       (degradable, jamais bloquant)
 *    CYAN   Cloud             (hors boucle de controle)
 *  Frontieres : Onboard (bleu), Edge (orange), C2 (indigo), Cloud (cyan).
 *
 *  NOTE TECHNIQUE : les vues dynamiques sont rendues en variante "diagram" par
 *  defaut ; la variante "sequence" se selectionne dans l'UI (panneau de vue)
 *  ou via l'attribut de rendu, elle n'est pas declaree dans le DSL en 1.59.x.
 * =============================================================================
 */

global {
  styleGroup lectureZones {
    style onboard, onboard.** { color zoneOnboard; notation 'ONBOARD — couche logicielle' }
    style edge, edge.** { color zoneEdge; notation 'EDGE — couche logicielle' }
    style c2, c2.** { color zoneC2; notation 'C2 — couche logicielle' }
    style cloud, cloud.** { color zoneCloud; notation 'CLOUD — couche logicielle' }
  }


  /**
   * StyleGroup de criticite : peint les elements selon leur tag de criticite
   * et fournit la LEGENDE native LikeC4 via `notation`.
   */
  styleGroup criticite {
    style element.tag = #safety-critical {
      color criticalRed
      notation 'Safety-Critical — securite du vol / navigation'
    }
    style element.tag = #mission-critical {
      color warningAmber
      notation 'Mission-Critical — continuite de mission'
    }
    style element.tag = #best-effort {
      color effortGray
      notation 'Best-Effort — degradable, jamais bloquant'
    }
    style element.tag = #cloudOnly {
      color cloudCyan
      notation 'Cloud — hors boucle de controle'
    }
  }

  /** StyleGroup : attenue les zones hors examen (scenario degrade). */
  styleGroup attenue {
    style element.tag = #cloudOnly {
      color muted
      opacity 30%
    }
    style element.tag = #best-effort {
      color muted
      opacity 60%
    }
  }

  /** StyleGroup : lecture des zones (frontieres). */
  styleGroup zones {
    style radios {
      color extBrown
      notation 'Externe — capteurs, GNSS, radios'
    }
  }
}

views {

  // ===========================================================================
  // NIVEAU 0 — INDEX / PAYSAGE : porte d'entree de la navigation
  // Public : tout le monde. Question : "quelles zones, qui parle a qui ?"
  // ===========================================================================
  view index {
    title '05 - Physique & Déploiement (Infrastructure) \/ SwarmDrones — Paysage des zones de deploiement'

    description '''
      **Commencer ici : comprendre → explorer → suivre un flux → examiner les garanties.**

      Quatre couches logicielles + opérateur + interfaces physiques. Cliquer une couche pour ouvrir son détail.

      **Parcours guidés :** [1. Capteur → action](/view/apprendre-capteur/) · [2. Intention → mission](/view/apprendre-mission/) · [3. Télémétrie → analyse](/view/apprendre-telemetrie/)

      **Questions transverses :** [Sûreté](/view/lecture-surete/) · [Autorisation humaine](/view/lecture-autorisation/) · [Sans liaison C2](/view/lecture-autonomie/)

      **Bibliothèque :** [Décisions](/view/decisions/) · [Hypothèses](/view/hypotheses/) · [Décisions ouvertes](/view/decisionsOuvertes/)

      **Légende :** couleur = couche dans les vues de découverte ; rouge/ambre = criticité uniquement dans les vues dédiées. Un rouge ne signifie pas une panne. Trait plein = données ou sûreté, tirets = commande ou radio, pointillés = différé ou persistance : lire aussi le libellé et la technologie.

      **Niveau de preuve :** VALIDE est un statut du modèle, pas une certification ; EXTRAP est une estimation ; A-VALIDER reste une hypothèse. Aucun état temps réel ni taux mesuré ne se déduit de ce diagramme.

      **Principe directeur : le contrat de mission est embarque ;
      le lien est un bonus, pas une dependance.**
      La zone Onboard (x30) doit terminer sa mission nominale sans C2 ni cloud.

      Les fleches montantes sont toutes intermittentes. Le cloud est
      strictement hors boucle de controle.

      Poursuivre vers : `contexte`, puis `zone-onboard`, `zone-edge`,
      `zone-c2`, `zone-cloud`, puis les vues dynamiques `mission-nominale`
      et `perte-de-lien`.
    '''
    // Paysage volontairement minimal (contrat de la vue) : uniquement les
    // zones et les externes. On liste explicitement pour ne pas etre pollue
    // par les relations de tracabilite (derives-from) que `include *` tirerait.
    include operator, radios
    include onboard with { navigateTo zone-onboard }
    include edge with { navigateTo zone-edge }
    include c2 with { navigateTo zone-c2 }
    include cloud with { navigateTo zone-cloud }
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  // (La vue payload `index` reste volontairement minimale : 6 noeuds max,
  //  elle sert de carte d'entree. La navigation se fait via l'UI.)

  // ===========================================================================
  // NIVEAU 1 — CONTEXTE (scinde amont/aval pour la lisibilite statique)
  // Public : architectes, system engineering. Question : "si le lien tombe,
  // qu'est-ce qui casse ?"
  // ===========================================================================

  /** CONTEXTE AMONT — la ou vit la surete : externes + onboard + edge.
   *  Frontiere haute : `edge.gateway` (passerelle de confiance).
   *  Tout ce qui doit fonctionner SANS lien est ici. */
  view contexte-amont {
    title '99 - Vues complémentaires \/ Contexte amont — externes, Onboard (x30), Edge (1..N)'

    description '''
      **Perimetre : tout ce qui doit fonctionner SANS lien C2.**
      C'est la zone de surete et de mission embarquee.

      Frontiere basse = `edge.gateway` : au-dela, on entre dans le domaine
      supervise (contexte-aval).

      A retenir : aucun element de cette vue ne depend du C2 ou du cloud
      pour terminer une mission nominale. Cliquer `onboard` / `edge` ouvre
      la vue de zone correspondante.
    '''
    include radios, operator
    include onboard.** with {
      navigateTo zone-onboard
    }
    include edge.** with {
      navigateTo zone-edge
    }
    global style lectureZones
    global style zones
    autoLayout TopBottom
  }

  /** CONTEXTE AVAL — supervision, planification, cloud (hors boucle).
   *  Tout est atteint de facon INTERMITTENTE et non bloquante. */
  view contexte-aval {
    title '99 - Vues complémentaires \/ Contexte aval — Edge gateway, C2, Cloud (hors boucle de controle)'

    description '''
      **Perimetre : tout ce qui est atteint de facon intermittente.**
      Aucune responsabilite de surete n'est deleguee ici.

      A retenir : le retour `cloud.modelRegistry -> c2.planner` est
      explicitement non bloquant. Une indisponibilite C2 ou cloud ne doit
      jamais empecher l'essaim de terminer sa mission.

      Cliquer `c2` ou `cloud` ouvre la vue de zone correspondante.
    '''
    include edge.gateway
    include c2.** with {
      navigateTo zone-c2
    }
    include cloud.** with {
      navigateTo zone-cloud
    }
    include onboard.linkRadio
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  /** CONTEXTE (synthèse) — vue d'ensemble compacte, une ligne par zone.
   *  Pour la navigation ; le detail est dans contexte-amont/aval. */
  view contexte {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Contexte (synthese) — vue d\\\'ensemble des zones'

    description '''
      Synthese volontairement compacte : une ligne par zone, deux externes.

      Vue de NAVIGATION : cliquer une zone ouvre son detail.
      Pour l'analyse des dependances, preferer `contexte-amont`
      (surete/mission) et `contexte-aval` (supervision/cloud).
    '''
    include radios, operator
    include onboard with { navigateTo contexte-amont }
    include edge with { navigateTo contexte-amont }
    include c2 with { navigateTo contexte-aval }
    include cloud with { navigateTo contexte-aval }
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  // ===========================================================================
  // NIVEAU 2 — CONTENEURS (les 4 zones = conteneurs du niveau 2 C4)
  // Public : architectes, system engineering, integration.
  // Question : "quels conteneurs executables, et comment communiquent-ils ?"
  //
  // DECLARATION DE GRANULARITE : les 4 zones (onboard/edge/c2/cloud) SONT les
  // conteneurs du niveau 2 C4. Les composants (onboard.*, edge.*, ...) sont le
  // niveau 3, vus dans les vues de zone. Cette vue ne montre QUE les conteneurs
  // + les externes et leurs relations INTER-conteneurs (agregees par LikeC4
  // depuis les relations de composants du modele unique).
  // ===========================================================================

  /** CONTENEURS — les 4 zones et leurs echanges, sans le detail des composants.
   *  Public : architectes, system engineering, integration.
   *  Question : "quels conteneurs executables, et comment communiquent-ils ?" */
  view conteneurs {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Conteneurs (niveau 2) — les 4 zones et leurs echanges'

    description '''
      **Niveau 2 du modele C4.** Les 4 zones sont les conteneurs executables ;
      les composants (niveau 3) sont visibles dans les vues de zone.

      **Regles de lecture (criticite des flux) :**
      - `radios -> onboard` : voie de surete (safety-critical), jamais bloquee.
      - `onboard <-> edge` : radio intermittente (H2), lien = bonus.
      - `edge <-> c2` : MQTT, intermittente, ordres signes + authorization_ref.
      - `edge -> cloud` : differe (minutes), hors boucle de controle.
      - `cloud -> c2` : retour modeles NON bloquant.
      - `operator -> c2` : autorite humaine (H5).

      **Invariant :** aucun conteneur ne depend d'un autre pour terminer une
      mission nominale. Le cloud est strictement hors boucle de controle.

      Cliquer une zone ouvre sa vue de composants (niveau 3).
    '''
    include radios, operator
    include onboard with { navigateTo zone-onboard }
    include edge with { navigateTo zone-edge }
    include c2 with { navigateTo zone-c2 }
    include cloud with { navigateTo zone-cloud }
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  // ===========================================================================
  // NIVEAU 1bis — PAYSAGE PAR CRITICITE (lecture transversale / priorisation)
  // Public : direction technique, safety, priorisation de l'effort.
  // Question : "qu'est-ce qui est safety, mission, best-effort ?"
  // ===========================================================================
  view paysage-criticite {
    title '99 - Vues complémentaires \/ Paysage par criticite — safety \\\/ mission \\\/ best-effort \\\/ cloud'

    description '''
      Vue transversale de **priorisation** : on montre les composants
      safety-critical (rouge) et mission-critical (ambre) — le coeur a
      proteger — avec leurs dependances. Les best-effort (gris) et cloud
      (cyan) n'apparaissent que s'ils sont relies a ces composants.

      Regle de lecture : **un composant safety ne peut dependre que de
      composants safety.** Toute arete rouge -> non-rouge est un defaut
      d'architecture a justifier.

      Variante exhaustive (tous les composants) : remplacer les deux
      `include` par `include element.kind = component`.
    '''
    include element.tag = #safety-critical
    include element.tag = #mission-critical
    global style criticite
    autoLayout LeftRight
  }

  // ===========================================================================
  // NIVEAU 2 — VUES PAR ZONE (une vue = un perimetre de responsabilite)
  // ===========================================================================

  /** ONBOARD (x30) — tout le safety y est visible.
   *  Public : equipe logiciel embarque, safety, navigabilite. */
  view zone-onboard {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Détail des Zones (Contexte amont \\\/ aval) \/ Zone Onboard (x30) — surete, mission et lien'

    description '''
      Machine a etats de mission, allocation, garde-fous.

      **A verifier :**
      - `onboard.safety` est alimente par perception, health, energy et la
        voie de commande radios -> safety : il reste actif sans lien.
      - `onboard.safety` commande `onboard.autopilot` en preemptif : la voie
        de surete est terminale, elle ne depend de personne.
      - `EXECUTE` est porte par `onboard.mission` (contrat embarque).

      Etats : INIT -> READY -> LAUNCH -> EXECUTE
      -> (DEGRADED <=> EXECUTE) -> RTL/RECOVER -> LAND -> DONE ; ABORT partout.
    '''
    include onboard.**
    include radios
    global style lectureZones
    global style zones
    autoLayout TopBottom
  }

  /** EDGE — ce qui exige une vue multi-agents a portee locale.
   *  Public : equipe coordination / fusion, exploitation de proximite. */
  view zone-edge {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Détail des Zones (Contexte amont \\\/ aval) \/ Zone Edge — relais, fusion, coordination (1..N)'

    description '''
      Point cle : **`edge.coordinator` fonctionne en mode C2-deconnecte.**
      Quand le lien C2 tombe, il assure l'allocation locale et `edge.cache`
      conserve mission, logs et artefacts.

      `edge.gateway` est la frontiere de confiance unique : normalisation de
      protocoles et controle d'acces essaim <-> C2 <-> cloud.
    '''
    include edge.**
    include onboard.linkRadio
    include c2.gcs
    include cloud.twin
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  /** C2 — supervision, (re)planification, autorite humaine.
   *  Public : operateurs, autorite humaine, audit / conformite. */
  view zone-c2 {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ GCS — supervision et autorite humaine'

    description '''
      Le C2 est atteint **intermittentement** : aucune responsabilite de
      surete n'y est deleguee.

      **Tracabilite :** `c2.auth` emet les jetons d'autorisation vers
      `c2.gcs` et ecrit les traces d'audit dans `c2.missionStore`.
      Exigence : 100 % des ordres critiques signes, chaque decision critique
      porte un `authorization_ref`, zero perte non journalisee.
    '''
    include c2.**
    include operator
    include edge.gateway
    include cloud.modelRegistry
    global style lectureZones
    global style zones
    autoLayout TopBottom
  }

  /** CLOUD — hors boucle de controle.
   *  Public : data / simulation, validation, direction technique. */
  view zone-cloud {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Détail des Zones (Contexte amont \\\/ aval) \/ Zone Cloud — hors boucle de controle'

    description '''
      Budget : minutes (differe). **Aucune dependance bloquante admise
      depuis Onboard ou Edge vers cette zone.**

      Le retour `cloud.modelRegistry -> c2.planner` est explicitement non
      bloquant : une indisponibilite cloud ne doit jamais retarder une
      (re)planification.
    '''
    include cloud.**
    include edge.gateway
    include c2.planner
    global style lectureZones
    global style zones
    autoLayout LeftRight
  }

  /** DEPLOIEMENT — materialisation du x30 et du 1..N.
   *  Public : integration, logistique, exploitation, planification. */
  deployment view deploiement-30-plateformes {
    title '05 - Physique & Déploiement (Infrastructure) \/ Deploiement — 30 plateformes, N stations Edge, 1 C2, 1 cloud'

    description '''
      Materialise le caractere "x30" de la zone Onboard (18 UAV-R, 8 UAV-F,
      4 USV) et le caractere "1..N" des stations Edge.

      Les relations sont heritees du modele logique : aucune fleche n'est
      redefinie ici.
    '''
    include *
      where kind is not hypothesis and kind is not decision
    // Constat : 41 noeuds sans relations internes -> layout FORCEMENT lineaire.
    // TopBottom/dagre = 84 690 px de large ; LeftRight = 44 544 px de haut.
    // Aucune orientation ne rend cette vue lisible en PNG statique.
    // DECISION : cette vue est destinee a l'UI INTERACTIVE (zoom/pan), pas a
    // l'export statique. Pour une lecture statique de l'heterogeneite, voir
    // la description ci-dessous (18/8/4) et la vue `paysage-criticite`.
    autoLayout TopBottom
  }

  // ===========================================================================
  // NIVEAU 3 — VUES DYNAMIQUES (validation, test SIL/HIL, revue)
  // ===========================================================================

  /** Sequence nominale de mission : INIT -> ... -> DONE.
   *  A lire en variante "sequence" dans l'UI pour l'ordre temporel UML. */
  dynamic view mission-nominale {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ Séquence nominale — INIT -> READY -> LAUNCH -> EXECUTE'

    description '''
      Sequence nominale, **sans aucun lien C2** pendant la majorite de la
      duree : c'est le critere d'acceptation majeur (§9.2, >= 80 % du temps
      simule en autonomie).

      A observer : le C2 n'apparait qu'en amont (plan) et en aval (telemetrie
      differee). Aucune etape de surete ne depend d'une reponse du C2.
    '''

    radios -> onboard.sensorsHAL 'GNSS / INS / capteurs disponibles'
    onboard.sensorsHAL -> onboard.autopilot 'etat navigation initialise'
    onboard.sensorsHAL -> onboard.health 'sante capteurs (INIT checks)'
    onboard.health -> onboard.safety 'niveaux de sante : OK'

    operator -> c2.gcs 'valide la mission (autorite humaine)'
    c2.gcs -> c2.auth 'demande jeton autorisation'
    c2.auth -> c2.gcs 'jeton + authorization_ref'
    c2.gcs -> c2.planner 'intentions operateur'
    c2.planner -> c2.missionStore 'plan versionne (plan_version v1)'
    c2.planner -> edge.gateway 'plan embarque signe (voie opportuniste)'
    edge.gateway -> onboard.linkRadio 'diffusion du plan vers l essaim'
    onboard.linkRadio -> onboard.mission 'contrat de mission verifie (signature)'

    onboard.mission -> onboard.autopilot 'READY -> LAUNCH : consignes de decollage'
    onboard.perception -> onboard.autopilot 'estimation position/etat continue'
    onboard.perception -> onboard.safety 'surveillance evitement'

    loop 'EXECUTE — boucle de mission embarquee, sans lien C2 requis' {
      onboard.mission -> onboard.autopilot 'setpoints de mission'
      onboard.mission -> onboard.taskAuction 'taches ouvertes'
      onboard.taskAuction -> onboard.mission 'attributions (encheres locales)'
      onboard.health -> onboard.energy 'etat batterie'
      onboard.energy -> onboard.mission 'marge restante / budget retour'
      onboard.mission -> onboard.telemetry 'etat de mission'
      onboard.telemetry -> onboard.linkRadio 'telemetrie priorisee (best-effort)'
      onboard.linkRadio -> edge.relay 'trafic essaim (si le lien existe)'
      edge.relay -> edge.fusion 'trafic consolide'
      edge.fusion -> edge.gateway 'image tactique'
      edge.gateway -> c2.gcs 'telemetrie / image tactique (intermittent)'
      c2.gcs -> c2.alerting 'evenements a notifier'
    }

    onboard.energy -> onboard.safety 'seuil energie atteint'
    onboard.safety -> onboard.autopilot 'RTL/RECOVER : retour base'
    onboard.mission -> onboard.autopilot 'LAND : atterrissage'
    onboard.mission -> onboard.telemetry 'DONE : rapport de fin de mission'
    onboard.telemetry -> onboard.linkRadio 'rapport final'
    onboard.linkRadio -> edge.gateway 'rapport differe'
    edge.gateway -> cloud.twin 'logs/etat differes (hors boucle)'
    cloud.twin -> cloud.analytics 'donnees de rejeu'
    cloud.replayStore -> cloud.twin 'journaux rejouables (non-regression)'
  }

  /** Scenario degrade : perte de lien C2 puis degradation GNSS.
   *  Montre la degradation gracieuse et le retour a l'etat nominal. */
  dynamic view perte-de-lien {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ Scenario degrade — perte de lien C2 + GNSS degrade'

    description '''
      Scenario combine (§7 du document d'entree). **Le systeme ne doit
      jamais exiger de consensus global dur.**

      Comportements attendus :
      - `edge.coordinator` prend l'allocation locale (mode C2-deconnecte) ;
      - `onboard.linkRadio` bascule en autonome + store-and-forward ;
      - la fusion INS/odometrie/relative compense la perte GNSS ;
      - si la derive depasse le seuil, `onboard.safety` declenche RTL
        LOCALEMENT, sans aucune autorisation C2 ;
      - a la reconnexion, convergence par version de plan (pas de
        re-synchronisation d'etat complet).
    '''

    onboard.linkRadio -> edge.relay 'telemetrie / annonces (nominal)'
    edge.relay -> edge.fusion 'trafic consolide'

    alt {
      when 'Perte du lien C2' {
        onboard.linkRadio -> onboard.mission 'bascule en mode autonome local'
        onboard.linkRadio -> onboard.telemetry 'store-and-forward : file locale'
        edge.gateway -> edge.cache 'persistance locale (mission, logs, artefacts)'
        edge.coordinator -> edge.relay 'directives d allocation locale'
        edge.relay -> onboard.linkRadio 'directives de proximite'
        onboard.linkRadio -> onboard.taskAuction 'contexte de coordination locale (LWW + role)'
      }
      else 'le lien C2 est disponible' {
        edge.gateway -> c2.gcs 'image tactique / telemetrie'
        c2.gcs -> edge.gateway 'ordres / plans'
        c2.planner -> edge.gateway 'plan versionne v(n+1)'
      }
    }

    alt {
      when 'GNSS degrade (brouille)' {
        onboard.sensorsHAL -> onboard.perception 'sources degradees'
        onboard.perception -> onboard.autopilot 'fusion INS + odometrie + relative'
        onboard.perception -> onboard.mission 'reduction de zone / portee'
        onboard.perception -> onboard.safety 'derive estimee'
        onboard.safety -> onboard.autopilot 'si derive > seuil : RTL'
      }
      else 'GNSS nominal' {
        onboard.sensorsHAL -> onboard.perception 'GNSS + INS + odometrie'
      }
    }

    onboard.mission -> onboard.autopilot 'RTL/RECOVER puis LAND (autonomie bornee)'
    onboard.mission -> onboard.telemetry 'rapport DEGRADED -> DONE'

    alt {
      when 'Reconnexion du lien' {
        edge.gateway -> c2.gcs 'etat differe rejoue'
        c2.planner -> c2.missionStore 'plans versionnes'
        c2.planner -> edge.gateway 'recadrage par plan_version (pas de consensus dur)'
        edge.gateway -> onboard.linkRadio 'plan recale'
        onboard.linkRadio -> onboard.mission 'retour EXECUTE depuis DEGRADED'
      }
      else 'le lien reste indisponible' {
        onboard.mission -> onboard.autopilot 'poursuite de la mission embarquee'
      }
    }
  }

  /** Variante de lecture : la meme panne vue du poste operateur
   *  (brief de quart et formation). */
  dynamic view perte-de-lien-c2-operateur {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ Perte de lien C2 — vue operateur (brief de quart)'

    description '''
      Meme scenario, du point de vue du poste de commandement : que voit,
      comprend et peut faire l'operateur ?

      A retenir pour la formation : **l'operateur n'a aucune action requise
      pour la surete.** Sa valeur ajoutee est la replanification opportuniste
      a la reconnexion et la validation des actions critiques.
    '''

    c2.gcs -> edge.gateway 'supervision nominale'
    edge.gateway -> c2.gcs 'telemetrie (intermittente)'

    c2.gcs -> c2.alerting 'alarme : perte de lien (severite haute)'
    c2.alerting -> c2.gcs 'notification operateur'
    c2.gcs -> operator 'affiche : essaim en autonomie, aucune action requise'
    operator -> c2.gcs 'accuse reception (ack)'

    opt 'l operateur decide d intervenir (action critique)' {
      operator -> c2.gcs 'demande d action (ex. changement de zone)'
      c2.gcs -> c2.auth 'demande jeton'
      c2.auth -> c2.gcs 'authorization_ref'
      c2.gcs -> edge.gateway 'ordre signe (voie opportuniste, si lien)'
    }

    c2.gcs -> c2.auth 'journalisation des decisions (audit)'
    c2.auth -> c2.missionStore 'traces d audit'

    edge.gateway -> c2.gcs 'a la reconnexion : etat differe rejoue'
    c2.gcs -> c2.planner 'replanification opportuniste'
    c2.planner -> c2.missionStore 'plan versionne v(n+1)'
    c2.planner -> edge.gateway 'plan recale'
    edge.gateway -> onboard.linkRadio 'diffusion'
    c2.gcs -> operator 'essaim recale — supervision nominale retablie'
  }

  // ===========================================================================
  // LOT 1 — VUES D'ENRICHISSEMENT
  // Ces vues rendent REQUETABLES les hypotheses et decisions. Elles ne sont
  // pas des vues de zone : elles n'apparaissent pas dans le parcours nominal.
  // ===========================================================================

  /** ANALYSE D'IMPACT : quels composants reposent sur chaque hypothese ?
   *  Lecture : "si Hn est fausse, qu'est-ce qui est a revoir ?"
   *  Les hypotheses sont en amont (gauche) ; les composants dependants a droite,
   *  colores par leur criticite. */
  view hypotheses {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Hypotheses et impact — si une hypothese tombe, quoi revoir'

    description '''
      **Outil d'analyse de risque.** Chaque hypothese (violet, bord pointille)
      est reliee aux elements qui s'y appuient.

      A lire en priorite : **H3 est la seule marquee `a-valider`** (niveau de
      preuve MEDIUM, probabilite locale de brouillage GNSS inconnue).
      H1, H2, H5 sont validees (evidence haute) ; H4 est MEDIUM.

      Lecture : si une hypothese est fausse, tout ce qui pointe vers elle est
      a reviser. Cliquer un composant ouvre sa zone.
    '''
    include h1, h2, h3, h4, h5
    include onboard, edge, c2, cloud, operator, radios
    include * -> h1, * -> h2, * -> h3, * -> h4, * -> h5
    global style criticite
    autoLayout LeftRight
  }

  /** DECISIONS D'ARCHITECTURE (ADR) : ce qui est arbitre et pourquoi.
   *  Les decisions (vert) justifient les elements de conception a droite. */
  view decisions {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Decisions tranchees : ADR-1..5 et ce qu\\\'elles justifient'

    description '''
      **Memoire des choix tranches.** Chaque ADR porte son contexte (conflit §10.x),
      sa decision, les **alternatives rejetees** et ses consequences.

      A lire en priorite : ADR-3 (canaux surete/securite separes) touche
      `onboard.safety` et `c2.auth` — c'est le choix structurant de la conformite
      securite.

      Les arbitrages **restant a trancher** sont dans la vue `decisionsOuvertes`.

      Detail complet : cliquer une ADR affiche sa description (Markdown).
    '''
    include adr1, adr2, adr3, adr4, adr5
    include adr1 -> *, adr2 -> *, adr3 -> *, adr4 -> *, adr5 -> *
    global style criticite
    autoLayout LeftRight
  }

  /** DECISIONS OUVERTES (DE) : les arbitrages non tranches appeles par les
   *  angles morts critiques. Aucune option n'est retenue — c'est un travail
   *  de decision a faire, avec porteur et echeance. */
  view decisionsOuvertes {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Decisions ouvertes : DE-01..04 appelees par les angles morts'

    description '''
      **Arbitrages non tranches.** Les 4 angles morts de gravite `critique`
      appellent chacun une decision qui n'a pas ete prise. Aucune option n'est
      recommandee : la fiche liste la question, les options, les criteres, la
      consequence si l'on ne tranche pas, le porteur et l'echeance.

      Lire le sens ainsi : `angle mort -> decision` = **ce trou exige un
      arbitrage** ; `decision -> risque` = **cet arbitrage conditionne le
      traitement du risque** (il ne le resout pas tant qu'il est ouvert).

      Detail complet : cliquer une decision affiche sa description (Markdown).
    '''
    include de1, de2, de3, de4
    include blindspotAM1 -> de1, blindspotAM5 -> de2, blindspotAM7 -> de3, blindspotAM3 -> de4
    include de1 -> *, de2 -> *, de3 -> *, de4 -> *
    global style criticite
    autoLayout LeftRight
  }

  /** TRACABILITE : le modele est-il rattache au document source ?
   *  Controle de couverture par ZONE (pas par composant) pour rester lisible. */
  view tracabilite {
    title '06 - Sûreté, Vérification & Recherche \/ Tracabilite — couverture documentaire par zone'

    description '''
      **Controle de couverture documentaire.** Chaque composant porte
      `metadata.source` = section du document d'architecture (`swarm30_arch.md`).

      Cette vue montre les **4 zones** et les **externes** : chaque zone agrege
      la tracabilite de ses composants. Pour auditer en detail, cliquer une
      zone (ouvre sa vue de zone) puis inspecter `source` sur chaque noeud.

      En bas : les hypotheses (H* -> §1.2) et les ADR (-> §10), qui completent
      la tracabilite.
    '''
    include onboard with { navigateTo zone-onboard }
    include edge with { navigateTo zone-edge }
    include c2 with { navigateTo zone-c2 }
    include cloud with { navigateTo zone-cloud }
    include h1, h2, h3, h4, h5, adr1, adr2, adr3, adr4, adr5, de1, de2, de3, de4
    include docSource
    global style criticite
    global style zones
    autoLayout TopBottom
  }

  /** CHOIX TECHNOLOGIQUES (1/3) — autopilotage, perception et navigation.
   *  Liste explicite des elements (pas de include * — cf. piege du tirage transitif). */
  view techAutopilot {
    title '04 - Algorithmique & Capacités (Components) \/ Vues thématiques (§A) \/ 3 — autopilotage & perception'

    description '''
      **Socle embarque.** PX4 (BSD-3, primaire) vs ArduPilot (GPL-3, alternative).
      Perception/fusion : ROS 2 (Apache-2.0). Pont MCU : Micro XRCE-DDS (Apache-2.0),
      alternative MAVLink/MAVSDK. Navigation marine USV : OpenCPN (GPL-2.0).
    '''
    include onboard.autopilot, onboard.mission, onboard.safety, onboard.perception, onboard.sensorsHAL
    include AutopilotPX4, ArduPilot, ROS2, MicroXRCEDDS, MAVLinkMAVSDK, OpenCPN
    global style criticite

    autoLayout LeftRight
  }

  /** CHOIX TECHNOLOGIQUES (2/3) — communication, coordination et supervision. */
  view techComms {
    title '04 - Algorithmique & Capacités (Components) \/ Vues thématiques (§A) \/ 3 — communication & coordination'

    description '''
      **Lien et coordination.** Zenoh (Apache-2.0 OR EPL-2.0, primaire decentralise)
      vs Mosquitto/MQTT (EPL-2.0, repli store-and-forward). Supervision C2 :
      QGroundControl (Apache-2.0).
    '''
    include onboard.linkRadio, onboard.taskAuction, edge.gateway, edge.relay, edge.coordinator, edge.fusion, edge.cache
    include c2.gcs, c2.planner, c2.alerting, c2.auth
    include Zenoh, MosquittoMQTT, QGroundControl, ROS2
    global style criticite

    autoLayout LeftRight
  }

  /** CHOIX TECHNOLOGIQUES (3/3) — donnees, observabilite et jumeau numerique. */
  view techData {
    title '04 - Algorithmique & Capacités (Components) \/ Vues thématiques (§A) \/ 3 — données, observabilité & jumeau'

    description '''
      **Socle de donnees.** Stockage objet : MinIO (⚠️ AGPL-3.0). Metriques :
      Prometheus + Grafana (⚠️ Grafana AGPL-3.0). Registre et geometrie :
      PostgreSQL + PostGIS (PostgreSQL License / GPL-2.0). Jumeau : Gazebo Sim
      (Apache-2.0).

      ⚠️ Les deux AGPL imposent des obligations fortes en cas d'exposition reseau
      d'une version modifiee : decision juridique a figer (AM-2, R-7).
    '''
    include onboard.energy, cloud.twin, cloud.analytics, cloud.replayStore, cloud.modelRegistry
    include MinIO, Prometheus, Grafana, PostgreSQLPostGIS, GazeboSim
    global style criticite

    autoLayout LeftRight
  }

  /** MATRICE DE RISQUES : les 15 risques du §D.
   *  Colores par criticite. Chaque risque porte sa mitigation et son alerte precoce. */
  view riskMatrix {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Matrice de risques — 15 risques (§D)'

    description '''
      **Risques identifies** (probabilite x impact). 5 critiques : R-1 (radio),
      R-2 (prise de controle), R-3 (validation reelle), R-4 (partition), R-5 (GNSS).

      Chaque noeud porte `metadata.criticite`, `.mitigation` et `.alerte`
      (signal d'alerte precoce). Les briques exposees sont reliees au risque.

      Lecture : ce sont des EVENEMENTS redoutes, distincts des angles morts (trous
      de specification) de la vue `blindspotBySeverity`.
    '''
    include riskR1, riskR2, riskR3, riskR4, riskR5
    include riskR6, riskR7, riskR8, riskR9, riskR10
    include riskR11, riskR12, riskR13, riskR14, riskR15
    include AutopilotPX4, MinIO, Grafana, Zenoh, MosquittoMQTT, QGroundControl, ROS2
    autoLayout TopBottom
  }

  /** ANGLES MORTS : les 16 angles morts du §C, groupes par gravite. */
  view blindspotBySeverity {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Angles morts — 16 lacunes de specification (§C)'

    description '''
      **Angles morts** = zones que l'architecture ne couvre pas ou couvre mal.
      4 critiques : AM-1 (licence), AM-3 (budget radio), AM-5 (echelle reelle),
      AM-7 (cybersecurite). 9 majeurs. 3 mineurs.

      Chaque noeud porte `metadata.gravite`, `.statut` (couvrir / accepter /
      surveiller) et `.consequence`. Les familles algorithmiques reliees
      indiquent ce qu'un choix laisse ouvert.
    '''
    include blindspotAM1, blindspotAM2, blindspotAM3, blindspotAM4
    include blindspotAM5, blindspotAM6, blindspotAM7, blindspotAM8
    include blindspotAM9, blindspotAM10, blindspotAM11, blindspotAM12
    include blindspotAM13, blindspotAM14, blindspotAM15, blindspotAM16
    include AlgorithmsPerceptionFusionEKFUKF, AlgorithmsTaskAllocationCBBA
    include AlgorithmsCoordinationCRDTLWW, AlgorithmsSureteReglesCBF
    autoLayout TopBottom
  }

  // ===========================================================================
  //  E05 — ARCHITECTURE MATERIELLE (ajout 2026-09-15)
  //  Le drone de reference et sa chaine capteurs -> calcul -> actionneurs.
  //  Ce modele est INSTANCIE 30 fois : la vue montre la STRUCTURE, pas les 30.
  // ===========================================================================
  view hardwareArchitecture {
    title '99 - Vues complémentaires \/ Architecture materielle — drone de reference'

    description '''
      Architecture physique du drone de reference (kind `drone`).
      Trois variantes du parc : UAV-R (18), UAV-F (8), USV (4).

      Chaine : **capteurs -> chaine de calcul -> actionneurs**.
      Les tags distinguent l'etabli du suppose :
        - `#tbd`    valeur inconnue, decision requise ;
        - `#extrap` valeur deduite, non confirmee par une source.

      Le modele decrit la STRUCTURE. L'etat dynamique (position, energie,
      voisinage) sera fourni par le moteur de simulation.
    '''
    include refDrone
    autoLayout LeftRight
  }

  view droneInternal {
    title '05 - Physique & Déploiement (Infrastructure) \/ Drone de reference — vue interne (Architecture materielle)'

    description '''Detail de la vue hardware : chaque sous-systeme et ses liens.'''
    include refDrone.*
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E06 — COMMUNICATIONS ET MESSAGES (ajout 2026-09-15)
  // ===========================================================================

  view communicationArchitecture {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Architecture de communication — canaux'

    description '''
      Quatre canaux, quatre regimes de disponibilite.

      `CH_LOCAL` ne depend d aucune communication externe : c est le
      support de l autonomie nominale (« le drone termine sa mission
      sans C2 ni cloud »). `CH_MESH` est intermittent par construction.

      Le budget radio total reste un angle mort (AM3).
    '''
    include chMesh, chCommand, chLocal, chCloud
    include onboard.linkRadio, onboard.telemetry, edge.gateway, edge.coordinator
    include c2.gcs, cloud.twin
    autoLayout LeftRight
  }

  view messageArchitecture {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Architecture des messages — 13 messages, 0 orphelin'

    description '''
      Graphe producteur -> message -> consommateur.

      Chaque message porte sa criticite, son canal, sa frequence et
      son comportement en cas de perte. C est ce graphe qui alimentera
      les **flux animes** dans la scene 3D (V3 de la roadmap).

      Losanges = messages. Rectangles = agents et services.
    '''
    include msgDroneState, msgHeartbeat, msgPositionUpdate, msgNeighborState
    include msgTaskBid, msgTaskAssignment, msgTrajectoryProposal, msgTrajectoryUpdate
    include msgFormationState, msgCollisionAlert, msgMissionCommand
    include msgConsensusVote, msgFailureNotification
    include onboard.perception, onboard.health, onboard.telemetry, onboard.taskAuction
    include onboard.mission, onboard.safety, onboard.autopilot
    include edge.coordinator, edge.gateway, c2.gcs
    autoLayout LeftRight
  }

  view criticalMessages {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ Messages critiques — voie de surete locale'

    description '''
      Les messages safety-critical. Point cle : `MSG_COLLISION_ALERT`
      et la voie de surete ne passent PAS par le reseau.
    '''
    include msgCollisionAlert, msgHeartbeat, msgPositionUpdate
    include msgTrajectoryUpdate, msgMissionCommand, msgFailureNotification
    autoLayout TopBottom
  }

  // ===========================================================================
  //  E04 — CATALOGUE D'ALGORITHMES (ajout 2026-09-15)
  // ===========================================================================

  view algorithmCatalog {
    title '04 - Algorithmique & Capacités (Components) \/ Catalogue algorithmique — 15 algorithmes (E27)'

    description '''
      Chaque algorithme est un objet de premiere classe, relie a son
      composant d accueil. C est la carte de reference pour la
      comparaison de variantes (V5).

      NB : les 7 familles algorithmiques d origine (architecture.c4)
      restent visibles dans les vues Hypothese/Angle mort.
    '''
    include algTaskAllocation, algConsensus, algFormationControl, algLeaderElection
    include algPerceptionFusion, algNavigationGNSSDegrade
    include algCollisionAvoidance, algSafetyRules, algPathPlanning
    include algHealthMonitoring, algEnergyAware
    // E27 : les 4 algorithmes ajoutes par E20 etaient absents du catalogue.
    include algEventTriggeredComm, algCooperativeLocalization
    include algFaultTolerantControlAlloc, algJammingResilientMode
    // E27 : element de specification detaillee (sinon invisible dans l UI).
    include specTaskAllocation
    autoLayout LeftRight
  }

  view algorithmSafety {
    title '04 - Algorithmique & Capacités (Components) \/ Chaînes algorithmiques \/ Chaine de surete — algorithmes embarquables sans lien'

    description '''
      Point cle de l architecture : la chaine de surete fonctionne
      SANS aucune communication. C est ce qui rend le predicat
      « le drone termine sa mission sans C2 ni cloud » defendable.
    '''
    include onboard.perception, algPerceptionFusion, algNavigationGNSSDegrade
    include onboard.safety, algCollisionAvoidance, algSafetyRules
    include onboard.autopilot, algFaultTolerantControlAlloc
    include onboard.health, algHealthMonitoring
    // E27 : localisation relative inter-agents (sans lien) et commande
    // tolerante aux fautes appartiennent a la chaine de surete.
    include algCooperativeLocalization
    autoLayout LeftRight
  }

  view algorithmCoordination {
    title '04 - Algorithmique & Capacités (Components) \/ Chaînes algorithmiques \/ Chaine de coordination — algorithmes dependants du lien'

    description '''
      A l inverse de la chaine de surete, toute cette chaine depend
      de la disponibilite du reseau. C est la source du risque de
      degradation (AM3 — budget radio).
    '''
    include onboard.taskAuction, algTaskAllocation, algConsensus
    include onboard.mission, algPathPlanning, algFormationControl
    include algLeaderElection, algEnergyAware
    include edge.coordinator
    // E27 : communication declenchee par evenement et mode resilient au
    // brouillage dependent du lien -> chaine de coordination.
    include algEventTriggeredComm, algJammingResilientMode
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E07 — DEPLOYMENT (ajout 2026-09-15)
  // ===========================================================================

  view deploymentChain {
    title '05 - Physique & Déploiement (Infrastructure) \/ Chaine de deploiement — Algorithm -> Component -> Runtime'

    description '''
      Lecture descendante : « ou tourne cet algorithme ? »

      Propriete demontree par le graphe : la chaine de SURETE (rtFlight)
      et la chaine de COORDINATION (rtCompanion) ne partagent AUCUN
      runtime. C est ce qui rend defendable « le drone termine sa
      mission sans C2 ni cloud ».

      NB : aucune coordonnee 3D ici — LikeC4 reste semantique.
    '''
    include algSafetyRules, algCollisionAvoidance, algPerceptionFusion
    include algNavigationGNSSDegrade, algHealthMonitoring
    include algTaskAllocation, algConsensus, algPathPlanning
    include algFormationControl, algEnergyAware, algLeaderElection
    include onboard.safety, onboard.perception, onboard.health
    include onboard.taskAuction, onboard.mission
    include edge.coordinator
    include rtFlight, rtCompanion, rtSensorsHAL, rtEdge
    include refDrone.flightCtrl, refDrone.companion
    autoLayout LeftRight
  }

  view deploymentZones {
    title '99 - Vues complémentaires \/ Zones de deploiement — embarque vs sol vs distant'

    description '''
      Ce qui est embarque (x30) vs ce qui est au sol (x1 partage).
      Perte toleree = le drone doit voler sans.
    '''
    include rtFlight, rtCompanion, rtSensorsHAL, rtEdge, rtC2, rtCloud
    include zoneOnboardDepl, zoneEdgeDepl, zoneC2Depl, zoneCloudDepl
    include deplDroneRef, refDrone
    autoLayout TopBottom
  }

  // ===========================================================================
  //  E02 — ARCHITECTURE FONCTIONNELLE (ajout 2026-09-15)
  // ===========================================================================

  view capabilityMap {
    title '04 - Algorithmique & Capacités (Components) \/ Carte des capacites — 8 capacites, 19 fonctions'

    description '''
      Niveau « pourquoi / quoi ». Chaque capacite est DERIVEE des
      descriptions de composants existants (tracabilite dans
      metadata.source).

      Lecture pedagogique : on explique le systeme par ce qu il SAIT
      FAIRE, pas par ses fichiers.
    '''
    include capFly, capPerceive, capDecide, capCooperate
    include capCommunicate, capSurvive, capObserve, capCommand
    autoLayout LeftRight
  }

  view survivabilitySplit {
    title '99 - Vues complémentaires \/ Frontiere avec lien \\\/ sans lien — ce qui vole sans reseau'

    description '''
      Capacites qui fonctionnent SANS aucun reseau (vert) vs celles qui
      dependent du lien (orange).

      Cette frontiere recoupe celle demontree en E07 par un chemin
      INDEPENDANT (rtFlight vs rtCompanion) : le predicat « mission
      sans C2 ni cloud » est confirme par deux methodes distinctes.
    '''
    include capFly, capPerceive, capDecide, capSurvive
    include fnFlightControl, fnSafetyRules, fnCollisionAvoidance
    include fnStateEstimation, fnNavigation, fnHealthMonitoring
    autoLayout LeftRight
  }

  view observeChain {
    title '04 - Algorithmique & Capacités (Components) \/ Chaînes algorithmiques \/ Chaine d\\\'observation — du drone au jumeau numerique'

    description '''
      La capacite CAP_OBSERVE : c est elle qui alimente le Digital Twin
      3D et la documentation pedagogique. Non requise pour voler.
    '''
    include capObserve, fnTelemetry, fnDigitalTwin, fnReplay
    include onboard.telemetry, edge.gateway, cloud.twin, cloud.replayStore
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E09 — SCENARIOS DYNAMIQUES (ajout 2026-09-15)
  // ===========================================================================

  view scenarioCatalogue {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ Catalogue des scenarios — 10 scenarios'

    description '''
      Le systeme en mouvement. Un scenario decrit une SEQUENCE CAUSALE,
      jamais un chemin dans l espace (pas de 3D ici : c est E11).

      Tous sont marques #hypothese : aucun n a ete execute.
    '''
    include scn01, scn02, scn03, scn04, scn05
    include scn06, scn07, scn08, scn09, scn10
    autoLayout LeftRight
  }

  view scenarioNominal {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ Mission nominale — INIT -> READY -> LAUNCH -> EXECUTE'

    description '''
      Le predicat central de l architecture, deroule.

      Invariant verifie : ce scenario n active QUE des capacites
      sans_lien=oui. Si une seule etape exigeait le reseau, la
      rearchitecture serait complete (cf. hypothesis H1).
    '''
    include scn01, st0101, st0102, st0103, st0104
    autoLayout LeftRight
  }

  view scenarioScaleChallenge {
    title '02 - Parcours & Opérations (Business & Scenarios) \/ SCN-10 — Perte du leader a N=30'

    description '''
      Le scenario le plus important pour la credibilite : il teste a
      l echelle cible (30) precisement ce qui n a jamais ete verifie
      en vol reel (max 26).

      Il expose riskR3 : validation a 30 non realisable par la voie
      experimentale. C est le simulateur (E10) qui doit le lever.
    '''
    include scn10, st1001, st1002, st1003, st1004
    autoLayout LeftRight
  }

  view scenarioRiskMapping {
    title '99 - Vues complémentaires \/ Scenarios x risques — ce que chaque scenario teste'

    description '''
      Lecture QA : chaque scenario est relie au risque ou a l angle mort
      qu il met en evidence. Un scenario sans ancrage serait de la fiction.
    '''
    include scn01, scn03, scn04, scn05, scn06, scn07, scn09, scn10
    include riskR1, riskR3, riskR4, riskR5, riskR8, riskR9, blindspotAM3, adr1, adr2
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E10 — CONTRAT DE SIMULATION (ajout 2026-09-15)
  // ===========================================================================

  view simulationBoundary {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Consommateurs du modele — ce que le modele fournit et ne fournit pas'

    description '''
      Haut : ce que le modele FOURNIT (semantique, topologie, contrats).
      Bas : ce qui est LAISSE au consommateur (3D, temps, capteurs).

      C est cette frontiere qui garantit que LikeC4 reste semantique.
    '''
    include simContract, providesSemantics, providesTopology, providesContracts
    include leftToConsumer, leftToConsumer2, leftToConsumer3, unknownCapability
    autoLayout TopBottom
  }

  view consumerMap {
    title '01 - Gouvernance & Stratégie (Executive View) \/ Consommateurs du modele — 5 cibles'

    description '''
      Simulateur, Blender, moteur Web 3D, environnement pedagogique,
      jumeau numerique. Tous A CONSTRUIRE : le modele est mesure a ce
      qu il permet de construire.
    '''
    include simContract, consSimulator, consBlender, consWeb3D, consPedago, consTwin
    autoLayout LeftRight
  }

  view invariantsView {
    title '06 - Sûreté, Vérification & Recherche \/ 5 invariants verifiables du contrat'

    description '''
      INV-1 sans C2 ni cloud · INV-2 surete locale · INV-3 echelle 30
      non prouvee · INV-4 aucune 3D dans le modele · INV-5 statut
      epistemique preserve.

      Un consommateur qui en viole un n est plus aligne sur l architecture.
    '''
    include simContract, invNoC2, invSafetyLocal, invScale30, invNo3DInModel, invEvidence
    include unknownCapability, degLinkLoss, degGNSS, degSpectrum, degPerception
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E08 — REFERENTIEL SCIENTIFIQUE (ajout 2026-09-15)
  // ===========================================================================

  view scienceVerdicts {
    title '06 - Sûreté, Vérification & Recherche \/ Verdicts scientifiques — 4 affirmations decisives'

    description '''
      Chaque affirmation est confrontee a ses sources primaires.
      SCI-2 (CBF) est UNSUPPORTED : la source primaire CONTREDIT
      l affirmation. Le modele porte cette correction.

      Lecture : le systeme enseigne aussi ses propres limites.
    '''
    include sciCbba, sciCbf, sciCrdt, sciEkf
    autoLayout LeftRight
  }

  view scienceToAlgorithms {
    title '99 - Vues complémentaires \/ Sources -> verdicts -> algorithmes concernes'

    description '''
      Tracabilite complete : une affirmation du catalogue algorithmique
      remonte a sa source primaire, ou a l absence de source.
    '''
    include srcCBBA, srcCBBA24, srcDegraded30, srcCAHCBF, srcCRDT, srcKilobot, srcUUV
    include sciCbba, sciCbf, sciCrdt, sciEkf
    include algTaskAllocation, algCollisionAvoidance, algConsensus, algPerceptionFusion
    autoLayout LeftRight
  }

  view benchmarkGaps {
    title '06 - Sûreté, Vérification & Recherche \/ Trous de benchmark — ce qui n est PAS prouve'

    description '''
      4 cibles de recherche futures, explicitement declarees. Ce ne sont
      pas des echecs : c est la carte des zones ou le systeme n est pas
      etaye, et donc ou le simulateur (E10) doit lever le doute.
    '''
    include gap1, gap2, gap3, gap4
    include riskR3, riskR4, riskR9, riskR8
    autoLayout LeftRight
  }

  // ===========================================================================
  //  E11 — WORLD MODEL (ajout 2026-09-15)
  // ===========================================================================

  view worldModelMap {
    title '03 - Architecture Logique & Flux (C4 Containers & Interactions) \/ World Model — entites, zones et categories (AUCUNE 3D)'

    description '''
      Modele DERIVE pour la consommation Blender / Web 3D. Il ne contient
      aucune coordonnee : le consommateur spatialise.

      Population exacte : UAV-R x18 + UAV-F x8 + USV x4 = 30 operationnels,
      + 1 maquette de reference DISTINCTE (REG-5).
    '''
    include entUavR, entUavF, entUsv, entReference
    include entGroundStation, entEdgeNode, entTwin
    include zoneAir, zoneSurface, zoneAllocation, zoneCommsRelay, zoneCommand, zoneCloud
    include catAerial, catSurface, catCommand, catReference
    autoLayout LeftRight
  }

  view renderRules {
    title '06 - Sûreté, Vérification & Recherche \/ 6 regles de representation — garde-fous verifiables'

    description '''
      Ces regles protegent la verite du modele. Elles interdisent au
      consommateur d afficher une donnee que le modele ne fournit pas.

      REG-2 (energie, DE-07) et REG-3 (portee radio) interdisent
      explicitement d INVENTER une valeur chiffree.
    '''
    include ruleNoInventId, ruleNoInventEnergy, ruleNoInventRadio
    include ruleNoInventRange, ruleNoInventCount, ruleSemanticOnly
    autoLayout LeftRight
  }

  view worldStates {
    title '06 - Sûreté, Vérification & Recherche \/ 10 etats d\\\'apparence — le rendu represente des ETATS'

    description '''
      Chaque etat derive d un scenario E09. Le World Model ne cree aucun
      comportement : il traduit des sequences causales en apparences.
    '''
    include stNominal, stLinkLost, stAgentLost, stPartition, stGnssDegraded
    include stCollisionRisk, stSpectrumSat, stEnergyCritical, stDense, stLeaderLost
    autoLayout LeftRight
  }
}

