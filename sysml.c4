// =============================================================================
//  SYSML-15 — SPECIFICATIONS SysML v2 DES 15 ALGORITHMES (carte t_d671a500)
//
//  Fichier purement ADDITIF : aucun identifiant, relation ni vue existant
//  n'est modifie. Les fiches `algorithm` (les 15) ne sont PAS touchees.
//
//  Decision de conception (orchestrateur) : LikeC4 n'est PAS SysML v2.
//  Les specs SysML v2 vivent dans des fichiers .sysml reels (dossier sysml/),
//  un par algorithme. LikeC4 les REFERENCE via des elements specDoc + une
//  relation `documentedBy`, et expose la tracabilite dans la vue
//  `algorithmSysmlTraceability`.
//
//  Validation (honnete) :
//    - syntaxe LikeC4 : docker exec likec4 likec4 validate /data -> Valid
//    - syntaxe SysML v2 : parseur structurel maison (sysml/validate_sysml.py),
//      15/15. AUCUN validateur OMG SysML v2 n'est installe (documente).
// =============================================================================

model {

  // ===========================================================================
  //  specDoc SysML v2 — un element par algorithme, pointant vers le fichier
  //  .sysml correspondant (depot dagornc/swarmdrones-likec4, dossier sysml/).
  // ===========================================================================

  sysmlTaskAllocation = specDoc 'Specification SysML v2 — ALG_TASK_ALLOCATION' {
    #source-doc
    link https://likec4.breizh.ai/sysml/ALG_TASK_ALLOCATION.sysml "Source SysML v2 (sysml/ALG_TASK_ALLOCATION.sysml)"
    description 'Specification SysML v2 (notation textuelle OMG) — Allocation de taches distribuee (CBBA v3). Constructeurs : part def, action def, requirement def, interface def. Transcrite de algorithms.c4 :: algTaskAllocation.'
    metadata {
      algorithme 'ALG_TASK_ALLOCATION'
      format 'SysML v2 (OMG, notation textuelle)'
      fichier 'sysml/ALG_TASK_ALLOCATION.sysml'
      validation 'structurelle maison (sysml/validate_sysml.py) — aucun validateur OMG installe'
    }
  }

