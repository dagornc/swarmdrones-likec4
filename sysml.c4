views {

  // ===========================================================================
  //  SYSML-15 — TRACABILITE ALGORITHME -> SPECIFICATION SysML v2
  //  Projection (sens reel du metamodele) : algorithm -[documentedBy]-> specDoc
  //  Aucun arc n'est invente : seules les relations ci-dessus sont projetees.
  //  ETAT : 15/15 algorithmes references par une spec SysML v2.
  // ===========================================================================

  view algorithmSysmlTraceability {
    title '04 · Algorithmique \/ Traçabilite algorithme -> specification SysML v2'
    description '''
      Lecture : « ou est la specification SysML v2 de cet algorithme ? »

      Chemin projete (sens reel du metamodele) :
        chaque algorithme est documente par sa specDoc SysML v2 (documentedBy).

      Chaque specDoc reference le fichier sysml/<ALG_ID>.sysml du depot
      dagornc/swarmdrones-likec4 (notation textuelle OMG).

      ETAT MESURE : 15/15 algorithmes portent une specification SysML v2.
      VALIDATION : syntaxe LikeC4 = likec4 validate (outil reel) ; syntaxe
      SysML v2 = parseur structurel maison uniquement (aucun validateur OMG
      installe — la conformite OMG reste a etablir avec SysIDE).

      Complement : algorithmSpecTraceability (specifications PDF detaillees).
    '''
    include algTaskAllocation
    include algConsensus
    include algFormationControl
    include algLeaderElection
    include algPerceptionFusion
    include algNavigationGNSSDegrade
    include algCollisionAvoidance
    include algSafetyRules
    include algPathPlanning
    include algHealthMonitoring
    include algEnergyAware
    include algEventTriggeredComm
    include algCooperativeLocalization
    include algFaultTolerantControlAlloc
    include algJammingResilientMode
    include sysmlTaskAllocation
    include sysmlConsensus
    include sysmlFormationControl
    include sysmlLeaderElection
    include sysmlPerceptionFusion
    include sysmlNavigationGNSSDegrade
    include sysmlCollisionAvoidance
    include sysmlSafetyRules
    include sysmlPathPlanning
    include sysmlHealthMonitoring
    include sysmlEnergyAware
    include sysmlEventTriggeredComm
    include sysmlCooperativeLocalization
    include sysmlFaultTolerantControlAlloc
    include sysmlJammingResilientMode
    global style lectureZones
    autoLayout LeftRight
  }
}
