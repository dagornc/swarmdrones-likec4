// =============================================================================
//  E09 — SCENARIOS DYNAMIQUES (SWARM-3D-ARCHITECTURE, carte t_361b3beb)
//
//  Objectif : decrire des scenarios qui EXPLIQUENT le fonctionnement de
//  l essaim. Ces scenarios sont la matiere premiere :
//    - des « guided tours » LikeC4 (documentation navigable, E13) ;
//    - des sequences animes dans la scene 3D (E11) ;
//    - des cas de test du simulateur (E10).
//
//  PRINCIPE : un scenario n est PAS de la fiction. Chaque etape doit
//  correspondre a des elements, messages ou algorithmes REELLEMENT
//  presents dans le modele. Les identifiants sont references, pas
//  recopies, pour eviter la desynchronisation.
//
//  REGLE DE MISSION : aucune coordonnee 3D. Un scenario decrit une
//  SEQUENCE CAUSALE (« qui declenche quoi »), pas un chemin dans
//  l espace. Le placement spatial appartient au World Model (E11).
//
//  LIMITE DECLAREE : ces scenarios ne sont PAS des donnees de vol.
//  Aucun n a ete execute en simulation ni en vol. Ils decrivent la
//  sequence attendue d apres l architecture. Marques #hypothese.
// =============================================================================

model {

  // ===========================================================================
  //  1. SCENARIOS — capacites et invariants
  // ===========================================================================

  scn01 = scenario 'SCN-01 — Mission nominale sans C2 ni cloud' {
    #scenario #hypothese
    link https://doi.org/10.1016/j.ast.2026.112100 "Distributed self-organizing control for cross-domain unmanned swarm multi-target tracking under constrained communication"
    description '''
      Scenario de REFERENCE. Un drone effectue sa mission complete avec
      C2 et cloud INDISPONIBLES du debut a la fin.

      C est le scenario qui valide le predicat central de l architecture.
      Il n active QUE des capacites marquees sans_lien=oui.
    '''
    metadata {
      capacites 'CAP_FLY, CAP_PERCEIVE, CAP_DECIDE, CAP_SURVIVE'
      acteurs 'refDrone, onboard.*'
      invariants 'aucune dependance a CH_COMMAND ni CH_CLOUD ; surete locale active'
      critiques 'aucune'
      resultat_attendu 'mission terminee, atterrissage nominal'
      statut 'NON EXECUTE — sequence derivee de l architecture'
    }
  }

  scn02 = scenario 'SCN-02 — Perte du lien de commandement' {
    #scenario #hypothese
    link https://doi.org/10.1007/s44465-026-00041-0 "Adaptive dual mode operational swarm control for resilient asset defense under communication jamming"
    description '''
      Le lien C2 tombe en cours de mission. Le drone poursuit sa mission
      nominale sur son plan embarque et applique ses regles de surete.
    '''
    metadata {
      capacites 'CAP_FLY, CAP_PERCEIVE, CAP_DECIDE, CAP_SURVIVE'
      declencheur 'perte de MSG_MISSION_COMMAND / heartbeat C2'
      invariants 'le plan embarque est versionne ; la surete ne depend pas du lien'
      critiques 'la re-optimisation C2 est differee (pas perdue : differee)'
      resultat_attendu 'mission poursuivie, retour du lien sans rupture'
    }
  }

  scn03 = scenario 'SCN-03 — Perte d un agent et reconfiguration' {
    #scenario #hypothese
    link https://doi.org/10.3390/fractalfract10050315 "Resilient Leader–Follower Consensus of Fractional-Order Nonlinear Multi-Agent Systems Under Sybil and DoS Attacks via Event-Triggered Adaptive Control"
    description '''
      Un agent est perdu. Les autres doivent le detecter, redistribuer
      sa charge et, si c etait le leader, en elire un nouveau.
    '''
    metadata {
      capacites 'CAP_COOPERATE, CAP_SURVIVE'
      declencheur 'absence de MSG_HEARTBEAT / MSG_FAILURE_NOTIFICATION'
      algorithmes 'algHealthMonitoring, algLeaderElection, algTaskAllocation'
      invariants 'la reconfiguration ne doit pas degrader la surete locale'
      critiques 'risque de double leader sous partition (non caracterise)'
      resultat_attendu 'charge redistribuee, leader unique retabli'
      tbd 'temps de reconfiguration a 30 non mesure'
    }
  }

  scn04 = scenario 'SCN-04 — Partition du reseau' {
    #scenario #hypothese
    link https://arxiv.org/abs/2508.00622 "SwarmRaft: Leveraging Consensus for Robust Drone Swarm Coordination in GNSS-Degraded Environments"
    description '''
      Le maillage se coupe en deux groupes qui ne communiquent plus.
      Chaque groupe doit rester sur et ne pas converger vers deux etats
      contradictoires irréconciliables.
    '''
    metadata {
      capacites 'CAP_COOPERATE, CAP_SURVIVE'
      algorithmes 'algConsensus (CRDT/LWW), algLeaderElection'
      invariants 'resolution par role (C2 > Edge > Onboard) ; pas de quorum global'
      critiques 'risque de double leader ; reconvergence non garantie'
      resultat_attendu 'reconvergence a la restauration du lien'
      tbd 'reconvergence a 30 = MEDIUM dans le modele, non confirmee'
    }
  }

  scn05 = scenario 'SCN-05 — GNSS degrade / denied' {
    #scenario #hypothese
    link https://doi.org/10.3390/drones10010049 "DTVIRM-Swarm: A Distributed and Tightly Integrated Visual-Inertial-UWB-Magnetic System for Anchor Free Swarm Cooperative Localization"
    description '''
      La positionnement satellite se degrade puis disparait. Bascule en
      VIO, puis reduction de zone et RTL si la derive depasse le seuil.
    '''
    metadata {
      capacites 'CAP_PERCEIVE, CAP_DECIDE, CAP_SURVIVE'
      algorithmes 'algNavigationGNSSDegrade, algSafetyRules'
      declencheur 'perte ou degradation du signal GNSS'
      invariants 'la surete se replie sur des regles locales si la derive n est pas bornee'
      critiques 'derive non quantifiee (DE-08 ouvert)'
      resultat_attendu 'retour au bercail sur seuil de derive'
    }
  }

  scn06 = scenario 'SCN-06 — Evitement de collision' {
    #scenario #hypothese
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    description '''
      Deux agents convergent vers une collision. La couche de surete
      embarque doit produire une correction minimale, SANS dependre du
      reseau ni de l allocation de taches.
    '''
    metadata {
      capacites 'CAP_PERCEIVE, CAP_DECIDE'
      algorithmes 'algCollisionAvoidance, algPerceptionFusion'
      declencheur 'distance relative sous la marge de securite'
      messages 'MSG_COLLISION_ALERT'
      invariants 'independant du lien et de l allocation (couche non negociable)'
      critiques 'delai d action <= 100 ms = HYP non sourcee ; preuve a 30 non etablie'
      resultat_attendu 'separation maintenue, reprise de mission'
    }
  }

  scn07 = scenario 'SCN-07 — Saturation du spectre / budget radio' {
    #scenario #hypothese
    link https://doi.org/10.1051/itmconf/20246401002 "Flying Ad-Hoc Networks (FANETs): Review of Communications, Challenges, Applications, Future direction and Open Research Topics"
    description '''
      Le besoin de coordination depasse ce que le lien peut porter.
      Degradation de la coordination, la surete reste intacte.
    '''
    metadata {
      capacites 'CAP_COOPERATE (degradee), CAP_SURVIVE (intacte)'
      declencheur 'AM3 — budget radio non dimensionne (angle mort)'
      invariants 'la surete ne depend PAS du debit disponible'
      critiques 'AM3 non resolu : le point de saturation n est pas connu'
      resultat_attendu 'coordination degradee, vol sur'
      tbd 'budget radio a 30 agents = DE-06 ouvert'
    }
  }

  scn08 = scenario 'SCN-08 — Energie critique' {
    #scenario #hypothese
    link https://doi.org/10.3390/drones10090684 "An Event-Triggered Path-Based Bid Assignment Method for Energy-Aware Dynamic Multi-UAV Task Allocation"
    description '''
      La marge d energie devient insuffisante pour terminer la mission.
      Arbitrage entre valeur de mission et marge de repli.
    '''
    metadata {
      capacites 'CAP_SURVIVE, CAP_COOPERATE'
      algorithmes 'algEnergyAware, algTaskAllocation'
      declencheur 'marge d energie sous le seuil de retour'
      invariants 'le RTL budget est prioritaire sur la valeur de mission'
      critiques 'capacite batterie NON DETERMINEE (DE-07, seul TBD reellement ouvert)'
      resultat_attendu 'repli ordonne, charge redistribuee'
    }
  }

  scn09 = scenario 'SCN-09 — Charge dense et perception degradee' {
    #scenario #hypothese
    link https://doi.org/10.3390/drones9110752 "Enabling Cooperative Autonomy in UUV Clusters: A Survey of Robust State Estimation and Information Fusion Techniques"
    description '''
      Densite elevee : la fusion de pistes produit des fausses pistes
      (risque R-8). Le systeme doit degrader proprement.
    '''
    metadata {
      capacites 'CAP_PERCEIVE (degradee), CAP_DECIDE'
      algorithmes 'algPerceptionFusion'
      declencheur 'risque R-8 (fusion degradee en scenario dense)'
      invariants 'la surete locale ne depend pas de la fusion multi-agents'
      critiques 'fusion multi-agents a 30 = non etablie'
      resultat_attendu 'fausses pistes rejetees, evitement local preserve'
    }
  }

  scn10 = scenario 'SCN-10 — Perte du leader et reconfiguration a 30' {
    #scenario #hypothese
    link https://doi.org/10.3390/fractalfract10050315 "Resilient Leader–Follower Consensus of Fractional-Order Nonlinear Multi-Agent Systems Under Sybil and DoS Attacks via Event-Triggered Adaptive Control"
    description '''
      Le coordinateur est perdu alors que l essaim est a pleine echelle
      (N=30). C est le scenario qui teste la reconfiguration a l echelle
      cible — precisement ce qui n est pas mesure.
    '''
    metadata {
      capacites 'CAP_COOPERATE, CAP_SURVIVE'
      algorithmes 'algLeaderElection, algConsensus, algTaskAllocation'
      echelle 'N=30 (UAV-R x18, UAV-F x8, USV x4)'
      invariants 'surete locale intacte pendant la reconfiguration'
      critiques 'AUCUNE preuve a 30 plateformes — max verifie en vol reel : 26'
      resultat_attendu 'nouveau leader, charge redistribuee, surete preservee'
      statut 'NON EXECUTE — necessite le simulateur (E10)'
    }
  }

  // ===========================================================================
  //  2. DEROULE DETAILLE — les 4 scenarios structurants
  //     Chaque etape reference des ELEMENTS REELS du modele.
  // ===========================================================================

  // ---- SCN-01 : mission nominale sans C2 ni cloud ----
  st0101 = state 'SCN01.1 — Decollage sur plan embarque' {
    #scenario
    metadata { scenario 'SCN-01'; acteur 'onboard.mission'; algo 'algPathPlanning'; reseau 'indisponible'; invariant 'aucun appel C2/cloud' }
  }
  st0102 = state 'SCN01.2 — Perception et estimation locales' {
    #scenario
    metadata { scenario 'SCN-01'; acteur 'onboard.perception'; algo 'algPerceptionFusion'; reseau 'indisponible' }
  }
  st0103 = state 'SCN01.3 — Surete locale armee' {
    #scenario
    metadata { scenario 'SCN-01'; acteur 'onboard.safety'; algo 'algSafetyRules'; reseau 'indisponible'; invariant 'geofence + RTL actifs' }
  }
  st0104 = state 'SCN01.4 — Mission executee et terminee' {
    #scenario
    metadata { scenario 'SCN-01'; acteur 'onboard.mission'; resultat 'atterrissage nominal'; reseau 'toujours indisponible' }
  }

  // ---- SCN-03 : perte d agent et reconfiguration ----
  st0301 = state 'SCN03.1 — Perte d un agent detectee' {
    #scenario
    metadata { scenario 'SCN-03'; acteur 'onboard.health'; algo 'algHealthMonitoring'; message 'MSG_HEARTBEAT absent' }
  }
  st0302 = state 'SCN03.2 — Alerte propagee' {
    #scenario
    metadata { scenario 'SCN-03'; message 'MSG_FAILURE_NOTIFICATION'; canal 'CH_MESH' }
  }
  st0303 = state 'SCN03.3 — Leader reélu si necessaire' {
    #scenario
    metadata { scenario 'SCN-03'; acteur 'onboard.mission'; algo 'algLeaderElection'; risque 'double leader sous partition' }
  }
  st0304 = state 'SCN03.4 — Charge redistribuee' {
    #scenario
    metadata { scenario 'SCN-03'; acteur 'onboard.taskAuction'; algo 'algTaskAllocation'; message 'MSG_TASK_ASSIGNMENT' }
  }

  // ---- SCN-06 : evitement de collision ----
  st0601 = state 'SCN06.1 — Convergence detectee' {
    #scenario
    metadata { scenario 'SCN-06'; acteur 'onboard.perception'; algo 'algPerceptionFusion'; message 'MSG_NEIGHBOR_STATE' }
  }
  st0602 = state 'SCN06.2 — Seuil de securite franchi' {
    #scenario
    metadata { scenario 'SCN-06'; acteur 'onboard.safety'; message 'MSG_COLLISION_ALERT'; delai '<= 100 ms [HYP]' }
  }
  st0603 = state 'SCN06.3 — Correction minimale appliquee' {
    #scenario
    metadata { scenario 'SCN-06'; acteur 'onboard.autopilot'; algo 'algCollisionAvoidance'; propriete 'SANS reseau' }
  }
  st0604 = state 'SCN06.4 — Separation retablie, mission reprise' {
    #scenario
    metadata { scenario 'SCN-06'; acteur 'onboard.mission'; resultat 'separation > marge' }
  }

  // ---- SCN-10 : perte du leader a N=30 ----
  st1001 = state 'SCN10.1 — Leader perdu a pleine echelle' {
    #scenario
    metadata { scenario 'SCN-10'; echelle 'N=30'; acteur 'edge.coordinator'; limite 'AUCUNE preuve a 30' }
  }
  st1002 = state 'SCN10.2 — Detection et election distribuee' {
    #scenario
    metadata { scenario 'SCN-10'; algo 'algLeaderElection, algConsensus'; message 'MSG_CONSENSUS_VOTE' }
  }
  st1003 = state 'SCN10.3 — Surete locale maintenue pendant la reconfiguration' {
    #scenario
    metadata { scenario 'SCN-10'; acteur 'onboard.safety'; invariant 'PAS de dependance a la reconfiguration' }
  }
  st1004 = state 'SCN10.4 — Nouveau leader, charge redistribuee' {
    #scenario
    metadata { scenario 'SCN-10'; algo 'algTaskAllocation'; resultat 'leader unique retabli'; statut 'NON EXECUTE' }
  }

  // ===========================================================================
  //  3. RELATIONS — scenario -> etapes -> elements reels
  // ===========================================================================

  scn01 -[triggers]-> st0101 'etape 1'
  st0101 -[triggers]-> st0102 'puis'
  st0102 -[triggers]-> st0103 'puis'
  st0103 -[triggers]-> st0104 'puis'

  scn03 -[triggers]-> st0301 'etape 1'
  st0301 -[triggers]-> st0302 'puis'
  st0302 -[triggers]-> st0303 'puis'
  st0303 -[triggers]-> st0304 'puis'

  scn06 -[triggers]-> st0601 'etape 1'
  st0601 -[triggers]-> st0602 'puis'
  st0602 -[triggers]-> st0603 'puis'
  st0603 -[triggers]-> st0604 'puis'

  scn10 -[triggers]-> st1001 'etape 1'
  st1001 -[triggers]-> st1002 'puis'
  st1002 -[triggers]-> st1003 'puis'
  st1003 -[triggers]-> st1004 'puis'

  // Ancrage des scenarios sur les elements reels du modele
  scn01 -[uses]-> onboard.mission 'scenario nominal'
  scn01 -[uses]-> onboard.safety 'surete locale'
  scn01 -[uses]-> onboard.perception 'perception locale'
  scn02 -[uses]-> c2.gcs 'perte du C2'
  scn02 -[uses]-> onboard.mission 'poursuite sur plan embarque'
  scn03 -[uses]-> onboard.health 'detection'
  scn03 -[uses]-> onboard.taskAuction 'redistribution'
  scn04 -[uses]-> algConsensus 'partition'
  scn05 -[uses]-> algNavigationGNSSDegrade 'GNSS degrade'
  scn06 -[uses]-> onboard.safety 'evitement'
  scn08 -[uses]-> onboard.energy 'energie'
  scn09 -[uses]-> onboard.perception 'densite'
  scn10 -[uses]-> edge.coordinator 'echelle N=30'

  // Ancrage epistemique : chaque scenario est relie au risque ou a l angle
  // mort qu il teste. C est ce lien qui rend le scenario utile en QA (E12).
  scn03 -[exposes]-> riskR4 'double leader sous partition'
  scn04 -[exposes]-> riskR4 'split-brain'
  scn04 -[exposes]-> adr2 'fraicheur explicite, pas de coherence forte'
  scn05 -[exposes]-> riskR5 'derive GNSS-degrade'
  scn06 -[exposes]-> riskR9 'collision en scenario d urgence'
  scn07 -[exposes]-> blindspotAM3 'budget radio non dimensionne'
  scn07 -[exposes]-> riskR1 'contention radio a 30'
  scn09 -[exposes]-> riskR8 'fausses pistes en densite'
  scn10 -[exposes]-> riskR3 'validation a 30 non realisable'
  scn01 -[exposes]-> adr1 'contrat de mission embarque'
}
