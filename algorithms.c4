  specNavigationGNSSDegrade = specDoc 'Specification detaillee — ALG_NAV_GNSS_DEGRADE (v1)' {
    #source-doc
    link https://github.com/dagornc/swarmdrones-likec4/blob/master/specification/Spec_ALG_NAV_GNSS_DEGRADE_v1.pdf "Specification detaillee Navigation sous GNSS degrade v1 (PDF) — depot PRIVE dagornc/swarmdrones-likec4 (specification/)"
