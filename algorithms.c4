// =============================================================================
//  E04 — CATALOGUE D'ALGORITHMES (SWARM-3D-ARCHITECTURE, carte t_83ae834a)
//
//  Objectif : chaque algorithme devient un OBJET DE PREMIERE CLASSE.
//
//  NE PAS CONFONDRE avec les elements `algorithm` d'architecture.c4 :
//  ceux-ci sont des FAMILLES algorithmiques reliees aux hypotheses et
//  aux angles morts. Ce fichier les ENRICHIT en objets de catalogue
//  actionnables par le simulateur.
//
//  REGLES DE MISSION :
//    - le code NE VIT PAS dans LikeC4 : on reference un repository/chemin ;
//    - toute valeur inconnue -> TBD + #tbd, jamais inventee ;
//    - toute affirmation scientifique importante doit pouvoir etre reliee
//      a une source. Sans source trouvee -> 'aucune source verifiee' ;
//    - executionMode = conceptual | emulated | simulated | executable ;
//    - implementationStatus = idea | specified | prototype | implemented |
//      tested | validated.
//
//  AVERTISSEMENT D'HONNETETE : aucune source primaire n'a ete verifiee
//  dans cette session. Les champs `references` portent donc la valeur
//  'aucune source verifiee' et le champ `evidence` reste conserve tel
//  qu'il figurait dans le modele existant. Le profil SwarmDrone doit
//  lever ces TBD avant tout usage de comparaison.
// =============================================================================

model {

  // ===========================================================================
  //  A. COORDINATION, ALLOCATION, DECISION DISTRIBUEE
  // ===========================================================================

  algTaskAllocation = algorithm 'ALG_TASK_ALLOCATION — Allocation de taches distribuee (CBBA v3)' {
    #algorithm
    link https://doi.org/10.1109/tro.2009.2022423 "Consensus-Based Decentralized Auctions for Robust Task Allocation"
    link https://arxiv.org/abs/2609.06273 "Bundle Length Tradeoffs in Decentralized Multi-Robot Task Allocation Under Degraded Communications"
    link https://doi.org/10.1007/s12065-026-01257-5 "Survival probability-weighted clustering for UAV-based multi-robot task allocation in disaster response"
    link https://doi.org/10.1016/j.ergon.2026.103981 "Homogeneous or heterogeneous? Simulation-based comparison of task allocation strategies for multi-operator UAV swarms control"
    link https://doi.org/10.1007/s42401-026-00540-8 "Multi-UAV cooperative task allocation using chaos theory and an adaptive genetic algorithm"
    link https://doi.org/10.3390/app12136780 "Centralized Task Allocation and Alignment Based on Constraint Table and Genetic Algorithm"
    link https://doi.org/10.3390/electronics12112508 "A Period Training Method for Heterogeneous UUV Dynamic Task Allocation"
    link https://doi.org/10.3390/biomimetics11010069 "Large-Scale Multi-UAV Task Allocation via a Centrality-Driven Load-Aware Approach"
    link https://doi.org/10.1038/s41598-025-09753-x "Integrated method for multi-UAV task assignment and trajectory planning"
    description '''
      Consensus-based Bundle Algorithm : encheres successives avec
      resolution de conflits. Chaque agent construit un ensemble de
      taches et surenchérit jusqu a consensus.
    '''
    metadata {
      category 'coordination / allocation'
      purpose 'Repartir un ensemble de taches entre agents heterogenes sans autorite centrale'
      inputs 'ensemble de taches, couts par agent, etat des voisins'
      outputs 'attribution locale de taches, ensemble de faisceaux'
      parameters 'neighborCount, bidValue, conflictWindow, timeout'
      hypotheses 'communication evenementielle (ED-CBBA) ; couts additifs ; agents cooperatifs ; partition detectable par heartbeat'
      contraintes 'convergence globale non garantie sous partition persistante (garantie locale) ; optimalite 50% pire-cas ; budget radio'
      state 'local par agent + etat partage des encheres + etat de partition'
      executionMode 'conceptual'
      implementationStatus 'implemented'
      repository 'https://github.com/dagornc/alg-task-allocation'
      sourceDocs 'Choi/Brunet/How 2009 IEEE T-RO ; Bi et al. 2024 DOI 10.3390/drones8080345 ; Sao et al. 2025 arXiv 2509.06481'
      version 'v3 (spec SWARM-SPEC-ALG-001-V3, 2026-09-18)'
      maturity 'mature-en-labo (repris du modele existant)'
      evidence 'MEDIUM — CONDITIONNEL (cf SCI-1) : convergence prouvee sous comms ideales ; convergence locale sous partition (HYPOTHESE) ; robustesse au retrait seulement EMPIRIQUE'
      metrics 'makespan, qualite d allocation, temps de convergence, messages echanges, taux de completion sous partition'
      references 'Choi 2009 ; Bi 2024 (N=8 reel) ; DOI 10.70322/dav.2025.10016 (N=30 SIMULATION) — CONSULTEES'
      relatedComponents 'onboard.taskAuction, edge.coordinator, onboard.resilience'
      relatedMessages 'MSG_TASK_BID, MSG_TASK_ASSIGNMENT, MSG_CONSENSUS_VOTE, MSG_HEARTBEAT'
      variantes 'CBBA, PI-CBBA, ACBBA, ED-CBBA v3, TLC-CBBA, CLAC-CBBA, ET-PBBA'
      tbd 'GAP-1 : convergence globale sous partition persistante (locale prouvee, globale HYPOTHESE) ; GAP-2 : N=30 reel non demontre ; GAP-7 : biais appris et DMG'
      evidenceLevel 'MEDIUM'
      maturityLevel 'MATURE'
    }
  }

  algConsensus = algorithm 'ALG_CONSENSUS — Consensus distribue' {
    #algorithm
    link https://arxiv.org/abs/2508.00622 "SwarmRaft: Leveraging Consensus for Robust Drone Swarm Coordination in GNSS-Degraded Environments"
    link https://arxiv.org/abs/2609.01870 "ArcticSwarm: Deferring Early Consensus in Long-Horizon Multi-Agent Research"
    link https://doi.org/10.1016/j.asoc.2026.116398 "Hierarchical optimal consensus for economically efficient path planning in multi-UAV"
    link https://doi.org/10.3390/s25216738 "A Two-Level Clustered Consensus-Based Bundle Algorithm for Dynamic Heterogeneous Multi-UAV Task Allocation"
    link https://arxiv.org/abs/2609.09066 "A Distributed Consensus Particle Filter for Target Tracking using Autonomous Agents"
    link https://doi.org/10.3390/machines14070715 "Dynamic Event-Triggered Consensus Formation Control Method for Multi-UAV Systems"
    description '''
      Convergence d un etat partage entre agents par echange iteratif
      (moyenne, max-consensus, ou CRDT LWW selon le besoin).
    '''
    metadata {
      category 'coordination / consensus'
      purpose 'Etablir un etat commun sans autorite centrale, tolerant aux partitions'
      inputs 'etat local, etats des voisins, topologie de communication'
      outputs 'etat converge'
      parameters 'gains de consensus, periode d echange, seuil de convergence'
      hypotheses 'graphe connexe a terme ; delais bornes'
      contraintes 'partition prolongee : convergence non garantie'
      state 'etat partage replique'
      executionMode 'conceptual'
      implementationStatus 'implemented'
      repository 'https://github.com/dagornc/alg-consensus'
      version 'v5.0 (spec SWARM-SPEC-ALG-002, 2026-09-19)'
      maturity 'mature (repris du modele : coordination CRDT/LWW)'
      evidence 'HIGH (theorie CRDT prouvee) / LOW (application essaim drones) — cf SCI-3'
      metrics 'temps de convergence, ecart residuel, nombre de messages'
      references 'Shapiro et al. 2011 INRIA RR-7687 (theoreme semilattice) ; Swarm Intell. 2025 DOI 10.1007/s11721-025-00251-4 (jusqu a 200 Kilobots reels) — CONSULTEES'
      relatedComponents 'onboard.taskAuction, edge.coordinator'
      relatedMessages 'MSG_CONSENSUS_VOTE'
      variantes 'CRDT LWW (retenu par defaut dans le modele), max-consensus'
      tbd 'GAP-3 : convergence d ETAT prouvee ; convergence de MISSION et brouillage RF reel NON testes — AUCUN ARTICLE TROUVE'
      evidenceLevel 'HIGH'
      maturityLevel 'MATURE'
    }
  }

  algFormationControl = algorithm 'ALG_FORMATION_CONTROL — Controle de formation' {
    #algorithm
    link https://doi.org/10.3390/app16178852 "Formation-Preserving Control for Multi-Robot Systems: Experimental Validation"
    link https://arxiv.org/abs/2410.18495 "Multi-UAV Formation Control with Static and Dynamic Obstacle Avoidance via Reinforcement Learning"
    link https://doi.org/10.1038/s41598-026-67888-x "UAV formation control for multi-target tracking based on an improved multi-agent double soft actor–critic"
    link https://arxiv.org/abs/2609.04158 "Formation Matrix and Energy-based Control of Multi-Agent Systems"
    link https://doi.org/10.5772/intechopen.1016154 "Control Strategies for Cooperative Swarm UAV Systems: Coordination, Stability and Real-World Deployment"
    link https://doi.org/10.1002/rnc.5754 "Delay-Based Feedback Formation Control for Unmanned Aerial Vehicles"
    link https://doi.org/10.20944/preprints202602.1104.v1 "Adaptive Formation Control for Multi-UAV Swarms in Cluttered Environments"
    link https://doi.org/10.3390/s26051477 "Formation Control for UAVs Considering Safety Constraints Based on Control Barrier Functions"
    link https://doi.org/10.3390/app16136554 "Multi-Agent Deep Reinforcement Learning (MADRL)-Based End-to-End Formation Control"
    description '''
      Maintien d une geometrie relative entre agents (offset de position
      ou de vitesse) sans reference centralisee.
    '''
    metadata {
      category 'coordination / formation'
      purpose 'Maintenir une formation geometrique malgre les perturbations'
      inputs 'positions relatives des voisins, geometrie cible'
      outputs 'consignes de correction de trajectoire'
      parameters 'geometrie cible, gains, distance de separation nominale'
      hypotheses 'acces a une estimation relative fiable'
      contraintes 'depend de la qualite de la perception relative'
      state 'local'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'TBD'
      evidence 'aucune source verifiee'
      metrics 'erreur de formation, temps d etablissement, energie de correction'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.mission, onboard.perception'
      relatedMessages 'MSG_FORMATION_STATE, MSG_POSITION_UPDATE'
      variantes 'leader-follower, virtuel structure, comportemental'
      evidenceLevel 'NONE'
      maturityLevel 'TBD'
    }
  }

  algLeaderElection = algorithm 'ALG_LEADER_ELECTION — Election de leader' {
    #algorithm
    link https://doi.org/10.3390/fractalfract10050315 "Resilient Leader–Follower Consensus of Fractional-Order Nonlinear Multi-Agent Systems Under Sybil and DoS Attacks via Event-Triggered Adaptive Control"
    link https://doi.org/10.1016/j.dsp.2026.106256 "Digital twin-enabled neural bandit learning for two-hop UAV relay selection"
    description '''
      Designation d un coordinateur temporaire apres perte du leader
      courant. Condition de la reconfiguration (SCN-10).
    '''
    metadata {
      category 'coordination / resilience'
      purpose 'Restaurer une autorite de coordination apres perte'
      inputs 'etat de sante des agents, identifiants, priorites'
      outputs 'identifiant du leader retenu'
      parameters 'seuil de detection de perte, priorite, timeout'
      hypotheses 'detection fiable de la perte du leader'
      contraintes 'risque de double leader sous partition'
      state 'partage'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'TBD'
      evidence 'aucune source verifiee'
      metrics 'temps d election, taux de double leader, messages echanges'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.mission, edge.coordinator'
      relatedMessages 'MSG_HEARTBEAT, MSG_FAILURE_NOTIFICATION'
      evidenceLevel 'NONE'
      maturityLevel 'TBD'
    }
  }

  // ===========================================================================
  //  B. PERCEPTION, NAVIGATION, SURETE
  // ===========================================================================

  algPerceptionFusion = algorithm 'ALG_PERCEPTION_FUSION — Fusion multi-capteurs (EKF/UKF)' {
    #algorithm
    link https://doi.org/10.3390/drones9110752 "Enabling Cooperative Autonomy in UUV Clusters: A Survey of Robust State Estimation and Information Fusion Techniques"
    link https://arxiv.org/abs/2603.08379 "Perception-Aware Communication-Free Multi-UAV Coordination in the Wild"
    link https://doi.org/10.1007/s00773-026-01144-9 "Active sonar-based perception and wall following for AUV operations"
    link https://doi.org/10.1016/j.apor.2026.105222 "Visual perception for autonomous surface vehicles in complex waterway environments"
    link https://doi.org/10.3390/s26175631 "Adaptive Localization for Underwater Nodes in Uncertain Environments: A Geometric Topology Perception-Enhanced Multi-Stage Reinforcement Learning"
    description '''
      Fusion de capteurs par filtre de Kalman etendu ou unscented.
      Local par plateforme (socle de surete), avec fusion de pistes
      au niveau Edge.
    '''
    metadata {
      category 'perception / estimation'
      purpose 'Estimer l etat de la plateforme et les pistes des voisins'
      inputs 'IMU, GNSS, odometrie, pistes relatives, pistes Edge'
      outputs 'etat estime (position, vitesse, attitude), pistes fusionnees'
      parameters 'bruits de processus/mesure, seuils de rejet d outlier'
      hypotheses 'bruits gaussiens ; linearisation acceptable (EKF)'
      contraintes 'divergence possible en cas d outliers non filtres'
      state 'estime local'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'mature-local / median multi-agents (repris du modele existant)'
      evidence 'MEDIUM — CONDITIONAL (cf SCI-4) : theorie mature ; validation surtout simulation/UUV'
      metrics 'erreur RMSE, temps de convergence, taux de fausses pistes'
      references 'Survey UUV Clusters (corpus #221, MDPI) — CONSULTEE. Validation majoritairement en SIMULATION/UUV.'
      relatedComponents 'onboard.perception, edge.fusion'
      relatedMessages 'MSG_POSITION_UPDATE, MSG_NEIGHBOR_STATE'
      variantes 'EKF, UKF, filtres particulaires'
      tbd 'GAP-4 : fusion EKF/UKF hierarchique a >=100 plateformes — AUCUN ARTICLE TROUVE. Le ~30 reel n est PAS confirme.'
      evidenceLevel 'MEDIUM'
      maturityLevel 'MATURE'
    }
  }

  algNavigationGNSSDegrade = algorithm 'ALG_NAV_GNSS_DEGRADE — Navigation sous GNSS degrade' {
    #algorithm
    link https://doi.org/10.3390/drones10010049 "DTVIRM-Swarm: A Distributed and Tightly Integrated Visual-Inertial-UWB-Magnetic System for Anchor Free Swarm Cooperative Localization"
    link https://arxiv.org/abs/2601.13657 "Communication-Free Collective Navigation for a Swarm of UAVs via LiDAR-Based Deep Reinforcement Learning"
    link https://arxiv.org/abs/2309.03678 "Fully Onboard SLAM for Distributed Mapping with a Swarm of Nano-Drones"
    link https://doi.org/10.3390/app16031412 "Learning-Based Multi-Robot Active SLAM: A Conceptual Framework and Survey"
    link https://doi.org/10.1088/1361-6501/aea4e1 "DR-TC-SLAM: A Dynamic-Interference-Aware Tightly Coupled Visual-LiDAR-Inertial SLAM"
    link https://doi.org/10.21203/rs.3.rs-10409860/v1 "A Sensor-Centric Survey of SLAM and Odometry for GPS-Denied Environments"
    description '''
      Bascule EKF (IMU + odometrie + GNSS) vers VIO en environnement
      GNSS-denied. Reduction de zone et RTL sur seuil de derive.
    '''
    metadata {
      category 'navigation / resilience'
      purpose 'Maintenir une navigation utilisable malgre la perte du GNSS'
      inputs 'IMU, odometrie, vision, etat du GNSS'
      outputs 'estimation de position degradee, declenchement de repli'
      parameters 'seuil de derive, seuil de bascule VIO, zone de repli'
      hypotheses 'derive bornee sur la duree de bascule'
      contraintes 'derive non bornee sans recalage : securite par RTL'
      state 'estime local + etat de bascule'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'mature (repris du modele existant)'
      evidence 'MEDIUM (repris du modele existant)'
      metrics 'erreur de position sous GNSS-denied, temps avant RTL'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.perception, onboard.safety, onboard.autopilot'
      relatedMessages 'MSG_POSITION_UPDATE'
      variantes 'EKF, VIO, GNSS/INS couple'
      evidenceLevel 'MEDIUM'
      maturityLevel 'MATURE'
    }
  }

  algCollisionAvoidance = algorithm 'ALG_COLLISION_AVOIDANCE — Evitement de collision (CBF)' {
    #algorithm
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    link https://arxiv.org/abs/2309.13285 "Collision Avoidance and Navigation for a Quadrotor Swarm Using End-to-end Deep Reinforcement Learning"
    link https://arxiv.org/abs/2401.14554 "GCBF+: A Neural Graph Control Barrier Function Framework for Distributed Safe Multi-Agent Control"
    link https://doi.org/10.3390/drones8080415 "Control Barrier Function-Based Collision Avoidance Guidance Strategy for Multi-UAV"
    link https://doi.org/10.1109/YAC66630.2025.11150122 "Improved Collision Cone Control Barrier Functions for Dynamic Obstacle Avoidance"
    link https://doi.org/10.1109/ACCESS.2025.3646978 "POF+MADER: Trajectory Planner in Dynamic Environments With Improved Collision Avoidance"
    link https://doi.org/10.1016/j.oceaneng.2026.127080 "Tether-aware dynamic collision avoidance for USV–HROV marine robotic systems"
    description '''
      Control Barrier Functions : garantie de non-collision sur un
      horizon court. Couche de surete embarquee NON NEGOCIABLE,
      independante du lien et de l allocation.
    '''
    metadata {
      category 'surete / evitement'
      purpose 'Garantir la non-collision locale sans dependre du reseau'
      inputs 'positions relatives, vitesses, marges de securite'
      outputs 'correction de consigne minimale preservant la securite'
      parameters 'distance minimale, horizon, parametres de barriere'
      hypotheses 'contraintes differentiellement realisables ; dynamique connue'
      contraintes 'CORRIGE E08 (SCI-2) : source primaire CA-HCBF arXiv:2604.13245 — N=30 UNIQUEMENT EN SIMULATION ; materiel reel = 5 robots ; violations residuelles 5,1 par essai a N=30'
      state 'local, sans etat partage'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'emergente (repris du modele existant)'
      evidence 'LOW — CONTREDIT par la source primaire (cf SCI-2)'
      metrics 'collisions, quasi-collisions, temps de reaction, surcout de commande'
      references 'arXiv:2604.13245 (Kim et al. 2026, CA-HCBF) — CONSULTEE'
      relatedComponents 'onboard.safety, onboard.perception, onboard.autopilot'
      relatedMessages 'MSG_COLLISION_ALERT'
      variantes 'CBF, ORCA/RVO, champs de potentiel'
      tbd 'GAP-2 ouvert : CBF heterogene au-dela de 30 en materiel reel — AUCUN ARTICLE TROUVE'
      evidenceLevel 'LOW'
      maturityLevel 'EMERGENTE'
    }
  }

  algSafetyRules = algorithm 'ALG_SAFETY_RULES — Surete par regles pre-approuvees' {
    #algorithm
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    link https://doi.org/10.1007/s11071-025-11497-2 "Comprehensive Multi-Level Optimization of Safe Swarm Motion"
    link https://doi.org/10.3390/s26175544 "Integrated Trajectory Planning, MEC Offloading, and Safety Coordination for UAV Swarms"
    description '''
      Regles et reflexes embarques, avec watchdog independant ; CBF en
      renfort. Fonctionne sans aucun lien de communication.
    '''
    metadata {
      category 'surete / autonomie minimale'
      purpose 'Garantir un comportement sur sans lien ni coordination'
      inputs 'etat de vol, frontiere de zone, seuils de derive et d energie'
      outputs 'RTL, atterrissage d urgence, gel de manoeuvre'
      parameters 'seuils de derive, frontiere geographique, seuils d energie'
      hypotheses 'capteurs essentiels encore valides'
      contraintes 'validation Monte-Carlo adversarial (N>=1000) NON faite'
      state 'local, etat de securite'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'mature (repris du modele existant)'
      evidence 'MEDIUM (repris du modele existant)'
      metrics 'declenchements corrects, fausses alertes, temps de reaction'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.safety, onboard.autopilot'
      relatedMessages 'MSG_COLLISION_ALERT, MSG_FAILURE_NOTIFICATION'
      tbd 'validation Monte-Carlo adversarial NON faite (repris du modele)'
      evidenceLevel 'MEDIUM'
      maturityLevel 'MATURE'
    }
  }

  algPathPlanning = algorithm 'ALG_PATH_PLANNING — Planification de trajectoire (waypoints + MPC)' {
    #algorithm
    link https://doi.org/10.3390/drones10030177 "Safe Swarm Navigation in Constrained Environments: A Dynamic Tube-Based Distributed MPC Approach"
    link https://arxiv.org/abs/2603.09031 "ImpedanceDiffusion: Diffusion-Based Global Path Planning for UAV Swarm Navigation with Generative Impedance Control"
    link https://arxiv.org/abs/2606.31197 "Diffusion-based 4D Trajectory Prediction and Distributed Control for UAV Swarms"
    link https://doi.org/10.1038/s41598-026-70043-1 "A comparative study of path planning algorithms for low-altitude emergency medical UAVs considering task priorities"
    link https://doi.org/10.1007/s44443-026-00976-0 "Neighborhood elite learning multi-strategy cooperative particle swarm optimization for coordinated simultaneous arrival path planning of multiple amphibious UAVs"
    link https://doi.org/10.3390/machines13070600 "Addressing Local Minima in Path Planning for Drones with Reinforcement Learning"
    link https://arxiv.org/abs/2509.15799 "Hierarchical Reinforcement Learning with Low-Level MPC for Multi-Agent Navigation"
    link https://doi.org/10.1109/LRA.2025.3619745 "SwarmGPT: Combining Large Language Models With Safe Motion Planning for Drone Swarms"
    link https://arxiv.org/abs/2609.09380 "AccelMPC: High-Rate, Low-Power FPGA-Accelerated Model Predictive Control"
    description '''
      Plan embarque versionne par defaut ; MPC court horizon au niveau
      Edge si la ressource le permet ; re-optimisation C2 differee.
    '''
    metadata {
      category 'planification'
      purpose 'Produire et maintenir une trajectoire faisable vers l objectif'
      inputs 'objectif, contraintes d espace, dynamique, obstacles'
      outputs 'trajectoire, consignes successives'
      parameters 'horizon MPC, couts, poids des contraintes'
      hypotheses 'modele dynamique suffisamment fidele'
      contraintes 're-optimisation centralisee seulement si le lien le permet'
      state 'plan local versionne'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'mature (repris du modele existant)'
      evidence 'MEDIUM (repris du modele existant)'
      metrics 'temps de calcul, faisabilite, energie consommee, ecart a l optimal'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.mission, c2.planner, edge.coordinator'
      relatedMessages 'MSG_TRAJECTORY_PROPOSAL, MSG_TRAJECTORY_UPDATE'
      variantes 'waypoints, MPC, A*, RRT*, CBS/ECBS multi-agents'
      evidenceLevel 'MEDIUM'
      maturityLevel 'MATURE'
    }
  }

  // ===========================================================================
  //  C. SURVEILLANCE, ENERGIE, TOLERANCE AUX PANNES
  // ===========================================================================

  algHealthMonitoring = algorithm 'ALG_HEALTH_MONITORING — Surveillance d etat et detection de faute' {
    #algorithm
    link https://doi.org/10.1016/j.oceaneng.2026.127355 "Adaptive NN finite-time inverse optimized formation fault-tolerant control for multi-USV systems with actuator faults"
    link https://arxiv.org/abs/2609.06257 "SeaCausal-FL: Federated Fuzzy Causal Learning for Maritime IoT Fault Detection"
    description '''
      Surveillance continue de la sante des sous-systemes, detection
      d anomalie et qualification de la degradation. Alimente la
      reconfiguration et l election de leader.
    '''
    metadata {
      category 'resilience / diagnostic'
      purpose 'Detecter une faute et qualifier la degradation avant qu elle ne devienne critique'
      inputs 'telemetrie interne, heartbeat voisins, indicateurs capteurs'
      outputs 'etat de sante, alarme de faute, qualification de degradation'
      parameters 'seuils de detection, fenetres temporelles, hysteresis'
      hypotheses 'les indicateurs internes sont observables'
      contraintes 'faux positifs et faux negatifs non caracterises'
      state 'etat de sante local + agregat Edge'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'TBD'
      evidence 'aucune source verifiee'
      metrics 'taux de detection, faux positifs, delai de detection'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.health, edge.coordinator'
      relatedMessages 'MSG_HEARTBEAT, MSG_FAILURE_NOTIFICATION'
      evidenceLevel 'NONE'
      maturityLevel 'TBD'
    }
  }

  algEnergyAware = algorithm 'ALG_ENERGY_AWARE — Planification sensible a l energie' {
    #algorithm
    link https://doi.org/10.3390/drones10090684 "An Event-Triggered Path-Based Bid Assignment Method for Energy-Aware Dynamic Multi-UAV Task Allocation"
    link https://doi.org/10.1016/j.asoc.2026.115505 "A knowledge-driven collaborative discrete Jaya algorithm for energy-efficient multi-robot task allocation and scheduling problem"
    link https://arxiv.org/abs/2609.01764 "Curriculum-Guided Reinforcement Learning for Energy-Efficient UAV-ISAC in Post-Disaster Search-and-Rescue Operations"
    link https://doi.org/10.3389/fmars.2026.1865602 "Neuro-symbolic framework for multi-USV coordination: COLREGs-compliant energy-aware control"
    link https://doi.org/10.3390/jmse14040384 "System-Level Optimization of AUV Swarm Control and Perception: An Energy-Aware Approach"
    link https://doi.org/10.1007/s11370-022-00452-4 "Research on energy-efficient swarm drone control"
    description '''
      Arbitrage entre couverture, duree et marge de repli. Conditionne
      la faisabilite de toute mission longue et la comparaison de
      variantes algorithmiques (V5).
    '''
    metadata {
      category 'optimisation / endurance'
      purpose 'Maximiser la valeur de mission sous contrainte d energie residuelle'
      inputs 'etat de charge, consommation estimee, objectifs'
      outputs 'arbitrage de mission, planification de repli'
      parameters 'marge de securite, seuils de retour, couts energetiques'
      hypotheses 'consommation previsible a court terme'
      contraintes 'modele energetique a calibrer'
      state 'local'
      executionMode 'conceptual'
      implementationStatus 'idea'
      repository 'TBD'
      version 'TBD'
      maturity 'TBD'
      evidence 'aucune source verifiee'
      metrics 'endurance, couverture realisee, marge de repli restante'
      references 'aucune source verifiee dans cette session'
      relatedComponents 'onboard.mission, onboard.autopilot'
      relatedMessages 'MSG_MISSION_COMMAND'
      evidenceLevel 'NONE'
      maturityLevel 'TBD'
    }
  }

  // ===========================================================================
  //  D. RELATIONS CATALOGUE -> ARCHITECTURE
  //     Relie chaque algorithme a son composant d accueil et a ses
  //     familles algorithmiques existantes (architecture.c4).
  // ===========================================================================

  onboard.taskAuction -[implements]-> algTaskAllocation 'algorithme d allocation'
  onboard.taskAuction -[implements]-> algConsensus 'consensus des encheres'
  onboard.mission -[uses]-> algPathPlanning 'planification de mission'
  onboard.mission -[uses]-> algFormationControl 'maintien de formation'
  onboard.mission -[uses]-> algEnergyAware 'arbitrage energetique'
  onboard.mission -[uses]-> algLeaderElection 'reconfiguration apres perte'
  onboard.perception -[implements]-> algPerceptionFusion 'fusion multi-capteurs'
  onboard.perception -[implements]-> algNavigationGNSSDegrade 'navigation degradee'
  onboard.safety -[implements]-> algCollisionAvoidance 'evitement de collision'
  onboard.safety -[implements]-> algSafetyRules 'regles de surete'
  onboard.health -[implements]-> algHealthMonitoring 'surveillance d etat'
  edge.coordinator -[uses]-> algTaskAllocation 'allocation au niveau Edge'
  edge.coordinator -[uses]-> algConsensus 'consensus Edge'

  // ===========================================================================
  //  E25 — ENRICHISSEMENT DES ALGORITHMES PAUVRES (carte t_97fefb21)
  //  Uniquement ADDITIF. Sens de `evidences` conforme au metamodele :
  //  constat -[evidences]-> algorithme (aucun `evidences` inverse ajoute).
  // ===========================================================================

  algPathPlanning -[uses]-> msgTrajectoryProposal 'proposition de trajectoire a negocier'
  algPathPlanning -[uses]-> msgTrajectoryUpdate 'trajectoire retenue en execution'
  algPathPlanning -[uses]-> scn01 'mission nominale sans C2'

  algLeaderElection -[uses]-> msgConsensusVote 'vote d election distribue'
  algLeaderElection -[exposed-to]-> blindspotAM12 'agent defaillant / double leader'

  algSafetyRules -[uses]-> msgCollisionAlert 'alerte consommee par la voie de surete'
  algSafetyRules -[exposed-to]-> blindspotAM5 'validation d echelle non couverte'

  // === E26 — LIENS ALGORITHMES <-> COMPOSANTS + SPECIFICATIONS DETAILLEES ===
  // 1. Element de type specDoc : stocke les liens vers les
  //    differentes versions du document de specification detaillee.
  // 2. Relations algorithm -> component (sens `runsOn` manquant).
  // =========================================================================

  specTaskAllocation = specDoc 'Specification detaillee — ALG_TASK_ALLOCATION (4 versions)' {
    #source-doc
    link https://likec4.breizh.ai/Spec_ALG_TASK_ALLOCATION_V3.pdf "Specification detaillee Task Allocation v3 (PDF) — version anterieure"
    link https://likec4.breizh.ai/Spec_ALG_TASK_ALLOCATION_V2.pdf "Specification detaillee Task Allocation v2 (PDF) — version anterieure"
    link https://likec4.breizh.ai/Spec_ALG_TASK_ALLOCATION_CBBA.pdf "Specification detaillee CBBA (PDF, v1.1) — version initiale"
    description 'Document de specification detaillee de l algorithme d allocation de taches. Quatre versions successives conservees : CBBA v1.1 (initiale), v2, v3, v4 (couche operationnelle, loop engineering).'
    metadata {
      algorithme 'ALG_TASK_ALLOCATION'
      versions '4 (CBBA v1.1, v2, v3, v4)'
      versionCourante 'v4 (2026-09-20)'
      nature 'specification genie logiciel interne'
      statut 'DISPONIBLE'
    }
  }

  algTaskAllocation -[documentedBy]-> specTaskAllocation 'specification detaillee (4 versions)'

  // E29 : portage Rust de l algorithme. LikeC4 REFERENCE le code, il ne le
  // contient pas (cf metamodel.c4, type sourceCode).
  //
  // Architecture multi-depots (2026-09-20) : le code de l algorithme vit
  // desormais dans son propre depot `alg-task-allocation`, rattache au depot
  // principal `SwarmDrones` en tant que Git submodule (algorithms/task-allocation).
  srcAlgTaskAllocation = sourceCode 'alg-task-allocation — portage Rust de ALG_TASK_ALLOCATION' {
    #source-code
    link https://github.com/dagornc/alg-task-allocation "Depot GitHub alg-task-allocation — code source du portage Rust (task_alloc_rs)"
    link https://github.com/dagornc/SwarmDrones "Depot principal SwarmDrones — agregateur de la solution A (submodule algorithms/task-allocation)"
    description 'Portage Rust de l algorithme ALG_TASK_ALLOCATION (ED-CBBA evenementiel v3 + resilience a la partition + allocation apprise). Le code vit dans le depot dedie https://github.com/dagornc/alg-task-allocation, rattache au depot principal https://github.com/dagornc/SwarmDrones en tant que Git submodule (chemin algorithms/task-allocation). Parite bit-a-bit verifiee avec la reference Python normative reference/sim_task_alloc.py : 180/180 comparaisons identiques (30 graines x 6 scenarios), 0 ecart. 37 tests passent (26 unitaires + 11 d integration). Trois variantes d implementation coexistent, emboitees v3 ⊃ v2 ⊃ v1 : v1 (CBBA standard, emission a chaque periode), v2 (ED-CBBA, emission seulement si l etat publie change), v3 (ED-CBBA + heartbeat/quorum + biais appris beta). Proprietes de non-regression testees : beta=0 ⟹ v2 ; evenementiel=false ⟹ v1 ; resilience=false ⟹ aucune detection de partition. Reduction de messages mesuree sur horizon complet : 95.8 % (82 775 messages contre 1 960 000 pour v1, sur 100 graines). Structure : src/rng.rs (RNG deterministe compatible CPython), src/sim.rs (coeur du simulateur ED-CBBA v3), src/evenementiel.rs (v2, logique de communication evenementielle), src/partition.rs (v3, heartbeat, quorum, degradation/re-fusion), src/main.rs (CLI compatible sim_task_alloc.py), tests/parite.rs (tests d integration T1-T8 + invariants), reference/sim_task_alloc.py (reference Python normative), verify_parite_rust.py (harnais de verification Rust vs Python). Triangle de verification : sim.rs (implementation), reference/sim_task_alloc.py (norme executable), verify_parite_rust.py (preuve de conformite) — aucune modification de l algorithme n est recevable sans que les trois restent alignes.'
    metadata {
      algorithme 'ALG_TASK_ALLOCATION'
      langage 'Rust (edition 2024, zero dependance externe)'
      depot 'https://github.com/dagornc/alg-task-allocation'
      depotPrincipal 'https://github.com/dagornc/SwarmDrones'
      integration 'Git submodule — algorithms/task-allocation'
      variantes 'v1 (CBBA standard) ; v2 (ED-CBBA evenementiel) ; v3 (ED-CBBA + resilience partition + biais appris) ; v4 (couche operationnelle, loop engineering)'
      versionsImplementation 'v1 ; v2 ; v3 ; v4 (emboitees v4 ⊃ v3 ⊃ v2 ⊃ v1)'
      parite 'bit-a-bit avec reference/sim_task_alloc.py — 180/180 comparaisons, 0 ecart'
      tests '37/37 sur master (v1 : 26 unitaires + 11 d integration) ; 43/43 sur v2 ; 50/50 sur v3 ; 81/81 sur v4 (70 unitaires + 11 d integration)'
      performance 'reduction de messages 95.8 % sur horizon complet (82 775 contre 1 960 000 pour v1, 100 graines)'
      scenariosVerifies 'nominal, perte, retrait, partition, duplication, latence'
      limites 'partition asymetrique silencieuse non couverte ; biais appris g_theta = sin(i+j) deterministe (support de test, pas une politique apprise) ; topologie fixe (grille), mobilite non simulee'
      licence 'MIT — Copyright (c) 2026 Christophe Dagorn'
      nature 'portage de reference'
      statut 'PUBLIE'
    }
  }

  // Le code implemente l algorithme et est documente par la specification.
  srcAlgTaskAllocation -[implements]-> algTaskAllocation 'portage Rust de reference (parite bit-a-bit)'
  srcAlgTaskAllocation -[documentedBy]-> specTaskAllocation 'specification detaillee (3 versions)'

  specConsensus = specDoc 'Specification detaillee — ALG_CONSENSUS (5 versions)' {
    #source-doc
    link https://likec4.breizh.ai/Specification_ALG_CONSENSUS_v1.pdf "Specification detaillee Consensus d etat d essaim v1 (PDF) — version anterieure"
    link https://likec4.breizh.ai/Specification_ALG_CONSENSUS_v2.pdf "Specification detaillee Consensus d etat d essaim v2 (PDF) — version anterieure"
    link https://likec4.breizh.ai/Specification_ALG_CONSENSUS_v3.pdf "Specification detaillee Consensus d etat d essaim v3 (PDF) — version anterieure"
    link https://likec4.breizh.ai/Specification_ALG_CONSENSUS_v4.pdf "Specification detaillee Consensus d etat d essaim v4 (PDF) — version rejetee (11,7/20, 2 bloquants, 9 majeurs — regression documentee)"
    link https://likec4.breizh.ai/Specification_ALG_CONSENSUS_v5.pdf "Specification detaillee Consensus d etat d essaim v5 (PDF) — version courante (19,1/20, PUBLIABLE SANS RESERVE, cycles 7-11 appliques)"
    description 'Document de specification detaillee de l algorithme de consensus d etat d essaim (CRDT semi-treillis + gossip). Reference SWARM-SPEC-ALG-002. Cinq versions conservees : v1.0 (initiale), v2.0, v3.0, v4.0 (rejetee), v5.0 (courante). Validation independante : v1 10,5/20 ; v2 14,0/20 ; v3 18,0/20 ; v4 11,7/20 REJETEE (2 bloquants, 9 majeurs — regression documentee, pas une reference) ; v5 19,1/20 PUBLIABLE SANS RESERVE (re-validations t_452f080c, t_612232cc, t_1c3b7ab8, t_e13fc0f2, t_024a2130 puis t_3481a86d ; cycles 7-11 appliques : D-V5B-1 corrige — re-fusion mesuree a 3 periodes via T5D ; D-V5C-1 corrige — le retrait d agents, declare a t=500 mais jamais execute (boucle bornee a 200 periodes), est desormais applique a t=3, T8 = 98/100 ; D-V5C-2 — colonne divergence_reelle corrigee, T5 = 35/100 ; cycle 9 — D-V5D-1 chiffre 79/100 errone retire, D-V5D-2 echecs T8 attribues a la deconnexion topologique du graphe, D-V5D-3 ventilation des barres corrigee ; cycle 10 — 4 observations de forme V5E traitees : changelog S15, mention immediate S15, colonne taille_etat exacte (27 pour 97 graines), divulgation de la couverture des tests ; cycle 11 — R1 resultats_T8.csv regenere et verifie byte-identique a un run frais (taille_etat 27x97 + 30x3), R2 phrase explicite de couverture du harnais ajoutee en section 4.7.1).'
    metadata {
      algorithme 'ALG_CONSENSUS'
      versions '5 (v1.0, v2.0, v3.0, v4.0, v5.0)'
      versionCourante 'v5.0 (2026-09-19) — PUBLIABLE SANS RESERVE (19,1/20)'
      versionRejetee 'v4.0 — 11,7/20 (2 bloquants, 9 majeurs)'
      notesValidation 'v1 10,5/20 ; v2 14,0/20 ; v3 18,0/20 ; v4 11,7/20 ; v5 19,1/20 (PUBLIABLE SANS RESERVE)'
      nature 'specification genie logiciel interne'
      statut 'DISPONIBLE'
    }
  }

  algConsensus -[documentedBy]-> specConsensus 'specification detaillee (5 versions)'

  // E29 : portage Rust de l algorithme. LikeC4 REFERENCE le code, il ne le
  // contient pas (cf metamodel.c4, type sourceCode).
  //
  // Architecture multi-depots (2026-09-20) : le code de l algorithme vit
  // desormais dans son propre depot `alg-consensus`, rattache au depot
  // principal `SwarmDrones` en tant que Git submodule (algorithms/consensus).
  srcConsensusRs = sourceCode 'consensus_rs — portage Rust de ALG_CONSENSUS' {
    #source-code
    link https://github.com/dagornc/alg-consensus "Depot GitHub alg-consensus — code source du portage Rust (consensus_rs)"
    link https://github.com/dagornc/SwarmDrones "Depot principal SwarmDrones — agregateur de la solution A (submodule algorithms/consensus)"
    link https://likec4.breizh.ai/consensus_rs/README.md "README du portage Rust (parite bit-a-bit avec la reference Python)"
    description 'Portage Rust de l algorithme ALG_CONSENSUS (CRDT semi-treillis + gossip). Le code vit dans le depot dedie https://github.com/dagornc/alg-consensus, rattache au depot principal https://github.com/dagornc/SwarmDrones en tant que Git submodule (chemin algorithms/consensus). Parite bit-a-bit verifiee avec la reference Python sim_consensus.py : 9 000 comparaisons (9 tests x 1 000 graines), 0 ecart. 30/30 tests passent. Trois versions d implementation coexistent sur des branches dediees : v1 (master, comportement historique), v2 (branche v2, reconnexion des agents isoles), v3 (branche v3, quiescence par loop engineering). Notation /20 : v1 15,7 ; v2 16,3 ; v3 19,5. Structure : src/rng.rs (RNG compatible CPython), src/sim.rs (etat, fusion semi-treillis, gossip, harnais T1-T9), src/reconnexion.rs (v2), src/quiescence.rs (v3), src/main.rs (CLI compatible sim_consensus.py, flags --v2 et --v3), tests/parite.rs (5 tests de parite CPython), reference/sim_consensus.py (reference Python embarquee), verify_parite_rust.py (comparaison automatique Rust vs Python).'
    metadata {
      algorithme 'ALG_CONSENSUS'
      langage 'Rust (edition 2024, rustc 1.98.1)'
      depot 'https://github.com/dagornc/alg-consensus'
      depotPrincipal 'https://github.com/dagornc/SwarmDrones'
      integration 'Git submodule — algorithms/consensus'
      branches 'master (v1) ; v2 (reconnexion des agents isoles) ; v3 (quiescence) ; v4 (couche operationnelle) ; v5 (moteur optimise)'
      versionsImplementation 'v1 (master) ; v2 (branche v2) ; v3 (branche v3) ; v4 (branche v4) ; v5 (branche v5)'
      notesVersions 'v1 15,7/20 ; v2 16,3/20 ; v3 19,5/20'
      parite 'bit-a-bit avec sim_consensus.py — 9 000 comparaisons, 0 ecart'
      tests '18/18 sur master (v1 : 13 unitaires + 5 de parite CPython) ; 30/30 sur v3 (25 unitaires + 5 de parite) ; 62/62 sur v4 ; 68/68 sur v5'
      performance 'environ 21x plus rapide que Python (7 647 sim/s contre 352 sim/s)'
      nature 'portage de reference'
      statut 'PUBLIE'
    }
  }

  // Le code implemente l algorithme et est documente par la specification.
  srcConsensusRs -[implements]-> algConsensus 'portage Rust de reference (parite bit-a-bit)'
  srcConsensusRs -[documentedBy]-> specConsensus 'specification detaillee (5 versions)'

  // --- Relations algorithm -> component (sens `runsOn` manquant) ---
  algEventTriggeredComm -[runsOn]-> onboard.linkRadio 'politique d emission evenementielle (cf onboard.linkRadio -[implements]->)'
  algCooperativeLocalization -[runsOn]-> onboard.perception 'localisation relative (cf onboard.perception -[implements]->)'
  algFaultTolerantControlAlloc -[runsOn]-> onboard.autopilot 'commande tolerante (cf onboard.autopilot -[implements]->)'
  algJammingResilientMode -[runsOn]-> onboard.mission 'superviseur de mode (cf onboard.mission -[implements]->)'

  // ===========================================================================
  //  F. LIENS DECLARES MAIS ABSENTS (audit 2026-09-21)
  //     Chaque algorithme porte une metadonnee `relatedComponents` qui declare
  //     les composants auxquels il se rattache. 10 de ces liens declares
  //     n'avaient AUCUNE relation dans le modele : la carte affichait donc un
  //     composant lie dans sa fiche, mais aucun arc sur le diagramme.
  //     On materialise ici le sens composant -> algorithme (`implements`),
  //     conforme au metamodele, pour les paires declarees et manquantes.
  //     `onboard.resilience` (declare par algTaskAllocation) n'existe pas comme
  //     composant : lien fantome, NON materialise — a arbitrer cote modele.
  // ===========================================================================

  // algCollisionAvoidance : onboard.perception, onboard.autopilot
  onboard.perception -[implements]-> algCollisionAvoidance 'detection d obstacles en amont'
  onboard.autopilot -[implements]-> algCollisionAvoidance 'execution des manoeuvres d evitement'

  // algNavigationGNSSDegrade : onboard.safety, onboard.autopilot
  onboard.safety -[implements]-> algNavigationGNSSDegrade 'seuils de repli en navigation degradee'
  onboard.autopilot -[implements]-> algNavigationGNSSDegrade 'pilotage en mode degrade'

  // algSafetyRules : onboard.autopilot
  onboard.autopilot -[implements]-> algSafetyRules 'application des regles pre-approuvees'

  // algEnergyAware : onboard.autopilot
  onboard.autopilot -[implements]-> algEnergyAware 'arbitrage energetique en vol'

  // algFormationControl : onboard.perception
  onboard.perception -[implements]-> algFormationControl 'estimation relative pour le maintien de formation'

  // algJammingResilientMode : onboard.perception
  onboard.perception -[implements]-> algJammingResilientMode 'detection de degradation du signal'

  // algHealthMonitoring : edge.coordinator
  edge.coordinator -[implements]-> algHealthMonitoring 'surveillance d etat au niveau Edge'

  // algLeaderElection : edge.coordinator
  edge.coordinator -[implements]-> algLeaderElection 'election de coordinateur apres perte'

  // algPathPlanning : edge.coordinator
  edge.coordinator -[implements]-> algPathPlanning 'replanification au niveau Edge'

  // algFaultTolerantControlAlloc : onboard.health
  onboard.health -[implements]-> algFaultTolerantControlAlloc 'etat de sante des actionneurs'

  // ===========================================================================
  //  G. SPEC-13-LIKE (carte t_06cd10ec) — LIAISON DES ARTEFACTS SOEURS
  //
  //  Specs PDF : 13 PDF v1 dans specification/ (SPEC-13-PUBLISH t_79a5637b +
  //    complement e137723). 7 VALIDEES ; 6 REJETEES par leur rapport de
  //    validation (2-6/20, defauts BLOQUANTS) mais poussees quand meme par le
  //    commit e137723, CONTRE l exclusion decidee par SPEC-13-PUBLISH.
  //    Le lien est reel, la carte specDoc porte le statut REJETEE : aucun
  //    rejet n est masque (cf specDoc.*.validation).
  //
  //  SysML v2 (SYSML-15, t_d671a500) : relations algX -[documentedBy]-> sysmlX
  //    deja portees par sysml.c4 — NON dupliquees ici (cf note parente).
  //
  //  Portages Rust (RUST-13, t_8ed8aa02) : 13 depots publics dagornc/alg-<slug>.
  //    Metadonnees (parite/tests/limites) lues dans les README reels des depots,
  //    verifiees le 2026-09-28. Aucune valeur inventee.
  // ===========================================================================

