  sciLiDARDRLNav -[evidences]-> algNavigationGNSSDegrade 'navigation collective sans GNSS ni communication (leader-follower implicite)'
  sciLiDARDRLNav -[evidences]-> algFormationControl 'flocking emergent par DRL (leader-follower)'
  sciLiDARDRLNav -[evidences]-> algCollisionAvoidance 'evitement d obstacles appris, equilibre flocking/evitement'
  sciLiDARDRLNav -[uses]-> srcLiDARDRLNav 'source primaire'

  sciDelayFeedbackForm -[evidences]-> algFormationControl 'maintien de formation par retour retarde + feedforward'
  sciDelayFeedbackForm -[uses]-> srcDelayFeedbackForm 'source primaire'

  sciFederatedIDS -[evidences]-> algJammingResilientMode 'detecteur d intrusion federe alimentant la bascule de mode sous adversite'
  sciFederatedIDS -[uses]-> srcFederatedIDS 'source primaire'

  sciKhatibAPF -[evidences]-> algCollisionAvoidance 'evitement reactif par champs de potentiel artificiels'
  sciKhatibAPF -[evidences]-> algPathPlanning 'APF comme planification repartie entre niveaux de controle'
  sciKhatibAPF -[uses]-> paperKhatib1986 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciPSO -[evidences]-> algTaskAllocation 'optimiseur PSO alternatif pour l allocation de taches'
  sciPSO -[evidences]-> algPathPlanning 'optimiseur PSO alternatif pour la planification de trajectoire'
  sciPSO -[uses]-> paperKennedy1995 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciEventTriggeredDimarogonas -[evidences]-> algEventTriggeredComm 'emission sur franchissement de seuil, borne d erreur inter-evenements'
  sciEventTriggeredDimarogonas -[uses]-> paperDimarogonas2012 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciBroadcastStorm -[evidences]-> algEventTriggeredComm 'justification negative du broadcast periodique (tempete de broadcast)'
  sciBroadcastStorm -[uses]-> paperTseng2002 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciAcousticConstraint -[evidences]-> algEventTriggeredComm 'communication parcimonieuse sous contrainte de debit (transfert methodologique)'
  sciAcousticConstraint -[uses]-> paperAkyildiz2005 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciConsensusFramework -[evidences]-> algConsensus 'cadre unifie du consensus distribue en reseau'
  sciConsensusFramework -[evidences]-> algFormationControl 'flocking/rendez-vous par consensus'
  sciConsensusFramework -[uses]-> paperOlfatiSaber2007 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciPacketLossStability -[evidences]-> algConsensus 'robustesse de stabilite du consensus sous pertes de paquets'
  sciPacketLossStability -[uses]-> paperHuYan2007 'source primaire (declarée scientificPaper dans hzip.c4)'

  sciBoids -[evidences]-> algFormationControl 'flocking par regles locales (separation/alignement/cohesion)'
  sciBoids -[evidences]-> algCollisionAvoidance 'regle de separation = evitement local'
  sciBoids -[uses]-> paperReynolds1987 'source primaire (declarée scientificPaper dans hzip.c4)'
