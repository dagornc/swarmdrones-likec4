  srcGRFSwarmOptCtrl = specDoc 'Distributed Stochastic Optimal Control for Pattern-Oriented Swarms (2026)' {
    #science
    link https://arxiv.org/abs/2609.12959 "Distributed Stochastic Optimal Control for Pattern-Oriented Swarms"
    description '''
      Cadre de commande optimale stochastique fonde sur les champs aleatoires gaussiens (GRF) etendu au domaine temporel : la coordination collective est formulee comme une inference bayesienne, permettant a l essaim d absorber l incertitude environnementale, de satisfaire des contraintes non convexes et de reconcilier des dynamiques heterogenes. Module d evitement de collision conscient de l incertitude et de la surete sous mouvement stochastique des obstacles (transformee unscented pour propager l incertitude des obstacles dynamiques et des voisins).
    '''
    metadata { arxiv '2609.12959'; annee '2026'; nature 'preprint'; corpus '1401'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

  // ===========================================================================
  //  2. VERDICTS — une affirmation, un verdict, une raison
