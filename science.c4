  srcTriSAR = specDoc 'TriSAR: Task Coordination and Collision Avoidance for Aerial Robot Teams in Disaster Response (2026)' {
    #science
    link https://arxiv.org/abs/2609.01731 "TriSAR: Task Coordination and Collision Avoidance for Aerial Robot Teams in Disaster Response"
    description '''
      Systeme de coordination a 5 UAV en simulation Gazebo d un environnement urbain endommage par seisme : plan factoriel 2x2 comparant deux strategies d allocation de taches (algorithme genetique vs allocation gloutonne) avec evitement de collision reactif active/desactive. 30 episodes stochastiques, 5 UAV / 8 cibles. La repulsion elimine les violations de seuil de collision (Mann-Whitney) ; caracterise les contributions individuelles et combinees des couches de coordination.
    '''
    metadata { arxiv '2609.01731'; annee '2026'; nature 'preprint'; corpus '594'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

  srcPeukertRouting = specDoc 'Certified-Robust Multi-Objective UAV Routing for Military Resupply under Nonlinear Energy Dynamics (2026)' {
    #science
    link https://doi.org/10.21203/rs.3.rs-10941530/v1 "Certified-Robust Multi-Objective UAV Routing for Military Resupply under Nonlinear Energy Dynamics"
    description '''
      Routage robuste tri-objectif (duree, risque sous ensemble d incertitude budgetise, deficit d energie terminal) pour resupply militaire : l energie de batterie suit la LOI DE PEUKERT (depletion NON lineaire) au lieu d un cout lineaire. PINN adaptatif (trunk partage, tete d affectation + tete d energie) entraine contre le residu de la loi de Peukert. Preprint Research Square (non relu par les pairs).
    '''
    metadata { doi '10.21203/rs.3.rs-10941530/v1'; annee '2026'; nature 'preprint (Research Square)'; corpus '2293'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

  srcHamiltonianFormation = specDoc 'Energy-Conserving Swarm Formation Control Using Pure Hamiltonian Mechanics and Active Braking (2026)' {
    #science
    link https://doi.org/10.21203/rs.3.rs-10520167/v1 "Energy-Conserving Swarm Formation Control Using Pure Hamiltonian Mechanics and Active Braking"
    description '''
      Formation d essaim 3D conservant l energie sur terrains non plats : potentiel de navigation Rimon-Koditschek (RK) modifie (mise a l echelle verticale anisotrope) embarque dans un cadre dynamique pseudo-Hamiltonien, gradients de potentiel mappes en profils d acceleration lisses ; freinage actif pour preserver l integrite de l essaim. Surmonte les minima locaux des champs de potentiel classiques. Preprint Research Square.
    '''
    metadata { doi '10.21203/rs.3.rs-10520167/v1'; annee '2026'; nature 'preprint (Research Square)'; corpus '2306'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
