  srcEscapeCBF = specDoc 'Escape-Aware Control Barrier Functions for Quadrotor Safety under Body-Rate Limits (2026)' {
    #science
    link https://arxiv.org/abs/2609.17292 "Escape-Aware Control Barrier Functions for Quadrotor Safety under Body-Rate Limits"
    description '''
