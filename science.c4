  srcEventDrivenCBBA = specDoc 'Event Driven CBBA with Reduced Communication (2025)' {
    #science
    link https://arxiv.org/abs/2509.06481 "Event Driven CBBA with Reduced Communication"
    description '''
      CBBA declenche par evenement pour reduire la communication : le CBBA classique exige une communication continue (congestion, pertes). Mecanisme de communication event-driven qui maintient la convergence ET les bornes de performance du CBBA — qualite de solution EGALE a CBBA prouvee theoriquement, validee par simulations Monte-Carlo sur tailles de flotte et portees variables.
    '''
    metadata { arxiv '2509.06481'; annee '2025'; nature 'preprint'; corpus '211'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

  srcCCOPI = specDoc 'CC-OPI: Online Distributed Task Allocation for UAV Swarms under Communication Constraints (2026)' {
    #science
    link https://arxiv.org/abs/2609.19208 "CC-OPI: Online Distributed Task Allocation for UAV Swarms under Communication Constraints"
    description '''
      Allocation de taches distribuee en ligne SOUS CONTRAINTE DE COMMUNICATION : quand la portee courte fragmente l essaim en ilots d information transitoires, le paradigme « allouer-puis-executer » (consensus global avant tout mouvement) s effondre. CC-OPI entrelace la NEGOCIATION de taches et l EXECUTION physique : replanification seulement aux evenements physiques/topologiques discrets, metriques de cout adaptees aux topologies dynamiques (penalite de localite spatiale, urgence deadline-aware), verrou d etat non-preemptif.
    '''
    metadata { arxiv '2609.19208'; annee '2026'; nature 'preprint'; corpus '1590'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

  srcAPR = specDoc 'Assignment-Preserving Replanning for Dynamic Task Allocation in Multi-UAV Systems (2026)' {
    #science
    link https://doi.org/10.3390/app16199414 "Assignment-Preserving Replanning for Dynamic Task Allocation in Multi-UAV Systems"
    description '''
      Replanification PRESERVANT L AFFECTATION (APR) pour l allocation dynamique : au lieu du replanning global (qui casse des affectations encore valides), APR herite l etat operationnel, partitionne les taches inachevees en directement affectees / initialement non affectees, protege les affectations valides et la structure de route, puis ne libere que les taches protegees en conflit si la faisabilite ne peut etre retablie. Evaluee contre repair constructif, replanning partiel et deux methodes globales.
    '''
    metadata { doi '10.3390/app16199414'; annee '2026'; nature 'article de revue (Applied Sciences)'; corpus '2278'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

