  srcEGOSwarm = specDoc 'EGO-Swarm: A Fully Autonomous and Decentralized Quadrotor Swarm System in Cluttered Environments (2020)' {
    #science
    link https://arxiv.org/abs/2011.04183 "EGO-Swarm: A Fully Autonomous and Decentralized Quadrotor Swarm System in Cluttered Environments"
    description '''
      Navigation d essaim de quadrirotors entierement autonome et decentralisee en environnement encombre inconnu, en ressources embarquees uniquement : planification locale par optimisation NON LINEAIRE (le risque de collision est une penalite), generation de trajectoires topologiques legere pour echapper aux minima locaux, trajectoires sures et dynamiquement realisables en quelques millisecondes, correction de la derive de localisation relative par detection d agents dans les images de profondeur. Valide en simulation ET en conditions reelles.
    '''
    metadata { arxiv '2011.04183'; annee '2020'; nature 'preprint (IEEE RA-L 2021)'; corpus '915'; statut 'CONSULTEE (abstract lu, 2026-09-29)' }
  }

