  srcCrossDomainASW = specDoc 'Wang et al. (2024) — Recherche anti-sous-marine cooperative inter-domaines' {
    #science
    link https://doi.org/10.16182/j.issn1004731x.joss.23-0073 "Research on Cross-domain Unmanned Swarm Cooperative Anti-submarine Search Method"
    description 'Journal of System Simulation 2024. Methode de recherche anti-sous-marine cooperative inter-domaines (aerien + surface) : l USV sert de relais de communication pour l UAV ; carte-grille numerique de la zone ; modele cinematique des plateformes inter-domaines ; MECANISME DE FUSION D INFORMATION DISTRIBUEE entre les systemes sans pilote ; fonction objectif de recherche guidant la decision temps reel des plateformes heterogenes. Validation EN SIMULATION uniquement.'
    metadata { doi '10.16182/j.issn1004731x.joss.23-0073'; annee '2024'; nature 'article de revue'; corpus '#128'; statut 'CONSULTEE (resume lu, CNKI)' }
  }
  srcSwarmUSV = specDoc 'Singh (2019) — Cooperative Swarm Optimisation of Unmanned Surface Vehicles (these, Plymouth)' {
    #science
    link https://doi.org/10.24382/1174 "Cooperative Swarm Optimisation of Unmanned Surface Vehicles"
    description 'These de doctorat (Yogang Singh, University of Plymouth, janvier 2019, PEARL — DOI verifie 2026-09-29). Cadre hybride de navigation cooperative d une flotte d USV en environnement maritime contraint, integrant trois modules : (1) planification de chemin optimale par algorithme A* avec distance de securite aux obstacles (obstacles mobiles ET courants de surface) ; (2) guidage par poursuite de chemin « virtual target » alimente par la trajectoire de reference du planificateur ; (3) AGREGATION D ESSAIM DECENTRALISEE par fonctions de potentiel attraction/repulsion pour maintenir le CENTROIDE de l essaim et le guider sur le chemin de reference. Validation sur USV uniquement (surface), aucune plateforme aerienne, flotte de petite taille (pas de N=30).'
    metadata { doi '10.24382/1174'; annee '2019'; nature 'these de doctorat'; corpus '#130'; statut 'CONSULTEE (abstract + PEARL Plymouth, DOI verifie)' }
  }
  srcDigitalTwinZEST = specDoc 'Digital Twin Concept in the Zero Emission Sea Transporter (2024)' {
    #science
    link https://arxiv.org/abs/2408.02277 "Integrating a Digital Twin Concept in the Zero Emission Sea Transporter (ZEST) Project"
    description '''
      ECARTEE (abstract lu, 2026-09-29). Le projet ZEST (Zero Emission
      Sea Transporter) developpe un CATAMARAN de transport court-courrier
      zero emission, motive par les cibles de decarbonation de l OMI et
      du paquet Fit for 55 ; le jumeau numerique y est un outil de
      validation (simulateur marin Stonefish) d un NAVIRE DE TRANSPORT
      unique, pas d un essaim. AUCUN des algorithmes du catalogue du
      modele (allocation, consensus, formation, election, perception,
      navigation, evitement, surete, planification, sante, energie) n est
      etaye par ce document : pas d allocation multi-agents, pas de fusion
      de capteurs, pas de controle de formation. Le jumeau numerique du
      MODELE (CAP_OBSERVE / FN_DIGITAL_TWIN = telemetrie / rejeu d un
      essaim aerien+surface) est DEJA source par ailleurs (functional.c4,
      DOI 10.6109/jkiice.2026.30.8.1408, C2 USV swarm + validation par
      jumeau). Rattacher ZEST serait un rattachement de complaisance :
      meme concept, domaine et objet differents.
    '''
    metadata { arxiv '2408.02277'; annee '2024'; nature 'preprint'; corpus '#134'; statut 'ECARTEE' }
  }
  srcCoverageCentral = specDoc 'Jamshidpey et al. (2025) — Centralization vs. decentralization in multi-robot sweep coverage' {
    #science
    link https://arxiv.org/abs/2408.06553 "Centralization vs. decentralization in multi-robot sweep coverage with ground robots and UAVs"
    link https://doi.org/10.1007/s10015-025-01049-7 "Centralization vs. decentralization in multi-robot sweep coverage with ground robots and UAVs (Artificial Life and Robotics, 2025)"
    description 'Comparaison empirique centralise vs decentralise sur une tache de sweep coverage : 5 structures de controle (marche aleatoire, decentralise a balises, formation hybride auto-organisante, formation centralisee, trajectoires predeterminees). Robots au sol assistes d UAV superviseurs/balises. Avantage centralise : completude, uniformite, temps de couverture. Avantage decentralise : scalabilite (4/8/16 robots) et tolerance aux fautes (0-75% de perte).'
    metadata { arxiv '2408.06553'; doi '10.1007/s10015-025-01049-7'; annee '2024'; nature 'article de revue (Artificial Life and Robotics 2025)'; corpus '#135'; statut 'CONSULTEE (abstract lu — arXiv v4 + DOI Crossref verifie)' }
  }
  srcCBFMultiFixed = specDoc 'CBF-Based Collision Avoidance for Multi-Fixed-Wing UAV Pursuit (2024)' {
    #science
    link https://doi.org/10.3390/drones8080415 "Control Barrier Function-Based Collision Avoidance Guidance Strategy for Multi-Fixed-Wing UAV Pursuit-Evasion Environment"
    description 'CBF d ordre superieur (HOCBF) pour l evitement de collision multi-UAV a voilure fixe en poursuite-evasion n-sur-n / n-sur-1 (Lv, Peng, Ma — NUDT, Drones 8(8):415). Contraintes HOCBF multiples fusionnees en une contrainte lineaire, resolution QP en forme fermee (guidage nominal + terme d evitement). SIMULATION 2D uniquement, aucun materiel reel. Complementaire de srcCAHCBF (multirotors).'
    metadata { doi '10.3390/drones8080415'; annee '2024'; nature 'article de revue'; corpus '#138'; statut 'CONSULTEE (Crossref + abstract, 2026-09-29)' }
  }
  srcHeteroRetrieval = specDoc 'Chen, Irfan, Yu et al. (2025) — Heterogeneous Multirobot System for Object Retrieval in GNSS-Denied Maritime, J. Field Robotics' {
    #science
    link https://doi.org/10.1002/rob.70011 "A Heterogeneous Multirobot System for Autonomous Object Retrieval in Challenging GNSS-Denied Maritime Environment"
    description 'Systeme heterogene (aeriens + surface) en environnement GNSS-denied. Proche du scenario SWARM-3D. NOTE : le DOI precedent (10.22541/au.172457058.83855084) etait le preprint Authorea, MORT (404, absent de Crossref) ; reference remplacee par la version publiee dans Journal of Field Robotics (2025).'
    metadata { doi '10.1002/rob.70011'; annee '2025'; nature 'article de revue'; statut 'CORRIGEE (preprint mort -> version publiee — verifie Crossref 2026-09-28)' }
  }
  srcAPFWall = specDoc 'Hybrid Artificial Potential Field with Wall-Follower (2024)' {
    #science
    link https://arxiv.org/abs/2409.10332 "Escaping Local Minima: Hybrid Artificial Potential Field with Wall-Follower for Decentralized Multi-Robot Navigation"
    description 'APF hybride + comportement de suivi de mur (wall-follower) pour echapper aux minima locaux en navigation decentralisee multi-robots, SANS carte et SANS communication (capteurs et etat locaux seulement). Deux commutations APF<->WF : a base de regles, ou encodeur entraine sur demonstrations d experts. Obstacles non convexes ET dynamiques (dont les autres robots). Taux de succes nettement superieur a l etat de l art. Multi-robots generique 2D, transposition UAV a qualifier.'
    metadata { arxiv '2409.10332'; annee '2024'; nature 'preprint'; corpus '#141'; statut 'CONSULTEE (abstract arXiv, 2026-09-29)' }
  }
  srcFormationRL = specDoc 'Multi-UAV Formation Control with Obstacle Avoidance via RL (2024)' {
    #science
    link https://arxiv.org/abs/2410.18495 "Multi-UAV Formation Control with Static and Dynamic Obstacle Avoidance via Reinforcement Learning"
    description 'Controle de formation multi-UAV avec evitement d obstacles statiques et dynamiques par RL en deux etapes : (1) recherche de fonction de recompense (vol dirige, evitement, maintien de formation, deploiement zero-shot) ; (2) curriculum learning + encodeur d observation par attention. Valide en SIMULATION ET en environnement REEL ; surpasse les baselines planification et RL (taux sans collision, maintien de formation). arXiv v2 (2025-03-01).'
    metadata { arxiv '2410.18495'; annee '2024'; nature 'preprint'; corpus '#147'; statut 'CONSULTEE (abstract arXiv, 2026-09-29)' }
  }
  srcExplainableMARL = specDoc 'Organizationally-Oriented Explainability and Control in MARL (AAMAS 2025)' {
    #science
    link https://www.ifaamas.org/Proceedings/aamas2025/pdfs/p1968.pdf "An Organizationally-Oriented Approach to Enhancing Explainability and Control in Multi-Agent Reinforcement Learning"
    description '''
      ECARTEE (lue integralement, 2026-09-29). MOISE+MARL integre des roles
      et missions organisationnels (modele MOISE+) dans un MARL Dec-POMDP
      pour contraindre et expliquer l apprentissage : guides de contrainte
      (masquage d actions, shaping de recompense) + methode TEMM d inference
      de roles/missions implicites. AUCUN algorithme du modele n est de la
      coordination MARL APPRISE : la cooperation est portee par CBBA,
      Raft/CRDT, CBF-QP et MPC, tous deterministes et non appris.
      L explicabilite du modele (CAP_OBSERVE) = telemetrie / jumeau numerique
      / rejeu, pas l explication de politiques apprises. Benchmarks
      generiques (Predator-Prey, Overcooked, Warehouse, Cyber-Defense),
      simulation uniquement. Apport organisationnel hors paradigme du modele :
      ne vaut pas rattachement a un algorithme.
    '''
    metadata { nature 'acte de conference'; annee '2025'; corpus '#155'; statut 'ECARTEE' }
  }
  srcHMARLCBF = specDoc 'HMARL-CBF — Hierarchical MARL with Control Barrier Functions (NeurIPS 2025)' {
    #science
    link https://proceedings.neurips.cc/paper_files/paper/2025/file/76486c7eb6056f12e7ce3addced61650-Paper-Conference.pdf "HMARL-CBF: Hierarchical Multi-Agent Reinforcement Learning with Control Barrier Functions for Safe Multi-Robot Navigation"
    description '''
      ECARTEE (lue integralement, 2026-09-29). HMARL-CBF apprend des
      politiques de surete : MARL hierarchique a competences (haut niveau
      cooperatif + bas niveau CBF), garantie pointwise-in-time pendant
      l entrainement ET l execution, valide sur METADRIVE (trafic routier)
      en SIMULATION uniquement (>=95% de succes). Le modele EXCLUT les
      politiques de surete apprises : algSafetyRules = regles PRE-APPROUVEES
      deterministes + watchdog, algCollisionAvoidance = CBF-QP deterministe
      « couche non negociable ». Domaine routier (pas aerien/maritime),
      aucun materiel reel, ne leve ni GAP-2 (N=30 reel) ni GAP-8 (composition
      floue+CBF). Confirmation generique « CBF comme filtre sous politique
      hierarchique apprise » : ne vaut pas rattachement.
    '''
    metadata { nature 'acte de conference'; annee '2025'; corpus '#160'; statut 'ECARTEE' }
  }
  srcAUVFaultDiag = specDoc 'Chen, Xu, Chen, Tarasiuk (2025) — AUV Fault Diagnosis Based on Multidimensional Temporal Classification Transformer' {
    #science
    link https://yadda.icm.edu.pl/baztech/element/bwmeta1.element.baztech-2921c86a-b3bc-453e-bab8-1df7f6cad79f/c/PMRes_2025_4-97-106.pdf "AUV Fault Diagnosis Based on Multidimensional Temporal Classification Transformer"
    link https://doi.org/10.2478/pomr-2025-0053 "AUV Fault Diagnosis Based on Multidimensional Temporal Classification Transformer (Polish Maritime Research 4(128), 2025)"
    description 'Polish Maritime Research 4(128) 2025, Vol. 32, pp. 97-106. Diagnostic de panne AUV par transformer temporel multidimensionnel (MTC-Transformer) : extraction automatique de caracteristiques, fusion gated, classification multi-couches. Valide sur le jeu de pannes de l AUV quadrirotor Haizhe : 99.51% (entrainement) / 99.44% (validation), superieur a WDCNN et LSTM-1DCNN. VERIFICATION 2026-09-29 : lien PDF HTTP 200, article reel, DOI Crossref confirme, metadonnees correctes — la confiance 0.4 est RELEVEE.'
    metadata { doi '10.2478/pomr-2025-0053'; annee '2025'; nature 'article de revue'; corpus '#165'; statut 'CONSULTEE (abstract lu — PDF + DOI verifies)' ; confiance 'VERIFIEE — source valide (ex-0.4 a verifier)' }
  }

