  // ===========================================================================
  //  2. VERDICTS — une affirmation, un verdict, une raison
  //     C est le coeur d E08 : le verdict est un OBJET, pas un commentaire.
  // ===========================================================================

  sciCbba = finding 'SCI-1 — CBBA converge sous retrait d agents / partition' {
    #science
    link https://doi.org/10.1109/tro.2009.2022423 "Consensus-Based Decentralized Auctions for Robust Task Allocation"
    description '''
      Ce qui est PROUVE : CBBA est conflict-free et convergent sous
      communications synchrones/completes, optimalite a 50%.

      Ce qui est seulement EMPIRIQUE : la robustesse au retrait d agents
      est traitee par mecanismes add-on (heartbeat, reactivite) et
      validee EN SIMULATION.

      TROU : aucun article primaire ne prouve la convergence de CBBA
      sous partition PERSISTANTE. Les preuves exigent un graphe de
      communication permettant l echange de consensus ; une partition
      prolongee casse cette hypothese.
    '''
    metadata {
      verdict 'CONDITIONAL'
      transfere_au_dela_de_30 'UNSUPPORTED'
      niveau_preuve 'MEDIUM'
      source 'srcCBBA, srcCBBA24, srcDegraded30'
      correction_modele 'evidence vague -> CONDITIONAL explicite'
    }
  }

  sciCbf = finding 'SCI-2 — CBF : garanties a 30 agents en experience REELLE' {
    #science
    link https://arxiv.org/abs/2603.13103 "A Feasibility-Enhanced Control Barrier Function Method for Multi-UAV Collision Avoidance"
    description '''
      VERDICT : UNSUPPORTED telle qu enoncee. ET C EST UNE CORRECTION
      IMPORTANTE DU MODELE.

      La source primaire (CA-HCBF, arXiv:2604.13245) donne :
        - SIMULATION : N in {10, 20, 30}
        - MATERIEL REEL : 5 robots LIMO Pro
        - A N=30 (simulation) : 89,6% d arrivee, 5,1 violations de paire
          en moyenne (ecart-type 9,6), 669,6 infeasibilities QP par essai

      Donc : « 30 agents » = SIMULATION. « En experience reelle » = FAUX
      pour N~30 (le reel plafonne a 5). Et « garanties » n est pas
      absolue : les violations ne tombent pas a zero, et l infeasibility
      QP n est pas totalement eliminee.

      ECART D ECHELLE : reel=5, sim=30, cible=30 (SWARM-3D) et 200 (revendique).
      Facteur 40 vs le reel pour 200.
    '''
    metadata {
      verdict 'UNSUPPORTED'
      transfere_au_dela_de '5 (reel) / 30 (simulation)'
      niveau_preuve 'LOW — contradictoire'
      source 'srcCAHCBF'
      correction_modele 'contraintes et tbd requalifies en contradiction sourcee'
      compromis 'garantie absolue (sRCBF, <5% arrivee a N=30) vs performance (CA-HCBF)'
    }
  }

  sciCrdt = finding 'SCI-3 — CRDT LWW converge sous partition reseau' {
    #science
    link https://arxiv.org/abs/2508.00622 "SwarmRaft: Leveraging Consensus for Robust Drone Swarm Coordination in GNSS-Degraded Environments"
    description '''
      DOUBLE VERDICT.

      THEORIE (SUPPORTED) : un CRDT LWW-Register est un semilattice
      join-based ; sous eventual delivery, la convergence est PROUVEE
      (strong eventual consistency). La convergence sous partition est
      un THEOREME, pas une observation.

      APPLICATION ESSAIM (CONDITIONAL) : tres peu de sources evaluent
      un CRDT sur essaim de drones a grande echelle. Les travaux les
      plus proches sont en micro-robotique (Kilobots, jusqu a 200 reels)
      et ne testent pas le brouillage RF en vol.

      DISTINCTION CRITIQUE : convergence CRDT != convergence de tache.
      LWW garantit que tous convergent vers le MEME etat, pas que cet
      etat soit CORRECT pour la mission. Sous partition longue, les deux
      cotes peuvent converger vers une decision hors du plan initial.
    '''
    metadata {
      verdict 'SUPPORTED (theorie) / CONDITIONAL (essaim)'
      transfere_au_dela_de '30 — theoreme independant de N mais non teste en vol'
      niveau_preuve 'HIGH (theorie) / LOW (application)'
      source 'srcCRDT, srcKilobot'
      correction_modele 'ADR-2 requalifie : convergence d ETAT prouvee, convergence de MISSION non'
    }
  }

  sciEkf = finding 'SCI-4 — EKF/UKF distribue cooperatif a ~30 plateformes' {
    #science
    link https://doi.org/10.3390/drones9110752 "Enabling Cooperative Autonomy in UUV Clusters: A Survey of Robust State Estimation and Information Fusion Techniques"
    description '''
      VERDICT : CONDITIONAL.

      ETABLI : les filtres distribues cooperatifs (Consensus EKF/UKF,
      Covariance Intersection, Split CI) sont une famille mature et
      theorisee, convergence sous graphe connexe.

      LIMITE : la validation est majoritairement en SIMULATION et sur
      UUV/AUV (milieu GNSS-denied, acoustique). Le chiffre « ~30
      plateformes REELLES » n a PAS ete confirme par une source primaire.

      UAV vs UUV : hypotheses reseau tres differentes. Transposer une
      preuve UUV vers un essaim UAV n est pas direct.
    '''
    metadata {
      verdict 'CONDITIONAL'
      transfere_au_dela_de '30 non confirme (beaucoup de demos reelles plafonnent a 3-10)'
      niveau_preuve 'MEDIUM'
      source 'srcUUV'
      correction_modele 'evidence vague -> CONDITIONAL, validation majoritairement sim/UUV'
    }
  }

  sciLeaderElection = finding 'SCI-12 — Election de leader : fondations solides, essaim mobile non prouve' {
    #science
    link https://www.usenix.org/conference/atc14/technical-sessions/presentation/ongaro "In Search of an Understandable Consensus Algorithm (USENIX ATC 2014)"
    description '''
      ALG_LEADER_ELECTION portait « aucune source verifiee ». Les FONDATIONS
      sont solides et prouvees :
        - Raft (USENIX ATC 2014, 10.5555/2643634.2643666) : election par termes, votes et
          heartbeats, surete et vivacite prouvees ;
        - Bully (10.1109/TC.1982.1675885) : election par priorite,
          complexite en messages bornee ;
        - Paxos (10.1145/279227.279229) : unicite du leader prouvee (pas
          deux leaders pour un meme terme).

      LIMITE NON LEVEE : aucune source primaire ne prouve l election de
      leader sur un essaim de 30 drones MOBILES (topologie changeante,
      partitions). Le manuscrit « Adaptive Leader Election for Mobile Drone
      Swarms » (Dagorn, ICRA 2024) est « in preparation » — NON publiable
      comme source. La reference etcd (Raft en production) est une
      implementation, pas un article scientifique.
    '''
    metadata {
      verdict 'SUPPORTED (fondations) / CONDITIONAL (essaim mobile 30)'
      niveau_preuve 'HIGH (theorie) / LOW (application essaim)'
      source 'srcRaft, srcBully, srcPaxos'
      correction_modele 'algLeaderElection : evidence « aucune source » remplacee ; fondations sourcees, essaim 30 reste un trou'
    }
  }

  sciSafetyRules = finding 'SCI-13 — Surete par regles : CBF source + socle normatif, composition floue non prouvee' {
    #science
    link https://doi.org/10.23919/ECC.2019.8796023 "Control Barrier Functions: Theory and Applications"
    description '''
      ALG_SAFETY_RULES reposait sur un evidence « MEDIUM (repris) » sans
      source. La fondation est documentee :
        - CBF (10.23919/ECC.2019.8796023) : theorie mathematique (QP,
          forward invariance, ISS) ;
        - CBF multi-robots (10.1109/ACC.2016.7526486) : certificats de barriere
          de surete, CBF decentralisees, QP embarque ;

      SOCLE NORMATIF (sans DOI, cite par la spec) : ACAS X (MIT Lincoln
      Lab) pour le detect-and-avoid, EASA AMC/GM Part-UAS et FAA AC 90-117
      pour le geofencing, le lost-link et la separation BVLOS.

      LIMITE NON LEVEE : la composition CBF + logique floue contextuelle
      (regles pre-approuvees) n est pas verifiee formellement (systeme
      hybride). Le manuscrit Dagorn (AIAA 2024) est « submitted » — non
      publiable comme source.
    '''
    metadata {
      verdict 'SUPPORTED (fondations CBF + normatif) / CONDITIONAL (composition floue)'
      niveau_preuve 'HIGH (CBF) / MEDIUM (essaim) / NORMATIF (ACAS X, EASA/FAA)'
      source 'srcCBFTheory, srcCBFSwarm'
      correction_modele 'algSafetyRules : evidence sourcee ; ACAS X et EASA/FAA references comme socle normatif sans DOI'
    }
  }

  sciPathPlanning = finding 'SCI-14 — Planification de trajectoire : MPC tube-based source, N=30 conditionnel' {
    #science
    link https://doi.org/10.3390/drones10030177 "Safe Swarm Navigation in Constrained Environments: A Dynamic Tube-Based Distributed MPC Approach"
    description '''
      ALG_PATH_PLANNING portait un evidence « MEDIUM (repris) » sans source.
      La famille est abondamment documentee par la spec :
        - DMPC tube-based (10.3390/drones10030177) : faisabilite recursive
          PROUVEE (K >= vmax/(amax·h)), QP condense, 10-12 agents simules +
          3-4 quadrotors ;
        - planification globale par diffusion (arXiv:2603.09031,
          arXiv:2606.31197) : empirique, zero-shot sim-to-real limite ;
        - benchmark comparatif (10.1038/s41598-026-70043-1) : PPO robuste en
          replanning mais mono-agent ;
        - VAPF+RL (10.3390/machines13070600) : minima locaux traites,
          mono-drone ;
        - RL hierarchique + MPC (arXiv:2509.15799), SwarmGPT
          (arXiv:2412.08428), AccelMPC FPGA (arXiv:2609.09380).

      LIMITE NON LEVEE : aucune source ne valide N=30 en vol reel, ni la
      convergence globale sous partition persistante. La source S5
      (amphibious UAV PSO, 10.1007/s44443-026-00976-0) est exclue : non
      verifiee (echec de lecture) dans la spec.
    '''
    metadata {
      verdict 'SUPPORTED (MPC tube-based) / CONDITIONAL (N=30, partition)'
      niveau_preuve 'HIGH (MPC tube-based) / MEDIUM (variantes empiriques)'
      source 'srcDMPCTube, srcImpedanceDiffusion, srcDiff4D, srcPathMedUAV, srcVAPF, srcHRLMPC, srcSwarmGPT, srcAccelMPC'
      correction_modele 'algPathPlanning : evidence sourcee ; variantes diffusion/RL positionnees comme empiriques'
    }
  }

  sciHeteroRetrieval = finding 'SCI-15 — Recuperation d objets en GNSS-denied : scenario heterogene aeriens+surface' {
    #science
    link https://doi.org/10.1002/rob.70011 "A Heterogeneous Multirobot System for Autonomous Object Retrieval in Challenging GNSS-Denied Maritime Environment"
    description '''
      srcHeteroRetrieval etait le SEUL cas du modele a rattacher une source
      scientifique DIRECTEMENT a deux algorithmes, sans constat intermediaire
      (patron « source -> constat -> algorithme » rompu). Ce constat retablit
      la chaine en DEUX sauts.

      CE QUI EST DOCUMENTE : un systeme multi-robot HETEROGENE (aerien +
      surface) realisant la recuperation autonome d objets en environnement
      maritime SANS GNSS — Journal of Field Robotics (2025). C est le scenario
      publie le plus proche de SWARM-3D (flotte heterogene, GNSS-denied).

      PORTEE : la source ECLAIRE la navigation sous GNSS degrade
      (algNavigationGNSSDegrade) et la localisation cooperative multi-robots
      (algCooperativeLocalization), SANS les implementer.

      LIMITE NON LEVEE : un seul article, lu mais non implemente ; aucune
      validation de l echelle SWARM-3D (30 plateformes) n est apportee.
    '''
    metadata {
      verdict 'SUPPORTED (scenario heterogene GNSS-denied) / CONDITIONAL (transposition a 30)'
      niveau_preuve 'MEDIUM'
      source 'srcHeteroRetrieval'
      correction_modele 'rattachement direct source->algorithme remplace par la chaine source->constat->algorithme'
    }
  }

  sciCbfFixedWing = finding 'SCI-16 — CBF d ordre superieur (HOCBF) pour evitement en poursuite-evasion voilure fixe' {
    #science
    link https://doi.org/10.3390/drones8080415 "Control Barrier Function-Based Collision Avoidance Guidance Strategy for Multi-Fixed-Wing UAV Pursuit-Evasion Environment"
    description '''
      srcCBFMultiFixed (Lv, Peng, Ma — NUDT, Drones 8(8):415) apporte une
      variante precise de l evitement par CBF, complementaire de srcCAHCBF :

        - HOCBF (high-order CBF) sur modele 2D multi-UAV voilure fixe en
          poursuite-evasion n-sur-n et n-sur-1 ;
        - contraintes HOCBF multiples fusionnees en UNE contrainte lineaire,
          resolution par QP avec solution en forme fermee (guidage nominal
          + terme d evitement) ;
        - maintien au-dessus de la distance minimale de securite tout en
          atteignant la cible.

      VERDICT : SUPPORTED pour la MECANIQUE HOCBF/QP sur voilure fixe ;
      CONDITIONAL pour l echelle SWARM-3D — SIMULATION 2D uniquement,
      aucun materiel reel, nombre de poursuivants non reporte dans l abstract.
    '''
    metadata {
      verdict 'SUPPORTED (HOCBF/QP voilure fixe) / CONDITIONAL (simulation 2D, N non reporte)'
      niveau_preuve 'MEDIUM'
      source 'srcCBFMultiFixed'
      correction_modele 'algCollisionAvoidance : variante CBF voilure fixe sourcee (complement de srcCAHCBF multirotors)'
    }
  }

  sciApfWallFollower = finding 'SCI-17 — APF + suivi de mur : echapper aux minima locaux sans carte ni lien' {
    #science
    link https://arxiv.org/abs/2409.10332 "Escaping Local Minima: Hybrid Artificial Potential Field with Wall-Follower for Decentralized Multi-Robot Navigation"
    description '''
      srcAPFWall traite la faiblesse connue de l APF classique (minima
      locaux) pour la navigation decentralisee multi-robots :

        - comportement de suivi de mur (wall-follower) insere dans l APF ;
        - deux commutations APF <-> WF : a base de regles, ou encodeur
          entraine sur demonstrations d experts ;
        - fonctionne sans carte et sans communication, capteurs et etat
          locaux seulement ; obstacles non convexes ET dynamiques (dont
          autres robots) ;
        - taux de succes nettement superieur a l etat de l art.

      VERDICT : SUPPORTED pour la MECANIQUE (variante « champs de
      potentiel » de algCollisionAvoidance, reactive et sans lien) ;
      CONDITIONAL pour la transposition UAV — source multi-robots
      generique 2D (suivi de mur oriente sol), pas de voilure fixe.
    '''
    metadata {
      verdict 'SUPPORTED (mecanique APF+WF) / CONDITIONAL (transposition UAV 2D->3D)'
      niveau_preuve 'MEDIUM'
      source 'srcAPFWall'
      correction_modele 'algCollisionAvoidance : variante champs de potentiel documentee contre les minima locaux'
    }
  }

  sciFormationRL = finding 'SCI-18 — Formation multi-UAV par RL : evitement d obstacles, valide sim + reel' {
    #science
    link https://arxiv.org/abs/2410.18495 "Multi-UAV Formation Control with Static and Dynamic Obstacle Avoidance via Reinforcement Learning"
    description '''
      srcFormationRL (Xie et al., arXiv:2410.18495, v2 2025-03-01) apporte
      une methode de formation validee en SIMULATION ET en REEL :

        - pipeline RL deux etapes : (1) recherche de fonction de recompense
          equilibrant vol dirige, evitement d obstacles, maintien de
          formation et deploiement zero-shot ; (2) curriculum learning
          pour accelerer l entrainement sur scenarios complexes ;
        - encodeur d observation par attention pour le maintien de formation
          et l adaptation a la densite d obstacles ;
        - surpasse les baselines planification et RL (taux sans collision,
          maintien de formation) sur obstacles statiques, dynamiques et mixtes.

      VERDICT : SUPPORTED (sim + reel) ; CONDITIONAL pour l echelle SWARM-3D
      (nombre d UAV et voilure fixe non reportes dans l abstract).
    '''
    metadata {
      verdict 'SUPPORTED (sim + reel) / CONDITIONAL (echelle N=30, voilure fixe)'
      niveau_preuve 'HIGH (validation reelle) / MEDIUM (echelle)'
      source 'srcFormationRL'
      correction_modele 'algFormationControl : methode RL formation+evitement sourcee (complement de SCI-11 heterogene UAV-USV)'
    }
  }

  // ===========================================================================
  //  3. TROUS DE BENCHMARK — ce qu il faudrait pour lever les doutes
  //     Declares comme objets : ce sont des cibles de recherche futures.
  // ===========================================================================

  gap1 = finding 'GAP-1 — CBBA a 30 sous partition persistante + brouillage' {
    #science
    description 'Mesurer : temps de re-consensus, taux de conflit residuel. Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciCbba'; priorite 'haute' }
  }
  gap2 = finding 'GAP-2 — CBF heterogene au-dela de 30 en materiel reel' {
    #science
    description 'Avec comptage des infeasibilities QP et profondeur de violation. Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciCbf'; priorite 'haute' }
  }
  gap3 = finding 'GAP-3 — CRDT (LWW + OR-Set) sur drones en vol, brouillage RF reel' {
    #science
    description 'Mesurer convergence d etat ET qualite de decision de mission. Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciCrdt'; priorite 'moyenne' }
  }
  gap4 = finding 'GAP-4 — Fusion EKF/UKF hierarchique a >=100 plateformes' {
    #science
    description 'Avec budget de communication explicite et metrique de derive de consensus. Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciEkf'; priorite 'moyenne' }
  }
  gap7 = finding 'GAP-7 — Election de leader sur 30 drones mobiles sous partition' {
    #science
    description 'Mesurer : temps d election, taux de double leader, convergence sous topologie changeante. Manuscrit Dagorn « in preparation » non publiable. Aucun article primaire trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'manuscrit non public, aucun article trouve dans le corpus swarmdrone'; impact 'sciLeaderElection'; priorite 'haute' }
  }
  gap8 = finding 'GAP-8 — Verification formelle de la composition CBF + regles floues' {
    #science
    description 'Prouver la surete du systeme hybride (CBF + logique floue contextuelle + watchdog). Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciSafetyRules'; priorite 'moyenne' }
  }
  gap9 = finding 'GAP-9 — Planification multi-agent a N=30 sous partition et brouillage' {
    #science
    description 'Mesurer la faisabilite recursive DMPC et la convergence sous partition persistante a N=30. Les sources plafonnent a 10-12 agents simules. Aucun article trouve.'
    metadata { statut 'AUCUN ARTICLE TROUVE'; evidence 'aucun article trouve dans le corpus swarmdrone'; impact 'sciPathPlanning'; priorite 'haute' }
  }

  // ===========================================================================
  //  4. RELATIONS — le referentiel s ancre sur les algorithmes reels
  // ===========================================================================

  sciCbba -[evidences]-> algTaskAllocation 'algorithme concerne'
  sciCbba -[uses]-> srcCBBA 'source primaire'
  sciCbba -[uses]-> srcCBBA24 'source primaire'
  sciCbba -[uses]-> srcDegraded30 'source primaire'
  sciCbf -[evidences]-> algCollisionAvoidance 'algorithme concerne'
  sciCbf -[uses]-> srcCAHCBF 'source primaire decisive'
  sciCrdt -[evidences]-> algConsensus 'algorithme concerne'
  sciCrdt -[uses]-> srcCRDT 'theoreme'
  sciCrdt -[uses]-> srcKilobot 'echelle reelle'
  sciEkf -[evidences]-> algPerceptionFusion 'algorithme concerne'
  sciEkf -[uses]-> srcUUV 'revue'

  gap1 -[exposes]-> sciCbba 'doute a lever'
  gap2 -[exposes]-> sciCbf 'doute a lever'
  gap3 -[exposes]-> sciCrdt 'doute a lever'
  gap4 -[exposes]-> sciEkf 'doute a lever'

  // Ancrage sur les risques et hypotheses du modele
  sciCbf -[exposes]-> riskR9 'collision en urgence'
  sciCbf -[exposes]-> riskR3 'validation a 30 non realisable'
  sciCbba -[exposes]-> riskR4 'reconfiguration sous partition'
  sciCrdt -[exposes]-> adr2 'fraicheur explicite, coherence faible'
  sciCrdt -[exposes]-> riskR4 'split-brain'
  sciEkf -[exposes]-> riskR8 'fusion degradee en densite'
  sciEkf -[exposes]-> h3 'GNSS degradable'

  // --- Rattachements SPEC-13 (2026-09-28) : verdicts -> sources ---
  sciLeaderElection -[uses]-> srcRaft 'election par termes/votes'
  sciLeaderElection -[uses]-> srcBully 'election par priorite'
  sciLeaderElection -[uses]-> srcPaxos 'unicite du leader'
  sciSafetyRules -[uses]-> srcCBFTheory 'fondation CBF'
  sciSafetyRules -[uses]-> srcCBFSwarm 'essaim 30+ (simulation) / 10 drones (materiel)'
  sciPathPlanning -[uses]-> srcDMPCTube 'fondation MPC tube-based'
  sciPathPlanning -[uses]-> srcImpedanceDiffusion 'planification globale par diffusion'
  sciPathPlanning -[uses]-> srcDiff4D 'prediction 4D + DNMPC'
  sciPathPlanning -[uses]-> srcPathMedUAV 'benchmark comparatif'
  sciPathPlanning -[uses]-> srcVAPF 'minima locaux'
  sciPathPlanning -[uses]-> srcHRLMPC 'RL hierarchique + MPC'
  sciPathPlanning -[uses]-> srcSwarmGPT 'LLM + filtre de surete'
  sciPathPlanning -[uses]-> srcAccelMPC 'acceleration FPGA'

  // --- Verdicts -> algorithmes ---
  sciLeaderElection -[evidences]-> algLeaderElection 'fondations sourcees'
  sciSafetyRules -[evidences]-> algSafetyRules 'fondations CBF + normatif'
  sciPathPlanning -[evidences]-> algPathPlanning 'MPC tube-based source'

  // --- Gaps exposes par les constats ---
  gap7 -[exposes]-> sciLeaderElection 'doute a lever'
  gap8 -[exposes]-> sciSafetyRules 'doute a lever'
  gap9 -[exposes]-> sciPathPlanning 'doute a lever'

  // --- Rattachement SCI-15 (2026-09-29) : source -> constat -> algorithmes ---
  sciHeteroRetrieval -[uses]-> srcHeteroRetrieval 'source primaire lue (JFR 2025)'
  sciHeteroRetrieval -[evidences]-> algNavigationGNSSDegrade 'scenario heterogene GNSS-denied'
  sciHeteroRetrieval -[evidences]-> algCooperativeLocalization 'retrieval cooperatif multi-robots'

  // --- Rattachements COLLISION & FORMATION (2026-09-29, carte t_5514113a) ---
  sciCbfFixedWing -[uses]-> srcCBFMultiFixed 'HOCBF voilure fixe'
  sciApfWallFollower -[uses]-> srcAPFWall 'APF + suivi de mur'
  sciFormationRL -[uses]-> srcFormationRL 'formation RL + evitement'
  sciCbfFixedWing -[evidences]-> algCollisionAvoidance 'variante CBF voilure fixe (sim 2D)'
  sciApfWallFollower -[evidences]-> algCollisionAvoidance 'variante champs de potentiel anti-minima'
  sciFormationRL -[evidences]-> algFormationControl 'formation RL + evitement (sim + reel)'
}
